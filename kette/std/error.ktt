let ErrorTraits = {
    toString: { self.name + ": " + self.message }

    new: |message| {
        let error = self.clone()
        error.message = message
        error
    }

    fromArray: |args| { self.new(args[0]) }

    |...args| self.fromArray(args)
}

let Error = {
    traits*: ErrorTraits
    name: "Error"
    message: ""
}

let ElementDoesNotExist = {
    traits*: ErrorTraits
    name: "ElementDoesNotExist"
    message: ""
}

let IndexOutOfBoundsTraits = {
    parent*: ErrorTraits

    new: |message, index, length| {
        let error = self.clone()
        error.message = message
        error.index = index
        error.length = length
        error
    }

    fromArray: |args| { self.new(args[0], args[1], args[2]) }
}

let IndexOutOfBounds = {
    traits*: IndexOutOfBoundsTraits
    name: "IndexOutOfBounds"
    message: ""
    index: 0
    length: 0
}

let IllegalLockState = {
    traits*: ErrorTraits
    name: "IllegalLockState"
    message: ""
}

let UnimplementedErrorTraits = {
    parent*: ErrorTraits

    new: |function_name| {
        let error = self.clone()
        error.function = function_name
        error.message = function_name
        error
    }

    fromArray: |args| { self.new(args[0]) }
}

let UnimplementedError = {
    traits*: UnimplementedErrorTraits
    name: "UnimplementedError"
    message: ""
    function: ""
}

// Iteration protocol errors.
let ConcurrentModificationError = {
    traits*: ErrorTraits
    name: "ConcurrentModificationError"
    message: ""
}

let NoSuchElementError = {
    traits*: ErrorTraits
    name: "NoSuchElementError"
    message: ""
}

let IllegalStateError = {
    traits*: ErrorTraits
    name: "IllegalStateError"
    message: ""
}

let error_module = ModuleRegistry._declare("Error", |m| {
    m.Error = Error
    m.ElementDoesNotExist = ElementDoesNotExist
    m.IndexOutOfBounds = IndexOutOfBounds
    m.IllegalLockState = IllegalLockState
    m.UnimplementedError = UnimplementedError
    m.ConcurrentModificationError = ConcurrentModificationError
    m.NoSuchElementError = NoSuchElementError
    m.IllegalStateError = IllegalStateError
})
ModuleRegistry._linkPath("Error", error_module)

let error_traits_module = ModuleRegistry._declare("Error.Traits", |m| {
    m.ErrorTraits = ErrorTraits
    m.IndexOutOfBoundsTraits = IndexOutOfBoundsTraits
    m.UnimplementedErrorTraits = UnimplementedErrorTraits
})
ModuleRegistry._linkPath("Error.Traits", error_traits_module)
