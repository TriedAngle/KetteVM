// Error types are pure data. Behavior and constructors live on trait
// parents; inherited callability runs the trait body with the type object as
// `self`, so `clone` keeps the type map identity.

let ErrorTraits = {
    toString: { self.name + ": " + self.message }

    new: |message| {
        let error = self.clone()
        error.message = message
        error
    }

    |message| self.new(message)
}

let Error = {
    traits*: ErrorTraits
    name: "Error"
    message: ""
}

let ElementDoesNotExist = {
    traits*: ErrorTraits
    name: "ElementDoesNotExist"
    message: ""
}

let IndexOutOfBoundsTraits = {
    parent*: ErrorTraits

    new: |message, index, length| {
        let error = self.clone()
        error.message = message
        error.index = index
        error.length = length
        error
    }

    |message, index, length| self.new(message, index, length)
}

let IndexOutOfBounds = {
    traits*: IndexOutOfBoundsTraits
    name: "IndexOutOfBounds"
    message: ""
    index: 0
    length: 0
}

let IllegalLockState = {
    traits*: ErrorTraits
    name: "IllegalLockState"
    message: ""
}

let UnimplementedErrorTraits = {
    parent*: ErrorTraits

    new: |function_name| {
        let error = self.clone()
        error.function = function_name
        error.message = function_name
        error
    }

    |function_name| self.new(function_name)
}

let UnimplementedError = {
    traits*: UnimplementedErrorTraits
    name: "UnimplementedError"
    message: ""
    function: ""
}
