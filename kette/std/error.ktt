let ErrorTraits = {
    toString: { self.name + ": " + self.message }

    new: |message| {
        let error = self.clone()
        error.message = message
        error
    }

    fromArray: |args| { self.new(args[0]) }

    |...args| self.fromArray(args)
}

let Error = {
    traits*: ErrorTraits
    name: "Error"
    message: ""
}

let ElementDoesNotExist = {
    traits*: ErrorTraits
    name: "ElementDoesNotExist"
    message: ""
}

let IndexOutOfBoundsTraits = {
    parent*: ErrorTraits

    new: |message, index, length| {
        let error = self.clone()
        error.message = message
        error.index = index
        error.length = length
        error
    }

    fromArray: |args| { self.new(args[0], args[1], args[2]) }
}

let IndexOutOfBounds = {
    traits*: IndexOutOfBoundsTraits
    name: "IndexOutOfBounds"
    message: ""
    index: 0
    length: 0
}

let UnimplementedErrorTraits = {
    parent*: ErrorTraits

    new: |function_name| {
        let error = self.clone()
        error.function = function_name
        error.message = function_name
        error
    }

    fromArray: |args| { self.new(args[0]) }
}

let UnimplementedError = {
    traits*: UnimplementedErrorTraits
    name: "UnimplementedError"
    message: ""
    function: ""
}

// Iteration protocol errors.
let ConcurrentModificationError = {
    traits*: ErrorTraits
    name: "ConcurrentModificationError"
    message: ""
}

let NoSuchElementError = {
    traits*: ErrorTraits
    name: "NoSuchElementError"
    message: ""
}

let IllegalStateError = {
    traits*: ErrorTraits
    name: "IllegalStateError"
    message: ""
}

mod error {
    export Error = Error
    export ElementDoesNotExist = ElementDoesNotExist
    export IndexOutOfBounds = IndexOutOfBounds
    export UnimplementedError = UnimplementedError
    export ConcurrentModificationError = ConcurrentModificationError
    export NoSuchElementError = NoSuchElementError
    export IllegalStateError = IllegalStateError

    mod error.traits {
        export ErrorTraits = ErrorTraits
        export IndexOutOfBoundsTraits = IndexOutOfBoundsTraits
        export UnimplementedErrorTraits = UnimplementedErrorTraits
    }
}
