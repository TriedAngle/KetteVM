let ErrorPrototype = {
    name: "Error"
    message: ""
    toString: { self.name + ": " + self.message }
}

let Error = {
    errorProto: ErrorPrototype
    errorObject: {
        parent*: ErrorPrototype
        name: "Error"
        message: ""
    }
    new: |message| {
        let error = self.errorObject.clone()
        error.message = message
        error
    }
    |message| self.new(message)
}

let ElementDoesNotExist = {
    parent*: Error
    errorObject: {
        parent*: ErrorPrototype
        name: "ElementDoesNotExist"
        message: ""
    }
    new: |message| {
        let error = self.errorObject.clone()
        error.message = message
        error
    }
    |message| self.new(message)
}

let IndexOutOfBounds = {
    parent*: Error
    errorObject: {
        parent*: ErrorPrototype
        name: "IndexOutOfBounds"
        message: ""
        index: 0
        length: 0
    }
    new: |message, index, length| {
        let error = self.errorObject.clone()
        error.message = message
        error.index = index
        error.length = length
        error
    }
    |message, index, length| self.new(message, index, length)
}

let IllegalLockState = {
    parent*: Error
    errorObject: {
        parent*: ErrorPrototype
        name: "IllegalLockState"
        message: ""
    }
    new: |message| {
        let error = self.errorObject.clone()
        error.message = message
        error
    }
    |message| self.new(message)
}

let UnimplementedError = {
    parent*: Error
    errorObject: {
        parent*: ErrorPrototype
        name: "UnimplementedError"
        message: ""
        function: ""
    }
    new: |function_name| {
        let error = self.errorObject.clone()
        error.function = function_name
        error.message = function_name
        error
    }
    |function_name| self.new(function_name)
}
