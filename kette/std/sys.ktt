use ffi
let (void, i32, u32, i64, f32, f64, u8, u64, CString) = ffi

let lib = ffi.library(null)
let Ptr = ffi.pointer(void)

let Seek = {
    SET: 0,
    CUR: 1,
    END: 2,
}

let raw = {
    lib: lib,
    fopen: lib.fn("fopen", [CString, CString], Ptr),
    tmpfile: lib.fn("tmpfile", [], Ptr),
    fclose: lib.fn("fclose", [Ptr], i32),
    access: lib.fn("access", [CString, i32], i32),
    fseek: lib.fn("fseek", [Ptr, i64, i32], i32),
    ftell: lib.fn("ftell", [Ptr], i64),
    fread: lib.fn("fread", [Ptr, u64, u64, Ptr], u64),
    fwrite: lib.fn("fwrite", [Ptr, u64, u64, Ptr], u64),
    fputs: lib.fn("fputs", [CString, Ptr], i32),
    fflush: lib.fn("fflush", [Ptr], i32),
    srand: lib.fn("srand", [u32], void),
    rand: lib.fn("rand", [], i32),
    sinf: lib.fn("sinf", [f32], f32),
    cosf: lib.fn("cosf", [f32], f32),
    fabsf: lib.fn("fabsf", [f32], f32),
    exit: lib.fn("exit", [i32], void),
}

let FileTraits = {
    disposable*: Disposable

    open: |path, mode| {
        let mode = if mode == null { "rb" } else { mode }
        let file = self.clone()
        file.handle = raw.fopen(path, mode)
        if file.handle == null {
            throw "cannot open file: " + path
        }
        file.disposed = false
        file
    }

    temp: {
        let file = self.clone()
        file.handle = raw.tmpfile()
        if file.handle == null {
            throw "cannot create temporary file"
        }
        file.disposed = false
        file
    }

    tell: {
        let position = raw.ftell(self.handle)
        if position < 0 {
            throw "ftell failed"
        }
        position
    }

    seek: |offset, origin| {
        if raw.fseek(self.handle, offset, origin) != 0 {
            throw "fseek failed"
        }
        self
    }

    size: {
        let current = self.tell()
        self.seek(0, Seek.END)
        let size = self.tell()
        self.seek(current, Seek.SET)
        size
    }

    read: |size| {
        let data = ffi.array(u8, size).new()
        let count = raw.fread(data, 1, size, self.handle)
        if count != size {
            data.free()
            throw "short read"
        }
        { data: data, size: count }
    }

    readAll: {
        let size = self.size()
        self.seek(0, Seek.SET)
        self.read(size)
    }

    readText: {
        let size = self.size()
        if size == 0 {
            return ""
        }
        let data = ffi.array(u8, size).new()
        self.seek(0, Seek.SET)
        let count = raw.fread(data, 1, size, self.handle)
        if count != size {
            data.free()
            throw "short read"
        }
        let text = ffi.string_at(data)
        data.free()
        text
    }

    write: |data, size| {
        let count = raw.fwrite(data.cast(u8), 1, size, self.handle)
        if count != size {
            throw "short write"
        }
        self
    }

    writeText: |text| {
        let data = ffi.cstring(text)
        let status = raw.fputs(data, self.handle)
        data.free()
        if status < 0 {
            throw "fputs failed"
        }
        self
    }

    flush: {
        if raw.fflush(self.handle) != 0 {
            throw "fflush failed"
        }
        self
    }

    dispose: {
        if self.disposed {
            return 0
        }
        self.disposed = true
        let status = raw.fclose(self.handle)
        self.handle = null
        if status != 0 {
            throw "fclose failed"
        }
        0
    }
}

let File = {
    traits*: FileTraits
    handle: null
    disposed: false
}

mod sys {
    export raw = raw
    export Seek = Seek
    export FileTraits = FileTraits
    export File = File
}
