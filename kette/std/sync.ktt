use threading { parkNanos, wake }

let IllegalLockState = Modules.error.IllegalLockState

let WaitQueueTraits = {
    new: {
        let queue = self.clone()
        queue.head = null
        queue.tail = null
        queue.guard = atomic.AtomicI64.new(0)
        queue
    }
    lock: {
        let spins = 0
        while true {
            while self.guard.load() != 0 {
                if spins < 64 {
                    spins = spins + 1
                } else {
                    Thread.yield()
                    spins = 0
                }
            }
            if self.guard.compareExchange(0, 1) == 0 {
                return 0
            }
            spins = 0
        }
    }
    unlock: { self.guard.store(0) }
    enqueue: { |item|
        self.lock()
        item.granted.store(0)
        item.next = null
        if self.head == null {
            self.head = item
        } else {
            self.tail.next = item
        }
        self.tail = item
        self.unlock()
    }
    dequeue: {
        self.lock()
        let item = self.head
        if item != null {
            self.head = item.next
            item.next = null
            if self.head == null {
                self.tail = null
            }
            item.granted.store(1)
        }
        self.unlock()
        item
    }
    remove: { |item|
        self.lock()
        let prev = null
        let removed = false
        let* visit = |current| {
            if current != null and !removed {
                if current == item {
                    if prev == null {
                        self.head = current.next
                    } else {
                        prev.next = current.next
                    }
                    if self.tail == current {
                        self.tail = prev
                    }
                    current.next = null
                    removed = true
                } else {
                    prev = current
                    visit(current.next)
                }
            }
        }
        visit(self.head)
        self.unlock()
        removed
    }
}

let WaitQueue = {
    traits*: WaitQueueTraits
    head, tail, guard: undefined
}

// One literal site: every waiter shares the same map.
let newWaiter = |thread| {
    return { thread: thread, granted: atomic.AtomicI64.new(0), next: 0 }
}

let MutexTraits = {
    new: {
        let mutex = self.clone()
        mutex.locked = atomic.AtomicI64.new(0)
        mutex.waiters = WaitQueue.new()
        mutex
    }
    waiterFor: |me| {
        let waiter = me.waiter
        if waiter == null {
            waiter = newWaiter(me)
            me.waiter = waiter
        }
        waiter
    }
    lock: {
        let me = Thread.current()
        let waiter = self.waiterFor(me)
        while true {
            if self.locked.compareExchange(0, 1) == 0 {
                return 0
            }
            self.waiters.enqueue(waiter)
            if self.locked.compareExchange(0, 1) == 0 {
                self.waiters.remove(waiter)
                return 0
            }
            me.park()
            if waiter.granted.load() != 0 {
                return 0
            }
            if !self.waiters.remove(waiter) {
                return 0
            }
        }
    }
    tryLock: {
        self.tryLockNanos(0)
    }
    tryLockNanos: |nanos| {
        if nanos <= 0 {
            if self.locked.compareExchange(0, 1) == 0 {
                return true
            }
            return false
        }
        let deadline = Thread.nanoTime() + nanos
        let me = Thread.current()
        let waiter = self.waiterFor(me)
        while true {
            if self.locked.compareExchange(0, 1) == 0 {
                return true
            }
            let remaining = deadline - Thread.nanoTime()
            if remaining <= 0 {
                return false
            }
            self.waiters.enqueue(waiter)
            if self.locked.compareExchange(0, 1) == 0 {
                self.waiters.remove(waiter)
                return true
            }
            let timed_out = parkNanos(remaining)
            if waiter.granted.load() != 0 {
                return true
            }
            if timed_out {
                if self.waiters.remove(waiter) {
                    return false
                }
                return true
            }
            if !self.waiters.remove(waiter) {
                return true
            }
        }
    }
    unlock: {
        let waiter = self.waiters.dequeue()
        if waiter != null {
            wake(waiter.thread)
        } else {
            self.locked.store(0)
        }
    }
    releaseAllForAwait: {
        self.unlock()
        1
    }
    acquireForAwait: |depth| {
        let* visit = |i| {
            if i < depth {
                self.lock()
                visit(i + 1)
            }
        }
        visit(0)
    }
}

let Mutex = {
    traits*: MutexTraits
    locked, waiters: undefined
}

let RecursiveMutexTraits = {
    new: {
        let mutex = self.clone()
        mutex.locked = atomic.AtomicI64.new(0)
        mutex.owner = -1
        mutex.recursions = 0
        mutex.waiters = WaitQueue.new()
        mutex
    }
    waiterFor: |me| {
        let waiter = me.waiter
        if waiter == null {
            waiter = newWaiter(me)
            me.waiter = waiter
        }
        waiter
    }
    lock: {
        let me = Thread.current()
        let me_id = me.threadId()
        if self.owner == me_id {
            self.recursions = self.recursions + 1
            return 0
        }
        let waiter = self.waiterFor(me)
        while true {
            if self.locked.compareExchange(0, 1) == 0 {
                self.owner = me_id
                self.recursions = 1
                return 0
            }
            self.waiters.enqueue(waiter)
            if self.locked.compareExchange(0, 1) == 0 {
                self.waiters.remove(waiter)
                self.owner = me_id
                self.recursions = 1
                return 0
            }
            me.park()
            if waiter.granted.load() != 0 {
                self.owner = me_id
                self.recursions = 1
                return 0
            }
            if !self.waiters.remove(waiter) {
                self.owner = me_id
                self.recursions = 1
                return 0
            }
        }
    }
    tryLock: {
        self.tryLockNanos(0)
    }
    tryLockNanos: |nanos| {
        let me = Thread.current()
        let me_id = me.threadId()
        if self.owner == me_id {
            self.recursions = self.recursions + 1
            return true
        }
        if nanos <= 0 {
            if self.locked.compareExchange(0, 1) == 0 {
                self.owner = me_id
                self.recursions = 1
                return true
            }
            return false
        }
        let deadline = Thread.nanoTime() + nanos
        let waiter = self.waiterFor(me)
        while true {
            if self.locked.compareExchange(0, 1) == 0 {
                self.owner = me_id
                self.recursions = 1
                return true
            }
            let remaining = deadline - Thread.nanoTime()
            if remaining <= 0 {
                return false
            }
            self.waiters.enqueue(waiter)
            if self.locked.compareExchange(0, 1) == 0 {
                self.waiters.remove(waiter)
                self.owner = me_id
                self.recursions = 1
                return true
            }
            let timed_out = parkNanos(remaining)
            if waiter.granted.load() != 0 {
                self.owner = me_id
                self.recursions = 1
                return true
            }
            if timed_out {
                if self.waiters.remove(waiter) {
                    return false
                }
                self.owner = me_id
                self.recursions = 1
                return true
            }
            if !self.waiters.remove(waiter) {
                self.owner = me_id
                self.recursions = 1
                return true
            }
        }
    }
    releaseLock: {
        let waiter = self.waiters.dequeue()
        if waiter != null {
            wake(waiter.thread)
        } else {
            self.locked.store(0)
        }
    }
    unlock: {
        let me_id = Thread.current().threadId()
        if self.owner != me_id {
            throw IllegalLockState("unlock by non-owner")
        }
        if self.recursions > 1 {
            self.recursions = self.recursions - 1
            return 0
        }
        self.owner = -1
        self.recursions = 0
        self.releaseLock()
    }
    releaseAllForAwait: {
        let me_id = Thread.current().threadId()
        if self.owner != me_id {
            throw IllegalLockState("await without lock")
        }
        let depth = self.recursions
        self.owner = -1
        self.recursions = 0
        self.releaseLock()
        depth
    }
    acquireForAwait: |depth| {
        let* visit = |i| {
            if i < depth {
                self.lock()
                visit(i + 1)
            }
        }
        visit(0)
    }
}

let RecursiveMutex = {
    traits*: RecursiveMutexTraits
    locked, owner, recursions, waiters: undefined
}

let ConditionTraits = {
    new: {
        let condition = self.clone()
        condition.waiters = WaitQueue.new()
        condition
    }
    signal: {
        let waiter = self.waiters.dequeue()
        if waiter != null {
            wake(waiter.thread)
        }
    }
    signalAll: {
        let* visit = {
            let waiter = self.waiters.dequeue()
            if waiter != null {
                wake(waiter.thread)
                visit()
            } else {
                0
            }
        }
        visit()
    }
    await: |mutex| {
        self.awaitUntil(mutex, 0, false)
    }
    awaitNanos: |mutex, nanos| {
        self.awaitUntil(mutex, Thread.nanoTime() + nanos, true)
    }
    awaitUntil: |mutex, deadline, timed| {
        let me = Thread.current()
        let waiter = newWaiter(me)
        self.waiters.enqueue(waiter)
        let depth = mutex.releaseAllForAwait()
        let done = false
        while !done and waiter.granted.load() == 0 {
            if !timed {
                me.park()
            } else {
                let remaining = deadline - Thread.nanoTime()
                if remaining <= 0 {
                    self.waiters.remove(waiter)
                    done = true
                } else if parkNanos(remaining) {
                    self.waiters.remove(waiter)
                    done = true
                }
            }
        }
        mutex.acquireForAwait(depth)
        waiter.granted.load() != 0
    }
}

let Condition = {
    traits*: ConditionTraits
    waiters: undefined
}

mod sync {
    export IllegalLockState = IllegalLockState
    export WaitQueue = WaitQueue
    export Mutex = Mutex
    export RecursiveMutex = RecursiveMutex
    export Condition = Condition
}

ModuleRegistry._installLock(RecursiveMutex.new())
