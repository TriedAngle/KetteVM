let K_BOX = 0
let K_WINDOW = 1
let K_TEXT = 2
let K_SPLITTER = 3

let L_NONE = 0
let L_ROW = 1
let L_COL = 2

let SIZE_FIXED = 0
let SIZE_FILL = 1
let SIZE_FIT = 2
let MAX_SIZE = 1000000

let OP_RECT = 1
let OP_CLIP = 2
let OP_CLIP_POP = 3
let OP_SHADOW = 4

let rgb = |r, g, b| { r * 65536 + g * 256 + b }

// Node is the type; NodeTraits holds behavior. Kind data lives in `data`.
let NodeTraits = {
    new: |kind| {
        let n = self.clone()
        n.children = []
        n.kind = kind
        n
    }

    Box: |w, h, color| {
        let n = self.new(K_BOX)
        n.w = w
        n.h = h
        n.color = color
        n
    }

    Row: |pad, gap, children| {
        let n = self.new(K_BOX)
        n.layout = L_ROW
        n.pad = pad
        n.gap = gap
        let i = 0
        while i < children.length {
            n.addChild(children[i])
            i = i + 1
        }
        n
    }

    Text: |s, color| {
        let n = self.new(K_TEXT)
        n.wMode = SIZE_FIT
        n.hMode = SIZE_FIT
        n.color = color
        n.data = { text: s, cw: 8, ch: 16 }
        n
    }

    Window: |title, x, y, w, h, content| {
        let n = self.new(K_WINDOW)
        n.x = x
        n.y = y
        n.w = w
        n.h = h
        n.color = rgb(245, 245, 245)
        n.shadow = 1
        n.clip = 1
        n.boundary = 1
        n.paintBoundary = 1
        n.data = { title: title }

        let bar = self.Box(w, 24, rgb(62, 92, 140))
        bar.data = { title: title }
        n.addChild(bar)

        content.x = 0
        content.y = 24
        content.w = w
        content.h = h - 24
        n.addChild(content)
        n
    }

    setSpace: |space| {
        self.space = space
        let i = 0
        while i < self.children.length {
            self.children[i].setSpace(space)
            i = i + 1
        }
        self
    }

    isLayoutRoot: {
        self.kind == K_WINDOW ||
        self.boundary == 1 ||
        (self.wMode == SIZE_FIXED && self.w > 0 && self.hMode == SIZE_FIXED && self.h > 0)
    }

    // content changed: stop at the nearest size-independent node
    // own size changed: continue from the owner
    resize: {
        let p = self.owner
        if p == null { self.markLayout() } else { p.markLayout() }
        self
    }

    addChild: |child| {
        child.owner = self
        child.setSpace(self.space)
        self.children.push(child)
        self.markLayout()
        self.markPaint()
        child
    }

    markLayout: {
        let n = self
        let root = null
        while n != null {
            n.dirtyLayout = 1
            n.mValid = 0
            root = n
            if n.isLayoutRoot() { break }
            n = n.owner
        }
        if root != null && root.space != null && root.layoutQueued == 0 {
            root.layoutQueued = 1
            root.space.layoutDirty.push(root)
            root.space.needsFrame = 1
        }
        self.markPaint()
    }

    markPaint: {
        let n = self
        let root = null
        while n != null {
            n.dirtyPaint = 1
            n.pValid = 0
            root = n
            if n.paintBoundary == 1 { break }
            n = n.owner
        }
        if root != null && root.space != null && root.paintQueued == 0 {
            root.paintQueued = 1
            root.space.paintDirty.push(root)
            root.space.needsFrame = 1
        }
        self
    }
}

let Node = {
    traits*: NodeTraits
    kind: K_BOX
    owner: null
    children: null
    handler: null
    data: null
    x: 0
    y: 0
    w: 0
    h: 0
    mw: 0
    mh: 0
    minW: 0
    minH: 0
    maxW: MAX_SIZE
    maxH: MAX_SIZE
    wMode: SIZE_FIXED
    hMode: SIZE_FIXED
    pad: 0
    gap: 0
    layout: L_NONE
    clip: 0
    shadow: 0
    color: 0
    dirtyLayout: 1
    dirtyPaint: 1
    layoutQueued: 0
    paintQueued: 0
    space: null
    mValid: 0
    mAw: 0
    mAh: 0
    boundary: 0
    paintBoundary: 0
    pList: null
    pValid: 0
    pX: 0
    pY: 0
}

let Splitter = {
    new: |left, right, color| {
        let s = Node.Box(6, 0, color)
        s.kind = K_SPLITTER
        s.wMode = SIZE_FIXED
        s.data = { left: left, right: right, minLeft: 40, minRight: 40 }
        s
    }

    row: |pad, gap, left, right, color| {
        left.wMode = SIZE_FIXED
        right.wMode = SIZE_FILL
        Node.Row(pad, gap, [left, self.new(left, right, color), right])
    }

    resize: |s, delta| {
        let row = s.owner
        if row == null { return s }
        let left = s.data.left
        let max = row.w - row.pad - row.pad - s.w - row.gap - row.gap - s.data.minRight
        let width = left.w + delta
        if width < s.data.minLeft { width = s.data.minLeft }
        if width > max { width = max }
        left.w = width
        left.mValid = 0
        row.markLayout()
        s
    }
}

// measure sizes up; arrange places down. Modes: FIXED, FILL, FIT.
let Layout = {
    run: |root, w, h| {
        self.measure(root, w, h)
        self.arrange(root, 0, 0, w, h)
        root
    }

    // intrinsic-size seam
    pick: |mode, declared, content, avail| {
        if mode == SIZE_FILL { avail }
        else if mode == SIZE_FIT || declared == 0 { content }
        else { declared }
    }

    measure: |n, aw, ah| {
        if n.mValid == 1 && n.mAw == aw && n.mAh == ah { return n }
        if n.space != null { n.space.measures = n.space.measures + 1 }
        if n.kind == K_TEXT {
            let t = n.data
            let natural = t.text.length * t.cw
            let avail = aw - n.pad - n.pad
            if avail < 1 { avail = 1 }
            let width = if n.wMode == SIZE_FIXED && n.w > 0 { n.w } else if n.wMode == SIZE_FILL { avail } else if natural < avail { natural } else { avail }
            if width < n.minW { width = n.minW }
            if width > n.maxW { width = n.maxW }
            if width < 1 { width = 1 }
            let lines = Math.floor((natural + width - 1) / width)
            n.mw = width
            n.mh = if n.hMode == SIZE_FIXED && n.h > 0 { n.h } else { lines * t.ch }
        } else if n.layout == L_ROW {
            let baseW = if n.wMode == SIZE_FIXED && n.w > 0 { n.w } else { aw }
            let baseH = if n.hMode == SIZE_FIXED && n.h > 0 { n.h } else { ah }
            let innerW = baseW - n.pad - n.pad
            let innerH = baseH - n.pad - n.pad
            if innerW < 0 { innerW = 0 }
            if innerH < 0 { innerH = 0 }
            let contentW = 0
            let contentH = 0
            let hasFill = 0
            let i = 0
            while i < n.children.length {
                let c = n.children[i]
                self.measure(c, innerW, innerH)
                if c.wMode == SIZE_FILL { hasFill = 1 } else { contentW = contentW + c.mw }
                if c.mh > contentH { contentH = c.mh }
                i = i + 1
            }
            if n.children.length > 1 {
                contentW = contentW + n.gap * (n.children.length - 1)
            }
            if hasFill == 1 { contentW = innerW }
            contentW = contentW + n.pad + n.pad
            contentH = contentH + n.pad + n.pad
            n.mw = self.pick(n.wMode, n.w, contentW, aw)
            n.mh = self.pick(n.hMode, n.h, contentH, ah)
        } else if n.layout == L_COL {
            let baseW = if n.wMode == SIZE_FIXED && n.w > 0 { n.w } else { aw }
            let baseH = if n.hMode == SIZE_FIXED && n.h > 0 { n.h } else { ah }
            let innerW = baseW - n.pad - n.pad
            let innerH = baseH - n.pad - n.pad
            if innerW < 0 { innerW = 0 }
            if innerH < 0 { innerH = 0 }
            let contentW = 0
            let contentH = 0
            let hasFill = 0
            let i = 0
            while i < n.children.length {
                let c = n.children[i]
                self.measure(c, innerW, innerH)
                if c.mw > contentW { contentW = c.mw }
                if c.hMode == SIZE_FILL { hasFill = 1 } else { contentH = contentH + c.mh }
                i = i + 1
            }
            if n.children.length > 1 {
                contentH = contentH + n.gap * (n.children.length - 1)
            }
            if hasFill == 1 { contentH = innerH }
            contentW = contentW + n.pad + n.pad
            contentH = contentH + n.pad + n.pad
            n.mw = self.pick(n.wMode, n.w, contentW, aw)
            n.mh = self.pick(n.hMode, n.h, contentH, ah)
        } else {
            let baseW = if n.wMode == SIZE_FIXED && n.w > 0 { n.w } else { aw }
            let baseH = if n.hMode == SIZE_FIXED && n.h > 0 { n.h } else { ah }
            let innerW = baseW - n.pad - n.pad
            let innerH = baseH - n.pad - n.pad
            if innerW < 0 { innerW = 0 }
            if innerH < 0 { innerH = 0 }
            let contentW = 0
            let contentH = 0
            let i = 0
            while i < n.children.length {
                let c = n.children[i]
                self.measure(c, innerW, innerH)
                if c.x + c.mw > contentW { contentW = c.x + c.mw }
                if c.y + c.mh > contentH { contentH = c.y + c.mh }
                i = i + 1
            }
            contentW = contentW + n.pad + n.pad
            contentH = contentH + n.pad + n.pad
            n.mw = self.pick(n.wMode, n.w, contentW, aw)
            n.mh = self.pick(n.hMode, n.h, contentH, ah)
        }
        if n.mw < 0 { n.mw = 0 }
        if n.mh < 0 { n.mh = 0 }
        if n.mw < n.minW { n.mw = n.minW }
        if n.mw > n.maxW { n.mw = n.maxW }
        if n.mh < n.minH { n.mh = n.minH }
        if n.mh > n.maxH { n.mh = n.maxH }
        n.mAw = aw
        n.mAh = ah
        n.mValid = 1
        n
    }

    arrange: |n, x, y, w, h| {
        n.x = x
        n.y = y
        n.w = w
        n.h = h
        if n.layout == L_ROW { self.arrangeRow(n) }
        else if n.layout == L_COL { self.arrangeCol(n) }
        else {
            let i = 0
            while i < n.children.length {
                let c = n.children[i]
                let cw = if c.w > 0 { c.w } else { c.mw }
                let ch = if c.h > 0 { c.h } else { c.mh }
                self.arrange(c, c.x, c.y, cw, ch)
                i = i + 1
            }
        }
        n
    }

    arrangeRow: |n| {
        let innerW = n.w - n.pad - n.pad
        let innerH = n.h - n.pad - n.pad
        let count = n.children.length
        let fixed = 0
        let fills = 0
        let i = 0
        while i < count {
            let c = n.children[i]
            if c.wMode == SIZE_FILL { fills = fills + 1 } else { fixed = fixed + c.mw }
            i = i + 1
        }
        let gaps = if count > 1 { n.gap * (count - 1) } else { 0 }
        let remaining = innerW - fixed - gaps
        let share = if fills > 0 { Math.floor(remaining / fills) } else { 0 }
        let extra = if fills > 0 { remaining - share * fills } else { 0 }
        let cx = n.pad
        i = 0
        while i < count {
            let c = n.children[i]
            let cw = if c.wMode == SIZE_FILL {
                let v = share
                if extra > 0 {
                    extra = extra - 1
                    v + 1
                } else {
                    v
                }
            } else {
                c.mw
            }
            if c.wMode == SIZE_FILL { self.measure(c, cw, innerH) }
            let ch = if c.hMode == SIZE_FIT { c.mh } else { innerH }
            self.arrange(c, cx, n.pad, cw, ch)
            cx = cx + cw + n.gap
            i = i + 1
        }
        n
    }

    arrangeCol: |n| {
        let innerW = n.w - n.pad - n.pad
        let innerH = n.h - n.pad - n.pad
        let count = n.children.length
        let fixed = 0
        let fills = 0
        let i = 0
        while i < count {
            let c = n.children[i]
            if c.hMode == SIZE_FILL { fills = fills + 1 } else { fixed = fixed + c.mh }
            i = i + 1
        }
        let gaps = if count > 1 { n.gap * (count - 1) } else { 0 }
        let remaining = innerH - fixed - gaps
        let share = if fills > 0 { Math.floor(remaining / fills) } else { 0 }
        let extra = if fills > 0 { remaining - share * fills } else { 0 }
        let cy = n.pad
        i = 0
        while i < count {
            let c = n.children[i]
            let ch = if c.hMode == SIZE_FILL {
                let v = share
                if extra > 0 {
                    extra = extra - 1
                    v + 1
                } else {
                    v
                }
            } else {
                c.mh
            }
            if c.hMode == SIZE_FILL { self.measure(c, innerW, ch) }
            let cw = if c.wMode == SIZE_FIT { c.mw } else { innerW }
            self.arrange(c, n.pad, cy, cw, ch)
            cy = cy + ch + n.gap
            i = i + 1
        }
        n
    }
}

// Flat op stream in absolute coordinates.
// rect: op x y w h color; clip: op x y w h; shadow: op x y w h color; pop: op
let Paint = {
    node: |n, ox, oy, list| {
        let x = ox + n.x
        let y = oy + n.y
        n.dirtyPaint = 0
        if n.space != null { n.space.paintNodes = n.space.paintNodes + 1 }
        if n.paintBoundary == 1 {
            if n.pValid == 0 || n.pX != x || n.pY != y {
                n.pList = []
                self.body(n, x, y, n.pList)
                n.pValid = 1
                n.pX = x
                n.pY = y
            }
            let i = 0
            while i < n.pList.length {
                list.push(n.pList[i])
                i = i + 1
            }
        } else {
            self.body(n, x, y, list)
        }
    }

    body: |n, x, y, list| {
        if n.shadow == 1 { self.shadow(list, x + 4, y + 4, n.w, n.h, rgb(0, 0, 0)) }
        if n.color != 0 { self.rect(list, x, y, n.w, n.h, n.color) }
        if n.clip == 1 { self.clip(list, x, y, n.w, n.h) }
        let i = 0
        while i < n.children.length {
            self.node(n.children[i], x, y, list)
            i = i + 1
        }
        if n.clip == 1 { list.push(OP_CLIP_POP) }
    }

    rect: |list, x, y, w, h, color| {
        list.push(OP_RECT)
        list.push(x)
        list.push(y)
        list.push(w)
        list.push(h)
        list.push(color)
    }

    shadow: |list, x, y, w, h, color| {
        list.push(OP_SHADOW)
        list.push(x)
        list.push(y)
        list.push(w)
        list.push(h)
        list.push(color)
    }

    clip: |list, x, y, w, h| {
        list.push(OP_CLIP)
        list.push(x)
        list.push(y)
        list.push(w)
        list.push(h)
    }
}

let Hit = {
    test: |n, x, y| {
        if x < 0 || y < 0 || x >= n.w || y >= n.h { return null }
        let i = n.children.length - 1
        while i >= 0 {
            let c = n.children[i]
            let hit = self.test(c, x - c.x, y - c.y)
            if hit != null { return hit }
            i = i - 1
        }
        n
    }
}

let Windows = {
    raise: |world, win| {
        let out = []
        let i = 0
        while i < world.children.length {
            if world.children[i] != win { out.push(world.children[i]) }
            i = i + 1
        }
        out.push(win)
        world.children = out
        world.markPaint()
        win
    }

    rootOf: |n| {
        let w = n
        while w != null && w.kind != K_WINDOW { w = w.owner }
        w
    }

    press: |space, x, y| {
        let n = Hit.test(space.root, x, y)
        if n == null { return null }
        let win = self.rootOf(n)
        if win != null { self.raise(space.root, win) }
        if n.handler { n.handler(n, x, y) }
        n
    }
}

let SpaceTraits = {
    new: |w, h| {
        let root = Node.new(K_BOX)
        root.w = w
        root.h = h
        root.color = rgb(32, 32, 36)
        let s = self.clone()
        s.root = root
        s.list = []
        s.owner = Thread.current()
        s.time = 0
        s.needsFrame = 1
        s.layoutDirty = []
        s.paintDirty = []
        s.measures = 0
        s.paintNodes = 0
        root.space = s
        root.layoutQueued = 1
        root.paintQueued = 1
        s.layoutDirty.push(root)
        s.paintDirty.push(root)
        s
    }

    request: {
        self.needsFrame = 1
        self
    }

    tick: |ms| {
        self.time = self.time + ms
        self
    }

    hasAncestorIn: |n, list| {
        let p = n.owner
        while p != null {
            let i = 0
            while i < list.length {
                if list[i] == p { return true }
                i = i + 1
            }
            p = p.owner
        }
        false
    }

    extractRoots: |list| {
        let out = []
        let i = 0
        while i < list.length {
            let n = list[i]
            if n.dirtyLayout == 1 && !self.hasAncestorIn(n, list) {
                out.push(n)
            }
            i = i + 1
        }
        out
    }

    clearLayout: |n| {
        n.dirtyLayout = 0
        n.layoutQueued = 0
        let i = 0
        while i < n.children.length {
            self.clearLayout(n.children[i])
            i = i + 1
        }
    }

    clearPaintQueue: {
        let i = 0
        while i < self.paintDirty.length {
            self.paintDirty[i].paintQueued = 0
            i = i + 1
        }
        self.paintDirty = []
    }

    frame: {
        if self.needsFrame == 0 && self.layoutDirty.length == 0 && self.paintDirty.length == 0 {
            return self.list
        }

        let passes = 0
        while self.layoutDirty.length > 0 && passes < 100 {
            let queue = self.layoutDirty
            self.layoutDirty = []
            let roots = self.extractRoots(queue)
            let i = 0
            while i < roots.length {
                let r = roots[i]
                r.layoutQueued = 0
                if r.dirtyLayout == 1 {
                    if r == self.root {
                        Layout.run(r, r.w, r.h)
                    } else {
                        Layout.measure(r, r.w, r.h)
                        Layout.arrange(r, r.x, r.y, r.w, r.h)
                    }
                    self.clearLayout(r)
                }
                i = i + 1
            }
            passes = passes + 1
            if passes == 50 { print("ui: 50 layout passes") }
        }

        if self.paintDirty.length > 0 || self.root.dirtyPaint == 1 {
            self.list = []
            Paint.node(self.root, 0, 0, self.list)
            self.root.dirtyPaint = 0
            self.clearPaintQueue()
        }

        self.needsFrame = 0
        self.list
    }
}

let Space = {
    traits*: SpaceTraits
    root: null
    list: null
    owner: null
    time: 0
    needsFrame: 0
    layoutDirty: null
    paintDirty: null
    measures: 0
    paintNodes: 0
}

let Dump = {
    tree: |n, depth, ox, oy| {
        let pad = ""
        let i = 0
        while i < depth {
            pad = pad + "  "
            i = i + 1
        }
        let x = ox + n.x
        let y = oy + n.y
        print(pad + "k" + n.kind + " " + x + "," + y + " " + n.w + "x" + n.h + " m" + n.mw + "x" + n.mh)
        i = 0
        while i < n.children.length {
            self.tree(n.children[i], depth + 1, x, y)
            i = i + 1
        }
    }

    list: |ops| {
        let i = 0
        while i < ops.length {
            let op = ops[i]
            if op == OP_RECT {
                print("rect " + ops[i + 1] + " " + ops[i + 2] + " " + ops[i + 3] + " " + ops[i + 4] + " #" + ops[i + 5])
                i = i + 6
            } else if op == OP_SHADOW {
                print("shadow " + ops[i + 1] + " " + ops[i + 2] + " " + ops[i + 3] + " " + ops[i + 4])
                i = i + 6
            } else if op == OP_CLIP {
                print("clip " + ops[i + 1] + " " + ops[i + 2] + " " + ops[i + 3] + " " + ops[i + 4])
                i = i + 5
            } else if op == OP_CLIP_POP {
                print("pop")
                i = i + 1
            } else {
                i = i + 1
            }
        }
    }
}

let TermTraits = {
    ramp: [" ", ".", ":", "-", "=", "+", "*", "#", "%", "@"]

    new: |sceneW, sceneH, cols, rows, mode| {
        let c = self.clone()
        c.sceneW = sceneW
        c.sceneH = sceneH
        c.cols = cols
        c.rows = rows
        c.mode = mode
        c.cells = []
        c.colors = []
        let i = 0
        while i < cols * rows {
            c.cells.push(" ")
            c.colors.push(rgb(0, 0, 0))
            i = i + 1
        }
        c.stack = []
        c.depth = 0
        c.clipX = 0
        c.clipY = 0
        c.clipW = sceneW
        c.clipH = sceneH
        c
    }

    render: |ops, sceneW, sceneH, cols, rows, mode| {
        let c = self.new(sceneW, sceneH, cols, rows, mode)
        let i = 0
        while i < ops.length {
            let op = ops[i]
            if op == OP_RECT {
                c.rect(ops[i + 1], ops[i + 2], ops[i + 3], ops[i + 4], ops[i + 5])
                i = i + 6
            } else if op == OP_SHADOW {
                i = i + 6
            } else if op == OP_CLIP {
                c.clip(ops[i + 1], ops[i + 2], ops[i + 3], ops[i + 4])
                i = i + 5
            } else if op == OP_CLIP_POP {
                c.pop()
                i = i + 1
            } else {
                i = i + 1
            }
        }
        c.dump()
    }

    rect: |x, y, w, h, color| {
        let x0 = Math.floor(x * self.cols / self.sceneW)
        let x1 = Math.floor((x + w) * self.cols / self.sceneW)
        let y0 = Math.floor(y * self.rows / self.sceneH)
        let y1 = Math.floor((y + h) * self.rows / self.sceneH)
        let cx0 = Math.floor(self.clipX * self.cols / self.sceneW)
        let cx1 = Math.floor((self.clipX + self.clipW) * self.cols / self.sceneW)
        let cy0 = Math.floor(self.clipY * self.rows / self.sceneH)
        let cy1 = Math.floor((self.clipY + self.clipH) * self.rows / self.sceneH)
        if x0 < cx0 { x0 = cx0 }
        if y0 < cy0 { y0 = cy0 }
        if x1 > cx1 { x1 = cx1 }
        if y1 > cy1 { y1 = cy1 }
        if x1 == x0 { x1 = x0 + 1 }
        if y1 == y0 { y1 = y0 + 1 }
        if x0 < 0 { x0 = 0 }
        if y0 < 0 { y0 = 0 }
        if x1 > self.cols { x1 = self.cols }
        if y1 > self.rows { y1 = self.rows }
        if x1 > x0 && y1 > y0 {
            let r = Math.floor(color / 65536)
            let g = Math.floor(color / 256) - r * 256
            let b = color - r * 65536 - g * 256
            let lum = Math.floor((r * 30 + g * 59 + b * 11) / 100)
            let idx = Math.floor(lum * 9 / 255)
            if idx < 0 { idx = 0 }
            if idx > 9 { idx = 9 }
            let ch = self.ramp[idx]
            let yy = y0
            while yy < y1 {
                let xx = x0
                while xx < x1 {
                    let at = yy * self.cols + xx
                    self.cells[at] = ch
                    self.colors[at] = color
                    xx = xx + 1
                }
                yy = yy + 1
            }
        }
    }

    clip: |x, y, w, h| {
        let at = self.depth * 4
        self.stack[at] = self.clipX
        self.stack[at + 1] = self.clipY
        self.stack[at + 2] = self.clipW
        self.stack[at + 3] = self.clipH
        self.depth = self.depth + 1
        let nx = if x > self.clipX { x } else { self.clipX }
        let ny = if y > self.clipY { y } else { self.clipY }
        let nr = if x + w < self.clipX + self.clipW { x + w } else { self.clipX + self.clipW }
        let nb = if y + h < self.clipY + self.clipH { y + h } else { self.clipY + self.clipH }
        self.clipX = nx
        self.clipY = ny
        self.clipW = if nr > nx { nr - nx } else { 0 }
        self.clipH = if nb > ny { nb - ny } else { 0 }
    }

    pop: {
        if self.depth > 0 {
            self.depth = self.depth - 1
            let at = self.depth * 4
            self.clipX = self.stack[at]
            self.clipY = self.stack[at + 1]
            self.clipW = self.stack[at + 2]
            self.clipH = self.stack[at + 3]
        }
    }

    dump: {
        if self.mode == 2 {
            let y = 0
            while y < self.rows {
                let line = ""
                let x = 0
                while x < self.cols {
                    let color = self.colors[y * self.cols + x]
                    let r = Math.floor(color / 65536)
                    let g = Math.floor(color / 256) - r * 256
                    let b = color - r * 65536 - g * 256
                    line = line + "\x1b[48;2;" + r + ";" + g + ";" + b + "m "
                    x = x + 1
                }
                print(line + "\x1b[0m")
                y = y + 1
            }
        } else {
            let y = 0
            while y < self.rows {
                let line = ""
                let x = 0
                while x < self.cols {
                    line = line + self.cells[y * self.cols + x]
                    x = x + 1
                }
                print(line)
                y = y + 1
            }
        }
    }
}

let Term = {
    traits*: TermTraits
    sceneW: 0
    sceneH: 0
    cols: 0
    rows: 0
    mode: 0
    cells: null
    colors: null
    stack: null
    depth: 0
    clipX: 0
    clipY: 0
    clipW: 0
    clipH: 0
}

