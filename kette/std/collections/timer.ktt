use sync { Mutex }
use threading { wake }

let TimerTraits = {
    new: |deadline, action| {
        let timer = self.clone()
        timer.deadline = deadline
        timer.action = action
        timer.cancelled = atomic.AtomicI64.new(0)
        timer
    }
    cancel: {
        self.cancelled.store(1)
        self
    }
}

let Timer = {
    traits*: TimerTraits
    deadline, action, cancelled: undefined
}

let TimerQueueTraits = {
    new: {
        let queue = self.clone()
        queue.items = []
        queue.length = 0
        queue.lock = Mutex.new()
        queue.closed = false
        queue.thread = null
        queue
    }
    start: {
        if self.thread != null {
            return self
        }
        let thread = Thread.newPlatform("timer-queue", {
            self.run()
        })
        self.thread = thread
        thread.start()
        self
    }
    add: |deadline, action| {
        let timer = Timer.new(deadline, action)
        self.lock.lock()
        if self.closed {
            self.lock.unlock()
            throw "timer queue is closed"
        }
        self.items[self.length] = timer
        self.length = self.length + 1
        self.siftUp(self.length - 1)
        let thread = self.thread
        self.lock.unlock()
        if thread != null {
            wake(thread)
        }
        timer
    }
    addAfter: |nanos, action| {
        self.add(Thread.nanoTime() + nanos, action)
    }
    cancel: |timer| {
        timer.cancel()
        self.lock.lock()
        let index = self.indexOf(timer)
        if index >= 0 {
            self.removeAt(index)
        }
        let thread = self.thread
        self.lock.unlock()
        if thread != null {
            wake(thread)
        }
        timer
    }
    close: {
        self.lock.lock()
        let first = !self.closed
        self.closed = true
        let thread = self.thread
        self.lock.unlock()
        if first and thread != null {
            wake(thread)
        }
        self
    }
    shutdown: {
        self.close()
        let thread = self.thread
        if thread != null {
            thread.join()
        }
        self
    }
    isClosed: {
        self.lock.lock()
        let closed = self.closed
        self.lock.unlock()
        closed
    }
    size: {
        self.lock.lock()
        let size = self.length
        self.lock.unlock()
        size
    }
    isEmpty: {
        self.lock.lock()
        let empty = self.length == 0
        self.lock.unlock()
        empty
    }
    parkNanos: |nanos| {
        let me = Thread.current()
        let timer = self.addAfter(nanos, {
            wake(me)
        })
        Thread.park()
        timer.cancel()
    }
    sleep: |nanos| {
        let me = Thread.current()
        let start = Thread.nanoTime()
        let remaining = nanos
        while remaining > 0 and !me.isInterrupted() {
            self.parkNanos(remaining)
            remaining = nanos - (Thread.nanoTime() - start)
        }
    }
    indexOf: |timer| {
        let* visit = |index| {
            if index < self.length {
                if self.items[index] == timer {
                    index
                } else {
                    visit(index + 1)
                }
            } else {
                -1
            }
        }
        visit(0)
    }
    siftUp: |index| {
        let current = index
        while current > 0 {
            let parent = Math.floor((current - 1) / 2)
            if self.items[parent].deadline <= self.items[current].deadline {
                break
            }
            let value = self.items[parent]
            self.items[parent] = self.items[current]
            self.items[current] = value
            current = parent
        }
    }
    siftDown: |index| {
        let current = index
        while true {
            let left = current * 2 + 1
            let right = left + 1
            let smallest = current
            let smallest = if left < self.length and self.items[left].deadline < self.items[smallest].deadline {
                left
            } else {
                smallest
            }
            let smallest = if right < self.length and self.items[right].deadline < self.items[smallest].deadline {
                right
            } else {
                smallest
            }
            if smallest == current {
                break
            }
            let value = self.items[current]
            self.items[current] = self.items[smallest]
            self.items[smallest] = value
            current = smallest
        }
    }
    removeAt: |index| {
        self.length = self.length - 1
        let last = self.items[self.length]
        self.items[self.length] = null
        if index < self.length {
            self.items[index] = last
            self.siftDown(index)
            if index > 0 {
                self.siftUp(index)
            }
        }
        last
    }
    popLocked: {
        let first = self.items[0]
        self.removeAt(0)
        first
    }
    run: {
        while true {
            self.lock.lock()
            if self.closed {
                self.lock.unlock()
                return 0
            }
            let now = Thread.nanoTime()
            let due = []
            while self.length > 0 and self.items[0].deadline <= now {
                due.push(self.popLocked())
            }
            let wait = 0
            if self.length > 0 {
                wait = self.items[0].deadline - now
            }
            let empty = self.length == 0
            self.lock.unlock()
            due.forEach(|timer| {
                if timer.cancelled.load() == 0 {
                    try {
                        timer.action()
                    } catch (e) {
                    }
                }
            })
            if empty {
                Thread.park()
            } else if wait > 0 {
                Thread.parkNanos(wait)
            }
        }
    }
}

let TimerQueue = {
    traits*: TimerQueueTraits
    items, length, lock, closed, thread: undefined
}

mod collections.timer {
    export Timer = Timer
    export TimerTraits = TimerTraits
    export TimerQueue = TimerQueue
    export TimerQueueTraits = TimerQueueTraits
}
