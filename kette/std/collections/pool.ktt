use collections.delay_scheduler { DelayScheduler }

let WorkQueueTraits = {
    new: {
        let capacity = 64
        let queue = self.clone()
        queue.items = []
        queue.items[capacity - 1] = null
        queue.head = 0
        queue.count = 0
        queue.capacity = capacity
        queue.guard = atomic.AtomicI64.new(0)
        queue.closed = atomic.AtomicI64.new(0)
        queue.workers = []
        queue.wakeIndex = atomic.AtomicI64.new(0)
        queue
    }
    lock: {
        while self.guard.compareExchange(0, 1) != 0 {
            Thread.yield()
        }
    }
    unlock: { self.guard.store(0) }
    grow: {
        let capacity = self.capacity * 2
        let items = []
        items[capacity - 1] = null
        let index = 0
        while index < self.count {
            items[index] = self.items[(self.head + index) % self.capacity]
            index = index + 1
        }
        self.items = items
        self.head = 0
        self.capacity = capacity
    }
    wakeOne: {
        let workers = self.workers
        if workers.length > 0 {
            let index = self.wakeIndex.add(1) % workers.length
            workers[index].unpark()
        }
    }
    push: |thread| {
        self.lock()
        if self.closed.load() != 0 {
            self.unlock()
            return false
        }
        if self.count == self.capacity {
            self.grow()
        }
        let index = (self.head + self.count) % self.capacity
        self.items[index] = thread
        self.count = self.count + 1
        self.unlock()
        self.wakeOne()
        true
    }
    take: {
        while true {
            self.lock()
            if self.count > 0 {
                let thread = self.items[self.head]
                self.items[self.head] = null
                self.head = (self.head + 1) % self.capacity
                self.count = self.count - 1
                self.unlock()
                return thread
            }
            let closed = self.closed.load() != 0
            self.unlock()
            if closed {
                return null
            }
            Thread.park()
        }
    }
    close: {
        self.closed.store(1)
        let index = 0
        while index < self.workers.length {
            self.workers[index].unpark()
            index = index + 1
        }
        self
    }
}

let WorkQueue = {
    traits*: WorkQueueTraits
    items, head, count, capacity, guard, closed, workers, wakeIndex: undefined
}

let ThreadPoolTraits = {
    disposable*: Disposable
    new: { self.newWithSize(Thread.availableProcessors()) }
    newWithSize: |workers| {
        let pool = self.clone()
        pool.size = if workers < 1 { 1 } else { workers }
        pool.workQueue = WorkQueue.new()
        pool.scheduler = DelayScheduler.new()
        pool.threads = []
        pool.workQueue.workers = pool.threads
        pool.closed = false
        let startWorker = |name| {
            let thread = Thread.newPlatform(name, {
                pool.work()
            })
            pool.threads.push(thread)
            thread.start()
        }
        let index = 0
        while index < pool.size {
            startWorker("pool-worker-" + index)
            index = index + 1
        }
        pool
    }
    spawn: |target| {
        self.spawnNamed("task", target)
    }
    spawnNamed: |name, target| {
        let thread = Thread.newVirtual(name, target)
        thread.scheduler = self
        thread.start()
        self.enqueue(thread)
        thread
    }
    enqueue: |thread| {
        self.workQueue.push(thread)
    }
    work: {
        while true {
            let thread = self.workQueue.take()
            if thread == null {
                return 0
            }
            if thread.isReady() and thread.mount() {
                self.enqueue(thread)
            }
        }
    }
    parkNanos: |nanos| {
        self.scheduler.parkNanos(nanos)
    }
    sleep: |nanos| {
        self.scheduler.sleep(nanos)
    }
    isClosed: { self.closed }
    shutdown: {
        if !self.closed {
            self.closed = true
            self.workQueue.close()
            self.scheduler.shutdown()
        }
        let index = 0
        while index < self.threads.length {
            self.threads[index].join()
            index = index + 1
        }
        self
    }
    dispose: { self.shutdown() }
}

let ThreadPool = {
    traits*: ThreadPoolTraits
    size, workQueue, scheduler, threads, closed: undefined
}

mod collections.pool {
    export ThreadPool = ThreadPool
    export ThreadPoolTraits = ThreadPoolTraits
}
