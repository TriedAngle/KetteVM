let Functional = {
    identity: |x| { x }
    constant: |x| { |y| { x } }
    compose: |f, g| { |x| { f(g(x)) } }
    pipe: |f, g| { |x| { g(f(x)) } }
    composeAll: |functions| {
        |x| {
            let count = functions.length
            if count == null {
                count = functions.size()
            }
            let* visit = |i, result| {
                if i >= 0 {
                    visit(i - 1, functions[i](result))
                } else {
                    result
                }
            }
            visit(count - 1, x)
        }
    }
    pipeAll: |functions| {
        |x| {
            let count = functions.length
            if count == null {
                count = functions.size()
            }
            let* visit = |i, result| {
                if i < count {
                    visit(i + 1, functions[i](result))
                } else {
                    result
                }
            }
            visit(0, x)
        }
    }
    flip: |f| { |a, b| { f(b, a) } }
    curry: |f, a| {
        if a == null {
            |x| { |y| { f(x, y) } }
        } else {
            |y| { f(a, y) }
        }
    }
    curry2: |f| { |a| { |b| { |c| { f(a, b, c) } } } }
    uncurry: |f| { |a, b| { f(a)(b) } }
    partial2: |f, a| { |b| { f(a, b) } }
    partial3: |f, a| { |b, c| { f(a, b, c) } }
}

mod functional {
    export Functional = Functional
}
