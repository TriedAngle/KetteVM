let Collection = {
    size: { throw UnimplementedError("size") }
    forEach: |block| { throw UnimplementedError("forEach") }
    isEmpty: { self.size() == 0 }
    nonEmpty: { self.size() > 0 }
    emptyCopy: { throw UnimplementedError("emptyCopy") }
    contains: |value| {
        let found = false
        self.forEach(|item| {
            if item == value {
                found = true
            }
        })
        found
    }
    includesAll: |collection| {
        let all = true
        collection.forEach(|item| {
            if !self.contains(item) {
                all = false
            }
        })
        all
    }
    occurrencesOf: |value| {
        let count = 0
        self.forEach(|item| {
            if item == value {
                count = count + 1
            }
        })
        count
    }
    findFirst: |predicate| {
        let found = false
        let result = 0
        self.forEach(|item| {
            if !found && predicate(item) {
                found = true
                result = item
            }
        })
        if !found {
            throw RangeError("element not found")
        }
        result
    }
    findFirstOrElse: |predicate, block| {
        let found = false
        let result = 0
        self.forEach(|item| {
            if !found && predicate(item) {
                found = true
                result = item
            }
        })
        if found {
            result
        } else {
            block()
        }
    }
    allSatisfy: |predicate| {
        let all = true
        self.forEach(|item| {
            if !predicate(item) {
                all = false
            }
        })
        all
    }
    anySatisfy: |predicate| {
        let any = false
        self.forEach(|item| {
            if predicate(item) {
                any = true
            }
        })
        any
    }
    noneSatisfy: |predicate| {
        !self.anySatisfy(predicate)
    }
    sum: {
        let total = 0
        self.forEach(|item| { total = total + item })
        total
    }
    product: {
        let total = 1
        self.forEach(|item| { total = total * item })
        total
    }
    min: {
        let found = false
        let result = 0
        self.forEach(|item| {
            if !found {
                result = item
                found = true
            } else if item < result {
                result = item
            }
        })
        if !found {
            throw RangeError("min of empty collection")
        }
        result
    }
    max: {
        let found = false
        let result = 0
        self.forEach(|item| {
            if !found {
                result = item
                found = true
            } else if item > result {
                result = item
            }
        })
        if !found {
            throw RangeError("max of empty collection")
        }
        result
    }
    copy: {
        let result = self.emptyCopy()
        self.forEach(|item| { result.add(item) })
        result
    }
    copyContaining: |collection| {
        let result = self.emptyCopy()
        collection.forEach(|item| { result.add(item) })
        result
    }
    map: |block| {
        let result = self.emptyCopy()
        self.forEach(|item| { result.add(block(item)) })
        result
    }
    filter: |predicate| {
        let result = self.emptyCopy()
        self.forEach(|item| {
            if predicate(item) {
                result.add(item)
            }
        })
        result
    }
    asSequence: { Sequence.from(self) }
}

let MutableCollection = {
    parent*: Collection
    add: |value| { throw UnimplementedError("add") }
    remove: |value| { throw UnimplementedError("remove") }
    removeIfPresent: |value| { throw UnimplementedError("removeIfPresent") }
    clear: { throw UnimplementedError("clear") }
    addAll: |collection| {
        collection.forEach(|item| { self.add(item) })
        self
    }
    removeAll: |collection| {
        collection.forEach(|item| { self.removeIfPresent(item) })
        self
    }
}

let Indexable = {
    parent*: Collection
    get: |index| { throw UnimplementedError("get") }
    first: {
        if self.size() == 0 {
            throw RangeError("first of empty collection", 0, 0)
        }
        self.get(0)
    }
    last: {
        if self.size() == 0 {
            throw RangeError("last of empty collection", 0, 0)
        }
        self.get(self.size() - 1)
    }
    getOrElse: |index, block| {
        if index < 0 || index >= self.size() {
            return block()
        }
        self.get(index)
    }
    firstOrElse: |block| {
        if self.size() == 0 {
            return block()
        }
        self.get(0)
    }
    lastOrElse: |block| {
        if self.size() == 0 {
            return block()
        }
        self.get(self.size() - 1)
    }
    lastIndex: {
        if self.size() == 0 {
            throw RangeError("lastIndex of empty collection", 0, 0)
        }
        self.size() - 1
    }
    keys: {
        let result = Sequence.new()
        let i = 0
        while i < self.size() {
            result.add(i)
            i = i + 1
        }
        result
    }
    indexOf: |value| {
        let i = 0
        let found = false
        while i < self.size() && !found {
            if self.get(i) == value {
                found = true
            } else {
                i = i + 1
            }
        }
        if !found {
            throw RangeError("element not found")
        }
        i
    }
    indexOfOrElse: |value, block| {
        let i = 0
        let found = false
        while i < self.size() && !found {
            if self.get(i) == value {
                found = true
            } else {
                i = i + 1
            }
        }
        if found {
            i
        } else {
            block()
        }
    }
    soleElement: {
        if self.size() != 1 {
            throw RangeError("collection does not have exactly one element", 0, self.size())
        }
        self.get(0)
    }
    forEach: |block| {
        let i = 0
        while i < self.size() {
            block(self.get(i))
            i = i + 1
        }
        self
    }
    forEachReverse: |block| {
        let i = self.size() - 1
        while i >= 0 {
            block(self.get(i))
            i = i - 1
        }
        self
    }
    with: |other, block| {
        let count = self.size()
        if other.size() < count {
            count = other.size()
        }
        let i = 0
        while i < count {
            block(self.get(i), other.get(i))
            i = i + 1
        }
        self
    }
    copyReversed: {
        let result = self.emptyCopy()
        let i = self.size() - 1
        while i >= 0 {
            result.add(self.get(i))
            i = i - 1
        }
        result
    }
}

let MutableIndexable = {
    parent*: Indexable
    setAt: |index, value| { throw UnimplementedError("setAt") }
    insert: |index, value| { throw UnimplementedError("insert") }
    insertAll: |index, collection| {
        let at = index
        collection.forEach(|item| {
            self.insert(at, item)
            at = at + 1
        })
        self
    }
    removeAt: |index| { throw UnimplementedError("removeAt") }
    remove: |value| {
        let i = 0
        let found = false
        while i < self.size() && !found {
            if self.get(i) == value {
                self.removeAt(i)
                found = true
            } else {
                i = i + 1
            }
        }
        if !found {
            throw RangeError("element not found")
        }
        self
    }
    removeIfPresent: |value| {
        let i = 0
        let found = false
        while i < self.size() && !found {
            if self.get(i) == value {
                self.removeAt(i)
                found = true
            } else {
                i = i + 1
            }
        }
        found
    }
    fill: |value| {
        let i = 0
        while i < self.size() {
            self.setAt(i, value)
            i = i + 1
        }
        self
    }
    reverse: {
        let i = 0
        let j = self.size() - 1
        while i < j {
            let left = self.get(i)
            let right = self.get(j)
            self.setAt(i, right)
            self.setAt(j, left)
            i = i + 1
            j = j - 1
        }
        self
    }
}

// A growable sequence: a vector with a movable start.
let Sequence = {
    indexable*: MutableIndexable
    collection*: MutableCollection
    new: {
        let sequence = {
            parent*: self
            items: [null, null, null, null]
            start: 0
            count: 0
        }
        sequence
    }
    from: |collection| {
        let result = Sequence.new()
        collection.forEach(|item| { result.add(item) })
        result
    }
    emptyCopy: { Sequence.new() }
    asSequence: { self }
    size: { self.count }
    get: |index| {
        if index < 0 || index >= self.count {
            throw RangeError("index out of range", index, self.size())
        }
        self.items[self.start + index]
    }
    setAt: |index, value| {
        if index < 0 || index >= self.count {
            throw RangeError("index out of range", index, self.size())
        }
        self.items[self.start + index] = value
        value
    }
    add: |value| { self.addLast(value) }
    addFirst: |value| {
        self.ensureHead(1)
        self.start = self.start - 1
        self.items[self.start] = value
        self.count = self.count + 1
        self
    }
    addLast: |value| {
        self.ensureTail(1)
        self.items[self.start + self.count] = value
        self.count = self.count + 1
        self
    }
    addAllFirst: |collection| {
        let collection_copy = Sequence.from(collection)
        let i = collection_copy.size() - 1
        while i >= 0 {
            self.addFirst(collection_copy.get(i))
            i = i - 1
        }
        self
    }
    addAllLast: |collection| { self.addAll(collection) }
    removeFirst: {
        if self.count == 0 {
            throw RangeError("removeFirst from empty sequence", 0, 0)
        }
        let value = self.items[self.start]
        self.items[self.start] = null
        self.start = self.start + 1
        self.count = self.count - 1
        if self.count == 0 {
            self.start = 0
        }
        value
    }
    removeLast: {
        if self.count == 0 {
            throw RangeError("removeLast from empty sequence", 0, 0)
        }
        self.count = self.count - 1
        let value = self.items[self.start + self.count]
        self.items[self.start + self.count] = null
        if self.count == 0 {
            self.start = 0
        }
        value
    }
    insert: |index, value| {
        if index < 0 || index > self.count {
            throw RangeError("insert index out of range", index, self.count)
        }
        if index == 0 {
            return self.addFirst(value)
        }
        if index == self.count {
            return self.addLast(value)
        }
        self.ensureTail(1)
        let i = self.count
        while i > index {
            self.items[self.start + i] = self.items[self.start + i - 1]
            i = i - 1
        }
        self.items[self.start + index] = value
        self.count = self.count + 1
        self
    }
    removeAt: |index| {
        if index < 0 || index >= self.count {
            throw RangeError("index out of range", index, self.size())
        }
        if index == 0 {
            return self.removeFirst()
        }
        if index == self.count - 1 {
            return self.removeLast()
        }
        let value = self.items[self.start + index]
        let i = index
        while i < self.count - 1 {
            self.items[self.start + i] = self.items[self.start + i + 1]
            i = i + 1
        }
        self.items[self.start + self.count - 1] = null
        self.count = self.count - 1
        value
    }
    removeRange: |start, stop| {
        if start < 0 || stop < start || stop > self.count {
            throw RangeError("range out of bounds", start, self.count)
        }
        let count = stop - start
        let i = 0
        while i < count {
            self.removeAt(start)
            i = i + 1
        }
        self
    }
    clear: {
        let i = 0
        while i < self.count {
            self.items[self.start + i] = null
            i = i + 1
        }
        self.start = 0
        self.count = 0
        self
    }
    compress: {
        let capacity = self.count
        if capacity == 0 {
            self.items = []
        } else {
            let next = []
            next[capacity - 1] = null
            let i = 0
            while i < self.count {
                next[i] = self.items[self.start + i]
                i = i + 1
            }
            self.items = next
        }
        self.start = 0
        self
    }
    ensureTail: |space| {
        if self.start + self.count + space <= self.items.length {
            return 0
        }
        if self.count + space <= self.items.length {
            let i = 0
            while i < self.count {
                self.items[i] = self.items[self.start + i]
                i = i + 1
            }
            self.start = 0
            return 0
        }
        let capacity = self.items.length * 2
        if capacity < 4 {
            capacity = 4
        }
        if capacity < self.count + space {
            capacity = self.count + space
        }
        let next = []
        next[capacity - 1] = null
        let i = 0
        while i < self.count {
            next[i] = self.items[self.start + i]
            i = i + 1
        }
        self.items = next
        self.start = 0
    }
    ensureHead: |space| {
        if self.start >= space {
            return 0
        }
        if self.count + space <= self.items.length {
            let new_start = self.items.length - self.count
            let i = self.count - 1
            while i >= 0 {
                self.items[new_start + i] = self.items[self.start + i]
                i = i - 1
            }
            self.start = new_start
            return 0
        }
        let capacity = self.items.length * 2
        if capacity < 4 {
            capacity = 4
        }
        if capacity < self.count + space {
            capacity = self.count + space
        }
        let new_start = capacity - self.count
        let next = []
        next[capacity - 1] = null
        let i = 0
        while i < self.count {
            next[new_start + i] = self.items[self.start + i]
            i = i + 1
        }
        self.items = next
        self.start = new_start
    }
}
