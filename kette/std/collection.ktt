let errors = Modules.error
let ElementDoesNotExist = errors.ElementDoesNotExist
let IndexOutOfBounds = errors.IndexOutOfBounds
let UnimplementedError = errors.UnimplementedError
let ConcurrentModificationError = errors.ConcurrentModificationError
let NoSuchElementError = errors.NoSuchElementError
let IllegalStateError = errors.IllegalStateError

let range = |from, to| {
    {
        iterator: {
            let value = from
            {
                hasNext: { value < to }
                next: {
                    let current = value
                    value = value + 1
                    current
                }
            }
        }
    }
}

let Collection = {
    size: { throw UnimplementedError("size") }
    iterator: { Iter.newWithSource(self) }
    forEach: |block| { throw UnimplementedError("forEach") }
    forEachWithKey: |block| {
        self.forEach(|value| { block(value, value) })
    }
    isEmpty: { self.size() == 0 }
    nonEmpty: { self.size() > 0 }
    emptyCopy: { throw UnimplementedError("emptyCopy") }
    intoArray: {
        let result = []
        self.forEach(|value| { result.push(value) })
        result
    }
    contains: |value| {
        let found = false
        self.forEach(|item| {
            if item == value {
                found = true
            }
        })
        found
    }
    includesAll: |collection| {
        let all = true
        collection.forEach(|item| {
            if !self.contains(item) {
                all = false
            }
        })
        all
    }
    occurrencesOf: |value| {
        let count = 0
        self.forEach(|item| {
            if item == value {
                count = count + 1
            }
        })
        count
    }
    findFirst: |predicate| {
        let found = false
        let result = 0
        self.forEach(|item| {
            if !found and predicate(item) {
                found = true
                result = item
            }
        })
        if !found {
            throw ElementDoesNotExist("element not found")
        }
        result
    }
    findFirstOrElse: |predicate, block| {
        let found = false
        let result = 0
        self.forEach(|item| {
            if !found and predicate(item) {
                found = true
                result = item
            }
        })
        if found {
            result
        } else {
            block()
        }
    }
    findFirst?: |predicate| {
        self.findFirstOrElse(predicate, { None })
    }
    allSatisfy: |predicate| {
        let all = true
        self.forEach(|item| {
            if !predicate(item) {
                all = false
            }
        })
        all
    }
    anySatisfy: |predicate| {
        let any = false
        self.forEach(|item| {
            if predicate(item) {
                any = true
            }
        })
        any
    }
    noneSatisfy: |predicate| {
        !self.anySatisfy(predicate)
    }
    sum: {
        let total = 0
        self.forEach(|item| { total = total + item })
        total
    }
    product: {
        let total = 1
        self.forEach(|item| { total = total * item })
        total
    }
    min: {
        let found = false
        let result = 0
        self.forEach(|item| {
            if !found {
                result = item
                found = true
            } else if item < result {
                result = item
            }
        })
        if !found {
            throw ElementDoesNotExist("min of empty collection")
        }
        result
    }
    max: {
        let found = false
        let result = 0
        self.forEach(|item| {
            if !found {
                result = item
                found = true
            } else if item > result {
                result = item
            }
        })
        if !found {
            throw ElementDoesNotExist("max of empty collection")
        }
        result
    }
    min?: {
        if self.isEmpty() {
            None
        } else {
            self.min()
        }
    }
    max?: {
        if self.isEmpty() {
            None
        } else {
            self.max()
        }
    }
    copy: {
        let result = self.emptyCopy()
        self.forEach(|item| { result.add(item) })
        result
    }
    copyContaining: |collection| {
        let result = self.emptyCopy()
        collection.forEach(|item| { result.add(item) })
        result
    }
    map: |into, block| {
        self.forEachWithKey(|value, key| {
            into.addWithKey(block(value, key), key)
        })
        into
    }
    filter: |into, block| {
        self.forEachWithKey(|value, key| {
            if block(value, key) {
                into.addWithKey(value, key)
            }
        })
        into
    }
    copyMappedBy: |block| {
        self.map(self.emptyCopy(), block)
    }
    copyFilteredBy: |block| {
        self.filter(self.emptyCopy(), block)
    }
    asSequence: { Sequence.from(self) }
}

let MutableCollection = {
    parent*: Collection
    add: |value| { throw UnimplementedError("add") }
    addWithKey: |value, key| { self.add(value) }
    remove: |value| { throw UnimplementedError("remove") }
    removeIfPresent: |value| { throw UnimplementedError("removeIfPresent") }
    clear: { throw UnimplementedError("clear") }
    addAll: |collection| {
        collection.forEach(|item| { self.add(item) })
        self
    }
    removeAll: |collection| {
        collection.forEach(|item| { self.removeIfPresent(item) })
        self
    }
    mapSelf: |block| {
        let values = Sequence.new()
        let keys = Sequence.new()
        self.forEachWithKey(|value, key| {
            values.add(value)
            keys.add(key)
        })
        self.clear()
        values.forEachWithKey(|value, i| {
            self.addWithKey(block(value, keys.get(i)), keys.get(i))
        })
        self
    }
    filterSelf: |block| {
        let values = Sequence.new()
        let keys = Sequence.new()
        self.forEachWithKey(|value, key| {
            values.add(value)
            keys.add(key)
        })
        self.clear()
        values.forEachWithKey(|value, i| {
            if block(value, keys.get(i)) {
                self.addWithKey(value, keys.get(i))
            }
        })
        self
    }
}

let Indexable = {
    parent*: Collection
    version>>: { throw UnimplementedError("version") }
    get: |index| { throw UnimplementedError("get") }
    `[]`: |index| { self.get(index) }
    first: {
        if self.size() == 0 {
            throw ElementDoesNotExist("first of empty collection")
        }
        self.get(0)
    }
    last: {
        if self.size() == 0 {
            throw ElementDoesNotExist("last of empty collection")
        }
        self.get(self.size() - 1)
    }
    getOrElse: |index, block| {
        if index < 0 or index >= self.size() {
            return block()
        }
        self.get(index)
    }
    get?: |index| {
        self.getOrElse(index, { None })
    }
    firstOrElse: |block| {
        if self.size() == 0 {
            return block()
        }
        self.get(0)
    }
    first?: {
        self.firstOrElse({ None })
    }
    lastOrElse: |block| {
        if self.size() == 0 {
            return block()
        }
        self.get(self.size() - 1)
    }
    last?: {
        self.lastOrElse({ None })
    }
    lastIndex: {
        if self.size() == 0 {
            throw ElementDoesNotExist("lastIndex of empty collection")
        }
        self.size() - 1
    }
    lastIndex?: {
        if self.size() == 0 {
            None
        } else {
            self.size() - 1
        }
    }
    keys: {
        self.map(Sequence.new(), |value, key| { key })
    }
    indexOf: |value| {
        let iterator = self.iterator()
        let* visit = {
            if iterator.hasNext() {
                let pair = iterator.nextKeyed()
                if pair[1] == value {
                    pair[0]
                } else {
                    visit()
                }
            } else {
                -1
            }
        }
        let index = visit()
        if index < 0 {
            throw ElementDoesNotExist("element not found")
        }
        index
    }
    indexOfOrElse: |value, block| {
        let iterator = self.iterator()
        let* visit = {
            if iterator.hasNext() {
                let pair = iterator.nextKeyed()
                if pair[1] == value {
                    pair[0]
                } else {
                    visit()
                }
            } else {
                -1
            }
        }
        let index = visit()
        if index < 0 {
            block()
        } else {
            index
        }
    }
    indexOf?: |value| {
        self.indexOfOrElse(value, { None })
    }
    soleElement: {
        if self.size() != 1 {
            throw ElementDoesNotExist("collection does not have exactly one element")
        }
        self.get(0)
    }
    soleElement?: {
        if self.size() != 1 {
            None
        } else {
            self.get(0)
        }
    }
    forEach: |block| {
        let expected = self.version
        let* visit = |i| {
            if i < self.size() {
                block(self.get(i))
                if self.version != expected {
                    throw ConcurrentModificationError("collection modified during iteration")
                }
                visit(i + 1)
            }
        }
        visit(0)
        self
    }
    forEachWithKey: |block| {
        let expected = self.version
        let* visit = |i| {
            if i < self.size() {
                block(self.get(i), i)
                if self.version != expected {
                    throw ConcurrentModificationError("collection modified during iteration")
                }
                visit(i + 1)
            }
        }
        visit(0)
        self
    }
    forEachReverse: |block| {
        let expected = self.version
        let* visit = |i| {
            if i >= 0 {
                block(self.get(i))
                if self.version != expected {
                    throw ConcurrentModificationError("collection modified during iteration")
                }
                visit(i - 1)
            }
        }
        visit(self.size() - 1)
        self
    }
    with: |other, block| {
        let count = self.size()
        if other.size() < count {
            count = other.size()
        }
        let iterator = self.iterator()
        let i = 0
        let* visit = {
            if i < count and iterator.hasNext() {
                block(iterator.next(), other.get(i))
                i = i + 1
                visit()
            }
        }
        visit()
        self
    }
    copyReversed: {
        let result = self.emptyCopy()
        let* visit = |i| {
            if i >= 0 {
                result.add(self.get(i))
                visit(i - 1)
            }
        }
        visit(self.size() - 1)
        result
    }
}

let MutableIndexable = {
    parent*: Indexable
    setAt: |index, value| { throw UnimplementedError("setAt") }
    `[]=`: |index, value| { self.setAt(index, value) }
    addWithKey: |value, key| { self.insert(self.size(), value) }
    insert: |index, value| { throw UnimplementedError("insert") }
    insertAll: |index, collection| {
        let at = index
        collection.forEach(|item| {
            self.insert(at, item)
            at = at + 1
        })
        self
    }
    removeAt: |index| { throw UnimplementedError("removeAt") }
    removeAt?: |index| {
        if index < 0 or index >= self.size() {
            None
        } else {
            self.removeAt(index)
        }
    }
    remove: |value| {
        let* find = |i| {
            if i < self.size() {
                if self.get(i) == value {
                    i
                } else {
                    find(i + 1)
                }
            } else {
                -1
            }
        }
        let index = find(0)
        if index < 0 {
            throw ElementDoesNotExist("element not found")
        }
        self.removeAt(index)
        self
    }
    remove?: |value| {
        let* find = |i| {
            if i < self.size() {
                if self.get(i) == value {
                    i
                } else {
                    find(i + 1)
                }
            } else {
                -1
            }
        }
        let index = find(0)
        if index < 0 {
            None
        } else {
            self.removeAt(index)
        }
    }
    removeIfPresent: |value| {
        let* find = |i| {
            if i < self.size() {
                if self.get(i) == value {
                    i
                } else {
                    find(i + 1)
                }
            } else {
                -1
            }
        }
        let index = find(0)
        if index < 0 {
            false
        } else {
            self.removeAt(index)
            true
        }
    }
    mapSelf: |block| {
        let iterator = self.iterator()
        let i = 0
        let* visit = {
            if iterator.hasNext() {
                let value = iterator.next()
                self.setAt(i, block(value, i))
                i = i + 1
                visit()
            }
        }
        visit()
        self
    }
    filterSelf: |block| {
        let* visit = |i| {
            if i >= 0 {
                if !block(self.get(i), i) {
                    self.removeAt(i)
                }
                visit(i - 1)
            }
        }
        visit(self.size() - 1)
        self
    }
    fill: |value| {
        let iterator = self.iterator()
        let i = 0
        let* visit = {
            if iterator.hasNext() {
                iterator.next()
                self.setAt(i, value)
                i = i + 1
                visit()
            }
        }
        visit()
        self
    }
    reverse: {
        let* visit = |i, j| {
            if i < j {
                let left = self.get(i)
                let right = self.get(j)
                self.setAt(i, right)
                self.setAt(j, left)
                visit(i + 1, j - 1)
            }
        }
        visit(0, self.size() - 1)
        self
    }
}

// A growable sequence: a vector with a movable start.
let SequenceTraits = {
    indexable*: MutableIndexable
    collection*: MutableCollection
    new: {
        self.newWithSize(0)
    }
    newWithSize: |size| {
        self.newWithSizeFill(size, undefined)
    }
    newWithSizeFill: |size, fill| {
        if size < 0 or size % 1 != 0 {
            throw IndexOutOfBounds("sequence size out of range", size, 0)
        }
        let sequence = self.clone()
        let items = []
        let* visit = |i| {
            if i < size {
                items[i] = fill
                visit(i + 1)
            }
        }
        visit(0)
        sequence.items = items
        sequence.start = 0
        sequence.count = size
        sequence.version = 0
        sequence
    }
    from: |collection| {
        let result = Sequence.new()
        collection.forEach(|item| { result.add(item) })
        result
    }
    emptyCopy: { Sequence.new() }
    asSequence: { self }
    intoArray: {
        let result = []
        if self.count > 0 {
            result[self.count - 1] = undefined
        }
        let* copy = |i| {
            if i < self.count {
                result[i] = self.items[self.start + i]
                copy(i + 1)
            }
        }
        copy(0)
        result
    }
    size: { self.count }
    get: |index| {
        if index < 0 or index >= self.count {
            throw IndexOutOfBounds("index out of range", index, self.size())
        }
        self.items[self.start + index]
    }
    setAt: |index, value| {
        if index < 0 or index >= self.count {
            throw IndexOutOfBounds("index out of range", index, self.size())
        }
        self.items[self.start + index] = value
        value
    }
    add: |value| { self.addLast(value) }
    addFirst: |value| {
        self.ensureHead(1)
        self.start = self.start - 1
        self.items[self.start] = value
        self.count = self.count + 1
        self.version = self.version + 1
        self
    }
    addLast: |value| {
        self.ensureTail(1)
        self.items[self.start + self.count] = value
        self.count = self.count + 1
        self.version = self.version + 1
        self
    }
    addAllFirst: |collection| {
        let collection_copy = Sequence.from(collection)
        let* visit = |i| {
            if i >= 0 {
                self.addFirst(collection_copy.get(i))
                visit(i - 1)
            }
        }
        visit(collection_copy.size() - 1)
        self
    }
    addAllLast: |collection| { self.addAll(collection) }
    removeFirst: {
        if self.count == 0 {
            throw ElementDoesNotExist("removeFirst from empty sequence")
        }
        let value = self.items[self.start]
        self.items[self.start] = null
        self.start = self.start + 1
        self.count = self.count - 1
        if self.count == 0 {
            self.start = 0
        }
        self.version = self.version + 1
        value
    }
    removeFirst?: {
        if self.count == 0 {
            None
        } else {
            self.removeFirst()
        }
    }
    removeLast: {
        if self.count == 0 {
            throw ElementDoesNotExist("removeLast from empty sequence")
        }
        self.count = self.count - 1
        let value = self.items[self.start + self.count]
        self.items[self.start + self.count] = null
        if self.count == 0 {
            self.start = 0
        }
        self.version = self.version + 1
        value
    }
    removeLast?: {
        if self.count == 0 {
            None
        } else {
            self.removeLast()
        }
    }
    insert: |index, value| {
        if index < 0 or index > self.count {
            throw IndexOutOfBounds("insert index out of range", index, self.count)
        }
        if index == 0 {
            return self.addFirst(value)
        }
        if index == self.count {
            return self.addLast(value)
        }
        self.ensureTail(1)
        let* visit = |i| {
            if i > index {
                self.items[self.start + i] = self.items[self.start + i - 1]
                visit(i - 1)
            }
        }
        visit(self.count)
        self.items[self.start + index] = value
        self.count = self.count + 1
        self.version = self.version + 1
        self
    }
    removeAt: |index| {
        if index < 0 or index >= self.count {
            throw IndexOutOfBounds("index out of range", index, self.size())
        }
        if index == 0 {
            return self.removeFirst()
        }
        if index == self.count - 1 {
            return self.removeLast()
        }
        let value = self.items[self.start + index]
        let* visit = |i| {
            if i < self.count - 1 {
                self.items[self.start + i] = self.items[self.start + i + 1]
                visit(i + 1)
            }
        }
        visit(index)
        self.items[self.start + self.count - 1] = null
        self.count = self.count - 1
        self.version = self.version + 1
        value
    }
    removeRange: |start, stop| {
        if start < 0 or stop < start or stop > self.count {
            throw IndexOutOfBounds("range out of bounds", start, self.count)
        }
        let count = stop - start
        let* visit = |i| {
            if i < count {
                self.removeAt(start)
                visit(i + 1)
            }
        }
        visit(0)
        self
    }
    clear: {
        let* visit = |i| {
            if i < self.count {
                self.items[self.start + i] = null
                visit(i + 1)
            }
        }
        visit(0)
        self.start = 0
        self.count = 0
        self.version = self.version + 1
        self
    }
    compress: {
        let capacity = self.count
        if capacity == 0 {
            self.items = []
        } else {
            let next = []
            next[capacity - 1] = null
            let* visit = |i| {
                if i < self.count {
                    next[i] = self.items[self.start + i]
                    visit(i + 1)
                }
            }
            visit(0)
            self.items = next
        }
        self.start = 0
        self
    }
    ensureTail: |space| {
        if self.start + self.count + space <= self.items.length {
            return 0
        }
        if self.count + space <= self.items.length {
            let* move = |i| {
                if i < self.count {
                    self.items[i] = self.items[self.start + i]
                    move(i + 1)
                }
            }
            move(0)
            self.start = 0
            return 0
        }
        let capacity = self.items.length * 2
        if capacity < 4 {
            capacity = 4
        }
        if capacity < self.count + space {
            capacity = self.count + space
        }
        let next = []
        next[capacity - 1] = null
        let* copy = |i| {
            if i < self.count {
                next[i] = self.items[self.start + i]
                copy(i + 1)
            }
        }
        copy(0)
        self.items = next
        self.start = 0
    }
    ensureHead: |space| {
        if self.start >= space {
            return 0
        }
        if self.count + space <= self.items.length {
            let new_start = self.items.length - self.count
            let* move = |i| {
                if i >= 0 {
                    self.items[new_start + i] = self.items[self.start + i]
                    move(i - 1)
                }
            }
            move(self.count - 1)
            self.start = new_start
            return 0
        }
        let capacity = self.items.length * 2
        if capacity < 4 {
            capacity = 4
        }
        if capacity < self.count + space {
            capacity = self.count + space
        }
        let new_start = capacity - self.count
        let next = []
        next[capacity - 1] = null
        let* copy = |i| {
            if i < self.count {
                next[new_start + i] = self.items[self.start + i]
                copy(i + 1)
            }
        }
        copy(0)
        self.items = next
        self.start = new_start
    }
}

let Sequence = {
    traits*: SequenceTraits
    items, start, count: undefined
    // Own slot: parent writes mutate the holder.
    version: 0
}

// The built-in iterator; custom iterables only need hasNext/next.
let IteratorTraits = {
    hasNext: { self.index < self.source.size() }
    next: {
        if self.source.version != self.version {
            throw ConcurrentModificationError("collection modified during iteration")
        }
        if self.index >= self.source.size() {
            throw NoSuchElementError("iterator exhausted")
        }
        let value = self.source.get(self.index)
        self.lastRet = self.index
        self.index = self.index + 1
        value
    }
    nextKeyed: {
        let index = self.index
        let value = self.next()
        [index, value]
    }
    remove: {
        if self.lastRet < 0 {
            throw IllegalStateError("next() not called")
        }
        if self.source.version != self.version {
            throw ConcurrentModificationError("collection modified during iteration")
        }
        let removed = self.source.removeAt(self.lastRet)
        self.index = self.lastRet
        self.lastRet = -1
        self.version = self.source.version
        removed
    }
}

let Iter = {
    traits*: IteratorTraits
    source, index, lastRet, version: undefined
    newWithSource: |source| {
        let it = self.clone()
        it.source = source
        it.index = 0
        it.lastRet = -1
        it.version = source.version
        it
    }
}

mod collection {
    export range = range
    export Sequence = Sequence
    export Iter = Iter

    mod collection.traits {
        export Collection = Collection
        export MutableCollection = MutableCollection
        export Indexable = Indexable
        export MutableIndexable = MutableIndexable
        export SequenceTraits = SequenceTraits
        export IteratorTraits = IteratorTraits
    }
}
