let SYNC_PATH = "kette/std/sync.ktt"
let COLLECTION_PATH = "kette/std/collection.ktt"
let ERROR_PATH = "kette/std/error.ktt"
let FFI_PATH = "kette/std/ffi.ktt"
let LIBC_SYS_PATH = "kette/std/sys/libc/sys.ktt"
let LIBC_FILE_PATH = "kette/std/sys/libc/fs.ktt"
let WINDOWS_SYS_PATH = "kette/std/sys/windows/sys.ktt"
let WINDOWS_FILE_PATH = "kette/std/sys/windows/fs.ktt"
let SYS_PATH = "kette/std/sys/sys.ktt"
let FS_PATH = "kette/std/sys/fs.ktt"
let RANDOM_PATH = "kette/std/random.ktt"
let UI_PATH = "kette/std/ui/ui.ktt"
let UI_VERIFY_PATH = "kette/std/ui/verify.ktt"

globalThis.Modules = {}

globalThis.Disposable = {
    dispose: { throw "dispose is not implemented" }
}

globalThis.with = |resource, block| {
    let failed = false
    let error = null
    let result = null
    try {
        result = block(resource)
    } catch (e) {
        failed = true
        error = e
    }

    let dispose_failed = false
    let dispose_error = null
    try {
        resource.dispose()
    } catch (e) {
        dispose_failed = true
        dispose_error = e
    }

    if failed {
        throw error
    }
    if dispose_failed {
        throw dispose_error
    }
    result
}

Object.addParent(Array.prototype, "array", {
    size: { self.length }
    iterator: {
        let array = self
        let index = 0
        {
            hasNext: { index < array.length }
            next: {
                if index >= array.length {
                    return undefined
                }
                let value = array[index]
                index = index + 1
                value
            }
            nextKeyed: {
                if index >= array.length {
                    return undefined
                }
                let key = index
                let value = array[index]
                index = index + 1
                [key, value]
            }
        }
    }
})

globalThis.ModuleRegistry = {
    registry: Object.create(null)
    entryKey: :"kette.modules.entry"
    _lockBackend: null

    _installLock: |lock| {
        if self._lockBackend == null {
            self._lockBackend = lock
        }
    }

    _lock: {
        if self._lockBackend != null {
            self._lockBackend.lock()
        }
    }

    _unlock: {
        if self._lockBackend != null {
            self._lockBackend.unlock()
        }
    }

    _withLock: |block| {
        self._lock()
        let failed = false
        let error = null
        let result = null
        try {
            result = block()
        } catch (e) {
            failed = true
            error = e
        }
        self._unlock()
        if failed {
            throw error
        }
        result
    }

    declare: |name, initializer| {
        self._withLock({
            self._ensureParents(name)
            let module = self._declare(name, initializer)
            self._linkPath(name, module)
            module
        })
    }

    _newModule: |name| {
        let module = {}
        let entry = {
            name: name
            owners: Object.create(null)
            extensions: Object.create(null)
        }
        Object.defineProperty(module, self.entryKey, {
            value: entry
            writable: true
            configurable: true
        })
        self.registry[name] = module
        module
    }

    _declare: |name, initializer| {
        let module = self.registry[name]
        let created = false
        if module == null {
            module = self._newModule(name)
            created = true
        }

        let failed = false
        let error = null
        try {
            self._update(module, module, initializer, true)
        } catch (e) {
            failed = true
            error = e
        }
        if failed {
            if created {
                self.registry[name] = null
            }
            throw error
        }
        module
    }

    extend: |module, name, initializer| {
        self._withLock({
            let entry = null
            if module != null {
                entry = module[self.entryKey]
            }
            if entry == undefined {
                throw "not a module"
            }
            if name == undefined or name == null {
                throw "extend needs an extension name"
            }
            let extension = entry.extensions[name]
            if extension == undefined {
                extension = {}
                entry.extensions[name] = extension
            }
            self._update(module, extension, initializer, true)
            self._linkPath(entry.name, module)
            module
        })
    }

    _update: |module, owner, initializer, preserveExtras| {
        let entry = module[self.entryKey]
        let currentOwners = entry.owners

        let next = {}
        let owners = Object.create(null)
        let copied = Object.create(null)
        let snapshot = Object.create(null)
        let moduleNames = Object.getOwnPropertyNames(module)
        moduleNames.forEach(|key| {
            let keyOwner = currentOwners[key]
            if keyOwner != undefined and keyOwner != owner {
                let value = module[key]
                next[key] = value
                owners[key] = keyOwner
                copied[key] = true
                snapshot[key] = value
            }
        })

        let failed = false
        let error = null
        try {
            initializer(next)
        } catch (e) {
            failed = true
            error = e
        }
        if failed {
            throw error
        }

        let names = Object.getOwnPropertyNames(next)
        names.forEach(|key| {
            if copied[key] == undefined or next[key] != snapshot[key] {
                let keyOwner = currentOwners[key]
                if keyOwner != undefined and keyOwner != module and keyOwner[self.entryKey] != undefined {
                    throw "cannot replace submodule: " + key
                }
                owners[key] = owner
            }
        })

        if !KetteTools.publishFlatModule(
            module,
            next,
            entry,
            currentOwners,
            owners,
            preserveExtras
        ) {
            throw "module transition failed: " + entry.name
        }
    }

    _pathParts: |name| {
        let parts = []
        let part = ""
        let* visit = |i| {
            if i < name.length {
                let ch = name[i]
                if ch == "." {
                    if part == "" {
                        throw "invalid module path: " + name
                    }
                    parts[parts.length] = part
                    part = ""
                } else {
                    part = part + ch
                }
                visit(i + 1)
            }
        }
        visit(0)
        if part == "" {
            throw "invalid module path: " + name
        }
        parts[parts.length] = part
        parts
    }

    _namespaceModule: |name| {
        let module = self.registry[name]
        if module != null {
            return module
        }
        self._newModule(name)
    }

    _linkPath: |name, child| {
        let parts = self._pathParts(name)
        if parts.length == 1 {
            globalThis.Modules[parts[0]] = child
            return 0
        }

        let parent = ""
        parts.slice(0, parts.length - 1).forEach(|part, i| {
            if i != 0 {
                parent = parent + "."
            }
            parent = parent + part
        })
        let leaf = parts[parts.length - 1]
        let parent_module = self.registry[parent]
        let entry = parent_module[self.entryKey]
        let owner = child
        let existing_owner = entry.owners[leaf]
        if existing_owner != undefined {
            if existing_owner != owner {
                throw "module path conflicts with property: " + name
            }
            if parent_module[leaf] == child {
                return 0
            }
        }
        let own = Object.getOwnPropertyDescriptor(parent_module, leaf)
        if own != undefined {
            throw "module path conflicts with property: " + name
        }
        self._update(parent_module, owner, |m| {
            m[leaf] = child
        }, true)
        0
    }

    _ensureParents: |name| {
        let parts = self._pathParts(name)
        if parts.length < 2 {
            return 0
        }
        let prefix = parts[0]
        parts.forEach(|part, i| {
            if i > 0 {
                let module = self.registry[prefix]
                if module == null {
                    module = self._namespaceModule(prefix)
                }
                self._linkPath(prefix, module)
                if i + 1 < parts.length {
                    prefix = prefix + "." + parts[i]
                }
            }
        })
        0
    }

    _relinkChildren: |parent_name| {
        let parent_parts = self._pathParts(parent_name)
        let* matches = |parts, i| {
            if i < parent_parts.length {
                if parts[i] != parent_parts[i] {
                    false
                } else {
                    matches(parts, i + 1)
                }
            } else {
                true
            }
        }
        let names = Object.getOwnPropertyNames(self.registry)
        names.forEach(|name| {
            let parts = self._pathParts(name)
            if parts.length == parent_parts.length + 1 and matches(parts, 0) {
                self._linkPath(name, self.registry[name])
            }
        })
        0
    }

    remove: |target, name| {
        self._withLock({
            if target == null or target[self.entryKey] == undefined {
                throw "not a module"
            }
            let desc = Object.getOwnPropertyDescriptor(target, name)
            if desc == undefined {
                false
            } else {
                let removed = Object.deleteProperty(target, name)
                if removed {
                    let entry = target[self.entryKey]
                    if entry != undefined {
                        Object.deleteProperty(entry.owners, name)
                    }
                }
                removed
            }
        })
    }

    reset: |target, initializer| {
        self._withLock({
            if target == null or target[self.entryKey] == undefined {
                throw "not a module"
            }
            let entry = target[self.entryKey]
            if !Object.isExtensible(target) {
                throw "cannot reset non-extensible module"
            }
            let own = Object.getOwnPropertyNames(target)
            own.forEach(|key| {
                let desc = Object.getOwnPropertyDescriptor(target, key)
                if desc != undefined and desc.configurable == false {
                    throw "cannot reset sealed module property: " + key
                }
            })

            let oldOwners = entry.owners
            let oldExtensions = entry.extensions
            entry.owners = Object.create(null)
            entry.extensions = Object.create(null)

            let failed = false
            let error = null
            try {
                self._update(target, target, initializer, false)
            } catch (e) {
                failed = true
                error = e
            }
            if failed {
                entry.owners = oldOwners
                entry.extensions = oldExtensions
                throw error
            }

            self._linkPath(entry.name, target)
            self._relinkChildren(entry.name)
            target
        })
    }

}

if !Modules.error {
    KetteTools.evalFile(ERROR_PATH)
}
if !Modules.sync {
    KetteTools.evalFile(SYNC_PATH)
}
if !Modules.collection {
    KetteTools.evalFile(COLLECTION_PATH)
}
if !Modules.ffi {
    KetteTools.evalFile(FFI_PATH)
}

let windows = KetteTools.primitives.os.name == "windows"

if globalThis.SysLib == undefined {
    globalThis.SysLib = if windows {
        Modules.ffi.library("ucrtbase.dll")
    } else {
        Modules.ffi.library(null)
    }
}

if windows {
    if !Modules.sys or Modules.sys.windows == undefined {
        KetteTools.evalFile(WINDOWS_SYS_PATH)
    }
    if Modules.sys.windows.file == undefined {
        KetteTools.evalFile(WINDOWS_FILE_PATH)
    }
} else {
    if !Modules.sys or Modules.sys.libc == undefined {
        KetteTools.evalFile(LIBC_SYS_PATH)
    }
    if Modules.sys.libc.file == undefined {
        KetteTools.evalFile(LIBC_FILE_PATH)
    }
}

globalThis.SysBackend = if windows { Modules.sys.windows } else { Modules.sys.libc }

if !Modules.sys or Modules.sys.raw == undefined {
    KetteTools.evalFile(SYS_PATH)
}
if !Modules.sys or Modules.sys.file == undefined {
    KetteTools.evalFile(FS_PATH)
}
if !Modules.random {
    KetteTools.evalFile(RANDOM_PATH)
}
if !Modules.ui {
    KetteTools.evalFile(UI_PATH)
}
if !Modules.ui.verify {
    KetteTools.evalFile(UI_VERIFY_PATH)
}
