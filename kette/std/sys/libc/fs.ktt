use ffi
use sys.libc { raw }

let Seek = {
    SET: 0,
    CUR: 1,
    END: 2,
}

let FileTraits = {
    disposable*: Disposable

    open: |path, mode| {
        let mode = if mode == null { "rb" } else { mode }
        let file = self.clone()
        file.handle = raw.fopen(path, mode)
        if ffi.isNull(file.handle) {
            throw "cannot open file: " + path
        }
        file.disposed = false
        file
    }

    temp: {
        let file = self.clone()
        file.handle = raw.tmpfile()
        if ffi.isNull(file.handle) {
            throw "cannot create temporary file"
        }
        file.disposed = false
        file
    }

    tell: {
        let position = raw.ftell(self.handle)
        if position < 0 {
            throw "ftell failed"
        }
        position
    }

    seek: |offset, origin| {
        if raw.fseek(self.handle, offset, origin) != 0 {
            throw "fseek failed"
        }
        self
    }

    size: {
        let current = self.tell()
        self.seek(0, Seek.END)
        let size = self.tell()
        self.seek(current, Seek.SET)
        size
    }

    read: |size| {
        let data = ffi.array(ffi.u8, size).new()
        let count = raw.fread(data, 1, size, self.handle)
        if count != size {
            data.free()
            throw "short read"
        }
        { data: data, size: count }
    }

    readAll: {
        let size = self.size()
        self.seek(0, Seek.SET)
        self.read(size)
    }

    readText: {
        let size = self.size()
        if size == 0 {
            return ""
        }
        let data = ffi.array(ffi.u8, size).new()
        self.seek(0, Seek.SET)
        let count = raw.fread(data, 1, size, self.handle)
        if count != size {
            data.free()
            throw "short read"
        }
        let text = null
        try {
            text = ffi.string_at(data)
        } catch (e) {
            data.free()
            throw e
        }
        data.free()
        text
    }

    write: |data, size| {
        let count = raw.fwrite(data.cast(ffi.u8), 1, size, self.handle)
        if count != size {
            throw "short write"
        }
        self
    }

    writeText: |text| {
        let data = ffi.cstring(text)
        let status = raw.fputs(data, self.handle)
        data.free()
        if status < 0 {
            throw "fputs failed"
        }
        self
    }

    flush: {
        if raw.fflush(self.handle) != 0 {
            throw "fflush failed"
        }
        self
    }

    dispose: {
        if self.disposed {
            return 0
        }
        self.disposed = true
        let status = raw.fclose(self.handle)
        self.handle = null
        if status != 0 {
            throw "fclose failed"
        }
        0
    }
}

let File = {
    traits*: FileTraits
    handle: null
    disposed: false
}

let readDir = |path| {
    let dir = raw.opendir(path)
    if ffi.isNull(dir) {
        throw "cannot open directory: " + path
    }
    // struct dirent: d_name is at byte 21 on macOS and 19 on glibc.
    let name_offset = if KetteTools.primitives.os.name == "macos" { 21 } else { 19 }
    let names = []
    let failed = false
    let error = null
    let* readEntries = {
        let entry = raw.readdir(dir)
        if !ffi.isNull(entry) {
            let name = ffi.string_at(entry.add(name_offset))
            if name != "." and name != ".." {
                names.push(name)
            }
            readEntries()
        }
    }
    try {
        readEntries()
    } catch (e) {
        failed = true
        error = e
    }
    let status = raw.closedir(dir)
    if failed {
        throw error
    }
    if status != 0 {
        throw "closedir failed: " + path
    }
    names.sort()
    names
}

mod sys.libc.file {
    export Seek = Seek
    export File = File
    export readDir = readDir
}
