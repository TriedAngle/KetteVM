let Thread = KetteTools.primitives.thread

let wake = |thread| { 
    if thread.unpark() {
        let scheduler = thread.scheduler
        if scheduler != null {
            scheduler.enqueue(thread)
        }
    }
}

let parkNanos = |nanos| { 
    let me = Thread.current()
    let scheduler = me.scheduler
    if scheduler != null {
        scheduler.parkNanos(nanos)
        false
    } else {
        me.parkNanos(nanos)
    }
}

mod threads {
    export Thread = Thread
    export wake = wake
    export parkNanos = parkNanos
}
