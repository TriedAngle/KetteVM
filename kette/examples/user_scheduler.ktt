// A userspace scheduler running on its own platform thread.
//
// The scheduler thread owns a ready queue and mounts virtual threads itself.
// The main thread keeps running in parallel and appends to the same string
// under a mutex from std/sync.ktt.
//
// Run: cargo run -- kette/examples/user_scheduler.ktt

KetteTools.evalFile("kette/std/startup.ktt")

let Mutex = Modules.sync.Mutex
let guard = Mutex.new()

let text = ""
let append = |part| {
    guard.lock()
    text = text + part
    guard.unlock()
}

// A ready queue owned by the scheduler thread.
let queue = {}
let head = 0
let tail = 0
let enqueue = |thread| {
    queue[tail] = thread
    tail = tail + 1
}
let run_scheduler = {
    while head < tail {
        let thread = queue[head]
        head = head + 1
        if thread.isReady() {
            thread.mount()
        }
        if thread.isAlive() {
            enqueue(thread)
        }
    }
    append("S")
}

let va = Thread.newVirtual("va", {
    append("a1")
    Thread.yield()
    append("a2")
})
let vb = Thread.newVirtual("vb", {
    append("b1")
    Thread.yield()
    append("b2")
})
enqueue(va)
enqueue(vb)

// The scheduler runs on a real OS thread; main continues independently.
let scheduler_thread = Thread.newPlatform("scheduler", run_scheduler)
scheduler_thread.start()

append("m1")
Thread.sleep(1)
append("m2")

scheduler_thread.join()
print(text)
print(text.length)
