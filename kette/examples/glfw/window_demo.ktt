// Opens a GLFW + OpenGL window with a guest key callback.
// Run: cargo run -- kette/examples/glfw/window_demo.ktt

KetteTools.evalFile("kette/std/startup.ktt")
KetteTools.evalFile("kette/vendor/glfw.ktt")

use ffi
use os
use vendor.glfw
let (void, i32, u32, f32, CString) = ffi

let gl_path = if os.name == "macos" {
        "/System/Library/Frameworks/OpenGL.framework/OpenGL"
    } else if os.name == "windows" {
        "opengl32.dll"
    } else {
        "libGL.so.1"
    }

let gl = ffi.library(gl_path)

let glClearColor = gl.fn("glClearColor", [f32, f32, f32, f32], void)
let glClear = gl.fn("glClear", [u32], void)

let GL_COLOR_BUFFER_BIT = 16384

// GLFWkeyfun: void (*)(GLFWwindow *, int key, int scancode, int action, int mods)
let onKey = ffi.callback(
    [glfw.Window, i32, i32, i32, i32],
    void,
    |window, key, scancode, action, mods| {
        if action == glfw.PRESS {
            print(key)
            if key == glfw.KEY_ESCAPE {
                glfw.setShouldClose(window, 1)
            }
        }
    }
)

glfw.init()
let window = glfw.createWindow(640, 480, "kette + glfw", null, null)
glfw.makeContextCurrent(window)
glfw.setKeyCallback(window, onKey)

while glfw.shouldClose(window) == 0 {
    glClearColor(0.1, 0.2, 0.3, 1.0)
    glClear(GL_COLOR_BUFFER_BIT)
    glfw.swapBuffers(window)
    glfw.pollEvents()
}

glfw.terminate()
print("done")
