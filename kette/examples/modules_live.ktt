// Run: cargo run -q -p vm -- kette/std/startup.ktt \
//      kette/examples/modules_live.ktt

mod greeting {
    export text = "hello"
    export times = 1
    export double = |x| { x * 2 }
}

use greeting

print("initial: " + greeting.text)
print("double(4): " + greeting.double(4))
print("same module:")
print(greeting == Modules.greeting)

// External properties survive a reload.
greeting.note = "kept"

mod greeting {
    export text = "hi"
    export times = 2
    export double = |x| { x * 2 + 1 }
}

print("reloaded: " + greeting.text)
print("double(4): " + greeting.double(4))
print("external note: " + greeting.note)

// Nested values keep their identity and are updated in place.
let settings = { level: 1 }

mod config {
    export settings = settings
}

mod config {
    export settings = { level: 2 }
}

print("same settings object:")
print(Modules.config.settings == settings)
print("settings level: " + settings.level)

// Extensions are hidden parts of the module.
mod greeting extend stats {
    export total = greeting.times * 10
}

print("stats total: " + greeting.total)

mod greeting extend stats {
    export twice = greeting.times * 2
}

print("stats total removed:")
print(greeting.total == undefined)
print("stats twice: " + greeting.twice)

use greeting { text as imported_text, double as imported_double }
print("imported text: " + imported_text)
print("imported double(4): " + imported_double(4))

// Files are loaded explicitly; re-evaluating them updates modules in place.
globalThis.LIVE_VALUE = 1
KetteTools.evalFile("kette/examples/modules/live_math.ktt")
KetteTools.evalFile("kette/examples/modules/live_stats.ktt")

use live.math as math
print("file value: " + math.value)
print("stats saw: " + math.seen)
print("square(5): " + math.square(5))

globalThis.LIVE_VALUE = 2
KetteTools.evalFile("kette/examples/modules/live_math.ktt")
KetteTools.evalFile("kette/examples/modules/live_stats.ktt")

print("file value after reload: " + math.value)
print("stats saw after reload: " + math.seen)

// Reset rebuilds the exports on the same facade.
ModuleRegistry.reset(greeting, |m| {
    m.text = "reset"
    m.times = 0
})

print("reset: " + greeting.text)
print("extensions dropped:")
print(greeting.twice == undefined)
