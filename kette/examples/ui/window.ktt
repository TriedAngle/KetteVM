// Renders the UI paint list in a GLFW window through tgpu.
// Run: cargo run -- kette/examples/ui/window.ktt

KetteTools.evalFile("kette/std/startup.ktt")

use ui { Hit, K_SPLITTER, Node, OP_CLIP, OP_CLIP_POP, OP_RECT, OP_SHADOW, rgb, Space, Splitter, Windows }
KetteTools.evalFile("kette/vendor/tgpu.ktt")
KetteTools.evalFile("kette/vendor/glfw.ktt")

use ffi
use sys
use vendor.glfw
use vendor.tgpu
let { struct, u32, f32, ... } = ffi

let CAPACITY = 4096
let FLOATS = 8
let INSTANCE_BYTES = FLOATS * 4

let UiPush = struct({
    instances: u32,
    screen_width: f32,
    screen_height: f32,
    pad: f32,
})

let window = glfw.Window.new("kette ui", 800, 600, {
    clientApi: glfw.ClientApi.none,
})
let { width, height } = window.framebufferSize()
if width <= 0 or height <= 0 {
    throw "window has no framebuffer"
}

window.onKey(|key, action, mods| {
    match [action, key] {
        [:press, :escape] => {
            window.setShouldClose(true)
        }
        _ => {}
    }
})

let gpu = tgpu.GPU.new()
let queue = gpu.queue

let swapchain = gpu.swapchain({
    window: window.tgpuWindow()
    width: width
    height: height
    imageCount: 3
    presentMode: tgpu.PresentMode.fifo
})

let extent = gpu.swapchainExtent(swapchain)
let color_format = tgpu.swapchainFormat(swapchain)

let instance_buffer = gpu.buffer({
    size: CAPACITY * INSTANCE_BYTES
    usage: tgpu.BufferUsage.storage
    memory: tgpu.MemoryPreset.dynamic
    hostAccess: tgpu.HostAccess.readWriteRandom
})

let bindless = gpu.bindless({ maxReadBuffers: 1 })
let instance_index = tgpu.bindlessAddReadBuffer(bindless, instance_buffer)

let shader = gpu.shaderSlang("kette/examples/ui/shader.slang")
let ui_push = gpu.pushConstants(UiPush)
let pipeline = gpu.renderPipeline({
    shader: shader
    vertexEntry: "vertexMain"
    fragmentEntry: "fragmentMain"
    colorFormats: [color_format]
    bindless: bindless
    pushConstants: ui_push
    cull: tgpu.CullMode.none
    blend: tgpu.Blend.alpha
})

let space = Space.new(width, height)
let toolbar = Splitter.row(
    8,
    8,
    Node.Box(60, 44, rgb(200, 80, 80)),
    Node.Box(0, 44, rgb(80, 160, 80)),
    rgb(120, 120, 140)
)
let inspector = Node.Window("Inspector", 60, 60, 360, 200, toolbar)

let transcript_body = Splitter.row(
    6,
    6,
    Node.Box(120, 0, rgb(90, 90, 110)),
    Node.Box(0, 0, rgb(60, 60, 90)),
    rgb(120, 120, 140)
)
let transcript = Node.Window("Transcript", 240, 180, 380, 240, transcript_body)

space.root.addChild(inspector)
space.root.addChild(transcript)
space.frame()

let mouse = { x: 0, y: 0 }
let drag = {
    active: 0,
    mode: 0,
    window: null,
    splitter: null,
    dx: 0,
    dy: 0,
    startX: 0
}

window.onCursorFramebuffer(|x, y| {
    let mouse_x = x
    let mouse_y = y
    mouse.x = mouse_x
    mouse.y = mouse_y
    if drag.active == 1 {
        if drag.mode == 2 and drag.splitter != null {
            let delta = mouse_x - drag.startX
            drag.startX = mouse_x
            Splitter.resize(drag.splitter, delta)
        } else if drag.mode == 1 and drag.window != null {
            drag.window.x = Math.floor(mouse_x - drag.dx)
            drag.window.y = Math.floor(mouse_y - drag.dy)
            drag.window.markPaint()
        }
    }
})

window.onMouseButton(|button, action, mods| {
    match [button, action] {
        [0, :press] => {
            let hit = Hit.test(space.root, mouse.x, mouse.y)
            if hit != null {
                let win = Windows.rootOf(hit)
                if win != null { Windows.raise(space.root, win) }
                if hit.kind == K_SPLITTER {
                    drag.active = 1
                    drag.mode = 2
                    drag.splitter = hit
                    drag.startX = mouse.x
                } else if win != null {
                    drag.active = 1
                    drag.mode = 1
                    drag.window = win
                    drag.dx = mouse.x - win.x
                    drag.dy = mouse.y - win.y
                }
            }
        }
        [0, :release] => {
            drag.active = 0
            drag.mode = 0
            drag.window = null
            drag.splitter = null
        }
        _ => {}
    }
})

let instances = ffi.array(ffi.f32, CAPACITY * FLOATS).new()

let fill_instances = |ops| {
    let count = 0
    let* visit = |i| {
        if i < ops.length {
            let op = ops[i]
            if op == OP_RECT {
                if count < CAPACITY {
                    let x = ops[i + 1]
                    let y = ops[i + 2]
                    let w = ops[i + 3]
                    let h = ops[i + 4]
                    let color = ops[i + 5]
                    let r = Math.floor(color / 65536)
                    let g = Math.floor(color / 256) - r * 256
                    let b = color - r * 65536 - g * 256
                    let base = count * FLOATS
                    instances.set(base + 0, x)
                    instances.set(base + 1, y)
                    instances.set(base + 2, w)
                    instances.set(base + 3, h)
                    instances.set(base + 4, r / 255.0)
                    instances.set(base + 5, g / 255.0)
                    instances.set(base + 6, b / 255.0)
                    instances.set(base + 7, 1.0)
                    count = count + 1
                }
                visit(i + 6)
            } else if op == OP_SHADOW {
                visit(i + 6)
            } else if op == OP_CLIP {
                visit(i + 5)
            } else {
                visit(i + 1)
            }
        }
    }
    visit(0)
    count
}

let attachments = gpu.array(tgpu.ColorAttachment, 1)
let render_info = gpu.own(tgpu.renderDesc({ colorCount: 1, colors: attachments }))
ui_push.instances = instance_index

while window.isOpen() {
    window.poll()

    let { width: frame_width, height: frame_height } = window.framebufferSize()

    if frame_width <= 0 or frame_height <= 0 {
        continue
    }
    if frame_width != extent.width or frame_height != extent.height {
        extent.width = frame_width
        extent.height = frame_height
        gpu.swapchainSetExtent(swapchain, extent)
        gpu.swapchainRecreate({ swapchain: swapchain })
        space.root.w = frame_width
        space.root.h = frame_height
        space.root.markLayout()
    }

    let { frame, extent: current, resized } = gpu.acquireFrame(swapchain)
    extent = current

    let ops = space.frame()
    let count = fill_instances(ops)
    if count > 0 {
        tgpu.bufferWrite(
            instance_buffer,
            0,
            instances.cast(ffi.u8),
            count * INSTANCE_BYTES
        )
    }

    ui_push.screen_width = extent.width
    ui_push.screen_height = extent.height

    let recorder = gpu.recorderBegin({ queue: queue })
    gpu.recorderTransitionFrame({
        recorder: recorder
        swapchain: swapchain
        frame: frame
        layout: tgpu.ImageLayout.color
    })

    gpu.writeColorAttachment({
        attachments: attachments
        index: 0
        view: gpu.swapchainView({ swapchain: swapchain, frame: frame })
        layout: tgpu.ImageLayout.color
        load: tgpu.LoadOp.clear
        store: tgpu.StoreOp.store
        clearColor: [0.05, 0.05, 0.06, 1.0]
    })

    render_info.width = extent.width
    render_info.height = extent.height

    gpu.render({
        recorder: recorder
        desc: render_info
        pipeline: pipeline
        bindless: bindless
        pushConstants: ui_push
    }, |recorder| {
        gpu.recorderDraw({
            recorder: recorder
            firstVertex: 0
            vertexCount: count
            firstInstance: 0
            instanceCount: 1
        })
    })
    gpu.recorderTransitionFrame({
        recorder: recorder
        swapchain: swapchain
        frame: frame
        layout: tgpu.ImageLayout.present
    })

    let command = gpu.recorderFinish({ recorder: recorder })
    gpu.swapchainEndFrame({
        queue: queue
        swapchain: swapchain
        frame: frame
        command: command
    })

    space.tick(16)
}

instances.free()
gpu.dispose()

window.dispose()
