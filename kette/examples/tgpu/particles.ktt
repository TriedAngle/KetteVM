// Renders 10,000 GPU particles with tgpu.
// Run: cargo run -- kette/examples/tgpu/particles.ktt

KetteTools.evalFile("kette/std/startup.ktt")
KetteTools.evalFile("kette/vendor/tgpu.ktt")
KetteTools.evalFile("kette/vendor/glfw.ktt")

use collection { range }
use ffi
use random
use sys
use vendor.glfw
use vendor.tgpu

let PARTICLE_COUNT = 10000
let FLOATS_PER_PARTICLE = 8
let PARTICLE_BYTES = PARTICLE_COUNT * FLOATS_PER_PARTICLE * 4
let SHADER_PATH = "kette/examples/tgpu/shader.slang"

let window = glfw.Window.new("tgpu particles (Kette)", 800, 600, {
    clientApi: glfw.ClientApi.none,
})

let { width: start_width, height: start_height } = window.framebufferSize()
if start_width <= 0 or start_height <= 0 {
    throw "window has no framebuffer"
}

let gpu = tgpu.GPU.new()
let queue = gpu.queue

let mouse = { x: 0, y: 0 }

window.onCursorFramebuffer(|x, y| {
    mouse.x = x
    mouse.y = window.framebufferSize().height - y
})

window.onKey(|key, action, mods| {
    match [action, key] {
        [:press, :escape] => {
            window.setShouldClose(true)
        }
        _ => {}
    }
})

let swapchain = gpu.swapchain({
    window: window.tgpuWindow()
    width: start_width
    height: start_height
    imageCount: 3
    presentMode: tgpu.PresentMode.fifo
})

let extent = gpu.swapchainExtent(swapchain)
let color_format = tgpu.swapchainFormat(swapchain)

let particle_data = ffi.array(ffi.f32, PARTICLE_COUNT * FLOATS_PER_PARTICLE).new()
random.seed(1)
for particle_index in range(0, PARTICLE_COUNT) {
    let base = particle_index * FLOATS_PER_PARTICLE
    particle_data[base + 0] = random.unit() * extent.width
    particle_data[base + 1] = random.unit() * extent.height
    particle_data[base + 2] = (random.unit() * 2.0 - 1.0) * 30.0
    particle_data[base + 3] = (random.unit() * 2.0 - 1.0) * 30.0
    particle_data[base + 4] = 0.5 + random.unit() * 0.5
    particle_data[base + 5] = 0.5 + random.unit() * 0.5
    particle_data[base + 6] = 0.5 + random.unit() * 0.5
    particle_data[base + 7] = 1.0
}
let particle_buffer = gpu.buffer({
    size: PARTICLE_BYTES
    usage: tgpu.BufferUsage.storage + tgpu.BufferUsage.copyDst
    memory: tgpu.MemoryPreset.dynamic
    hostAccess: tgpu.HostAccess.readWriteRandom
    data: particle_data
})
particle_data.free()

let createPresentImage = |width, height| {
    gpu.presentImage({
        image: {
            format: color_format
            width: width
            height: height
            // COPY_SRC | COPY_DST | STORAGE | COLOR_ATTACHMENT | SAMPLED
            usage: tgpu.ImageUsage.copySrc + tgpu.ImageUsage.copyDst +
                tgpu.ImageUsage.storage + tgpu.ImageUsage.colorAttachment +
                tgpu.ImageUsage.sampled
        }
        sampler: {}
    })
}

let present_image = createPresentImage(extent.width, extent.height)

let bindless = gpu.bindless({
    maxRwBuffers: 1
    maxSampledImages: 1
    maxStorageImages: 1
    maxSamplers: 1
})

let pc = gpu.pushConstants(tgpu.PushConstants)
pc.particles = gpu.bindlessAddRwBuffer({
    bindless: bindless
    buffer: particle_buffer
})
pc.output_image = gpu.bindlessAddStorageImage({
    bindless: bindless
    image: present_image
    layout: tgpu.ImageLayout.general
})
pc.present_texture = gpu.bindlessAddSampledImage({
    bindless: bindless
    image: present_image
    layout: tgpu.ImageLayout.fragment
})
pc.present_sampler = gpu.bindlessAddSampler({
    bindless: bindless
    image: present_image
})
pc.window.width = extent.width
pc.window.height = extent.height

let resizePresentImage = |width, height| {
    present_image = createPresentImage(width, height)
    gpu.bindlessUpdateStorageImage({
        bindless: bindless
        handle: pc.output_image
        image: present_image
        layout: tgpu.ImageLayout.general
    })
    gpu.bindlessUpdateSampledImage({
        bindless: bindless
        handle: pc.present_texture
        image: present_image
        layout: tgpu.ImageLayout.fragment
    })
    gpu.bindlessUpdateSampler({
        bindless: bindless
        handle: pc.present_sampler
        image: present_image
    })
    pc.window.width = width
    pc.window.height = height
}

let shader = gpu.shaderSlang(SHADER_PATH)

let createComputePipeline = |entry| {
    gpu.computePipeline({
        shader: shader
        entry: entry
        bindless: bindless
        pushConstants: pc
    })
}
let compute_pipeline = createComputePipeline("computeMain")
let clear_pipeline = createComputePipeline("computeClear")
let render_pipeline = gpu.renderPipeline({
    shader: shader
    vertexEntry: "vertexMain"
    fragmentEntry: "fragmentMain"
    colorFormats: [color_format]
    bindless: bindless
    pushConstants: pc
})

let attachments = gpu.array(tgpu.ColorAttachment, 1)
let render_info = gpu.own(tgpu.renderDesc({ colorCount: 1, colors: attachments }))

let last_time = window.time()
let smoothed_dt = 1.0 / 60.0
let frame_count = 0

while window.isOpen() {
    window.poll()

    let { width: frame_width, height: frame_height } = window.framebufferSize()

    if frame_width <= 0 or frame_height <= 0 {
        continue
    }

    if frame_width != extent.width or frame_height != extent.height {
        extent.width = frame_width
        extent.height = frame_height
        gpu.swapchainSetExtent(swapchain, extent)
        gpu.swapchainRecreate({ swapchain: swapchain })
    }

    let now = window.time()
    let measured = Math.max(
        1.0 / 240.0,
        Math.min(now - last_time, 1.0 / 15.0)
    )
    last_time = now
    smoothed_dt = smoothed_dt * 0.9 + measured * 0.1

    let { frame, extent: current, resized } = gpu.acquireFrame(swapchain)
    if resized {
        extent = current
        resizePresentImage(extent.width, extent.height)
    }

    pc.mouse.x = mouse.x
    pc.mouse.y = mouse.y
    pc.dt = smoothed_dt * 6.0

    let recorder = gpu.recorderBegin({ queue: queue })

    gpu.recorderTransitionImage({
        recorder: recorder
        image: present_image
        layout: tgpu.ImageLayout.compute
    })

    gpu.recorderBindCompute({
        recorder: recorder
        pipeline: compute_pipeline
        bindless: bindless
        pushConstants: pc
    })
    gpu.recorderDispatch({
        recorder: recorder
        x: Math.ceil(PARTICLE_COUNT / 256)
        y: 1
        z: 1
    })

    gpu.recorderBindCompute({
        recorder: recorder
        pipeline: clear_pipeline
        bindless: bindless
        pushConstants: pc
    })
    gpu.recorderDispatch({
        recorder: recorder
        x: Math.ceil(extent.width / 16)
        y: Math.ceil(extent.height / 16)
        z: 1
    })

    gpu.recorderTransitionImage({
        recorder: recorder
        image: present_image
        layout: tgpu.ImageLayout.fragment
    })

    gpu.recorderTransitionFrame({
        recorder: recorder
        swapchain: swapchain
        frame: frame
        layout: tgpu.ImageLayout.color
    })

    let color = sys.raw.fabsf(sys.raw.sinf(frame_count / 120.0))
    gpu.writeColorAttachment({
        attachments: attachments
        index: 0
        view: gpu.swapchainView({ swapchain: swapchain, frame: frame })
        layout: tgpu.ImageLayout.color
        load: tgpu.LoadOp.clear
        store: tgpu.StoreOp.store
        clearColor: [0.0, color, 1.0 - color, 1.0]
    })

    render_info.width = extent.width
    render_info.height = extent.height

    gpu.render({
        recorder: recorder
        desc: render_info
        pipeline: render_pipeline
        bindless: bindless
        pushConstants: pc
    }, |recorder| {
        gpu.recorderDraw({
            recorder: recorder
            firstVertex: 0
            vertexCount: 6
            firstInstance: 0
            instanceCount: 1
        })
    })

    gpu.recorderTransitionFrame({
        recorder: recorder
        swapchain: swapchain
        frame: frame
        layout: tgpu.ImageLayout.present
    })

    let command = gpu.recorderFinish({ recorder: recorder })
    gpu.swapchainEndFrame({
        queue: queue
        swapchain: swapchain
        frame: frame
        command: command
    })

    frame_count = frame_count + 1
}

gpu.dispose()

window.dispose()

print("done")
