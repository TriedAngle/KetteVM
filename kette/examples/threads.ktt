// Compares atomic and racy counters across platform threads.
// Run: cargo run -- kette/examples/threads.ktt

KetteTools.evalFile("kette/std/startup.ktt")
use atomic { AtomicI64 }
use threads { Thread }

let rounds = 200000

// Platform threads: the plain load/store increment races by design.
let atomic_counter = AtomicI64.new(0)
let racy_counter = AtomicI64.new(0)
let worker = {
    let i = 0
    while i < rounds {
        atomic_counter.add(1)
        racy_counter.store(racy_counter.load() + 1)
        i = i + 1
    }
}

let a = Thread.newPlatform("a", worker)
let b = Thread.newPlatform("b", worker)
a.start()
b.start()
a.join()
b.join()
print("atomic")
print(atomic_counter.load())
print("racy")
print(racy_counter.load())

// Virtual threads run under a userspace scheduler.
let queue = {}
let head = 0
let tail = 0
let enqueue = |thread| {
    queue[tail] = thread
    tail = tail + 1
}
let run_scheduler = {
    while head < tail {
        let thread = queue[head]
        head = head + 1
        if thread.isReady() and thread.mount() {
            enqueue(thread)
        }
    }
}

let order = ""
let va = Thread.newVirtual("va", {
    order = order + "a1"
    Thread.yield()
    order = order + "a2"
})
let vb = Thread.newVirtual("vb", {
    order = order + "b1"
    Thread.yield()
    order = order + "b2"
})
enqueue(va)
enqueue(vb)
let scheduler = Thread.newPlatform("scheduler", run_scheduler)
scheduler.start()
scheduler.join()
print("virtual")
print(order)
