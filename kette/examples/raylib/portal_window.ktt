// Ports raylib's portal-window example with render-to-texture 3D drawing.
// Run: cargo run -- kette/examples/raylib/portal_window.ktt

KetteTools.evalFile("kette/std/startup.ktt")
KetteTools.evalFile("kette/vendor/raylib.ktt")

use sys { raw }
use vendor.raylib as rb

// Release the external storage of a group of C values.
let freeAll = |values| {
    let* free = |index| {
        if index < values.length {
            values[index].free()
            free(index + 1)
        }
    }
    free(0)
}

let beginPortalMode3D = |eye, bottomLeft, bottomRight, topLeft, nearPlane, farPlane| {
    let bottomEdge = rb.Vector3Subtract(bottomRight, bottomLeft)
    let right = rb.Vector3Normalize(bottomEdge)
    let leftEdge = rb.Vector3Subtract(topLeft, bottomLeft)
    let up = rb.Vector3Normalize(leftEdge)
    let cross = rb.Vector3CrossProduct(right, up)
    let normal = rb.Vector3Normalize(cross)

    let toBL = rb.Vector3Subtract(bottomLeft, eye)
    let toBR = rb.Vector3Subtract(bottomRight, eye)
    let toTL = rb.Vector3Subtract(topLeft, eye)

    let dist = -rb.Vector3DotProduct(toBL, normal)
    if dist < 0.01 { dist = 0.01 }
    let scale = nearPlane / dist

    rb.rlDrawRenderBatchActive()

    rb.rlMatrixMode(rb.MatrixMode.projection)
    rb.rlPushMatrix()
    let frustum = rb.MatrixFrustum(
        rb.Vector3DotProduct(right, toBL) * scale,
        rb.Vector3DotProduct(right, toBR) * scale,
        rb.Vector3DotProduct(up, toBL) * scale,
        rb.Vector3DotProduct(up, toTL) * scale,
        nearPlane,
        farPlane)
    rb.rlSetMatrixProjection(frustum)

    rb.rlMatrixMode(rb.MatrixMode.modelview)
    rb.rlLoadIdentity()
    let target = rb.Vector3Subtract(eye, normal)
    let view = rb.MatrixLookAt(eye, target, up)
    let flat = rb.MatrixToFloatV(view)
    rb.rlMultMatrixf(flat)

    rb.rlEnableDepthTest()

    freeAll([
        bottomEdge, right, leftEdge, up, cross, normal, toBL, toBR, toTL,
        frustum, target, view, flat
    ])
}

let endPortalMode3D = {
    rb.rlDrawRenderBatchActive()
    rb.rlMatrixMode(rb.MatrixMode.projection)
    rb.rlPopMatrix()
    rb.rlMatrixMode(rb.MatrixMode.modelview)
    rb.rlLoadIdentity()
    rb.rlDisableDepthTest()
}

rb.InitWindow(800, 450, "raylib [textures] example - portal window")

let camera = rb.Camera3D.new()
camera.position = rb.Vector3.new(0, 2.5, 7)
camera.target = rb.Vector3.new(0, 1.8, 0)
camera.up = rb.Vector3.new(0, 1, 0)
camera.fovy = 45
camera.projection = rb.CameraProjection.perspective

// The archway opening, in Dimension A world space.
let archBottomLeft = rb.Vector3.new(-1.5, 0, 0)
let archBottomRight = rb.Vector3.new(1.5, 0, 0)
let archTopLeft = rb.Vector3.new(-1.5, 4, 0)

// The archway sits at portalA and looks out onto portalB, far away.
let portalA = rb.Vector3.new(0, 0, 0)
let portalB = rb.Vector3.new(0, 0, -60)
let offset = rb.Vector3Subtract(portalB, portalA)
let rtPortalView = rb.LoadRenderTexture(480, 640)
let portalTextureId = rtPortalView.texture.id

rb.DisableCursor()
rb.SetTargetFPS(60)

let hudBackground = rb.Fade(rb.BLACK, 0.75)
let portalBackground = rb.Color.new(10, 5, 20, 255)
let pillarA = rb.Vector3.new(-3.5, 2, 0)
let pillarB = rb.Vector3.new(3.5, 2, 0)
let archCenter = rb.Vector3.new(0, 2, 0)
let archBase = rb.Vector3.new(0, 0.05, 0)
let archWall = rb.Vector3.new(0, 2, -0.05)

let drawCubes = |time| {
    let i = 0
    while i < 4 {
        let angle = time * 1.5 + i * (rb.PI / 2)
        let posOffset = rb.Vector3.new(
            raw.sinf(angle) * 2.5,
            2 + raw.cosf(time * 3 + i) * 0.5,
            -4 + raw.cosf(angle) * 2.5)
        let pos = rb.Vector3Add(portalB, posOffset)
        rb.DrawCube(pos, 0.5, 0.5, 0.5, rb.LIME)
        rb.DrawCubeWires(pos, 0.52, 0.52, 0.52, rb.DARKGREEN)
        freeAll([posOffset, pos])
        i = i + 1
    }
}

while !rb.WindowShouldClose() {
    rb.UpdateCamera(camera, rb.CameraMode.free)
    let time = rb.GetTime()

    // Shift the eye and window corners into Dimension B.
    let eyeInB = rb.Vector3Add(camera.position, offset)
    let blInB = rb.Vector3Add(archBottomLeft, offset)
    let brInB = rb.Vector3Add(archBottomRight, offset)
    let tlInB = rb.Vector3Add(archTopLeft, offset)

    rb.BeginTextureMode(rtPortalView)
    rb.ClearBackground(portalBackground)
    beginPortalMode3D(eyeInB, blInB, brInB, tlInB, 0.05, 100)
    freeAll([eyeInB, blInB, brInB, tlInB])

    rb.DrawGrid(30, 0.8)

    let coreOffset = rb.Vector3.new(0, 2 + raw.sinf(time * 2.5) * 0.4, -4)
    let corePos = rb.Vector3Add(portalB, coreOffset)
    rb.DrawSphere(corePos, 1.2, rb.PURPLE)
    rb.DrawSphereWires(corePos, 1.25, 16, 16, rb.MAGENTA)
    freeAll([coreOffset, corePos])

    drawCubes(time)

    endPortalMode3D()
    rb.EndTextureMode()

    rb.BeginDrawing()
    rb.ClearBackground(rb.RAYWHITE)
    rb.BeginMode3D(camera)
    rb.DrawGrid(20, 1)

    rb.DrawCube(pillarA, 0.8, 4, 0.8, rb.DARKGRAY)
    rb.DrawCubeWires(pillarA, 0.8, 4, 0.8, rb.ORANGE)
    rb.DrawCube(pillarB, 0.8, 4, 0.8, rb.DARKGRAY)
    rb.DrawCubeWires(pillarB, 0.8, 4, 0.8, rb.ORANGE)

    rb.DrawCubeWires(archCenter, 3.2, 4.2, 0.2, rb.GOLD)
    rb.DrawCube(archBase, 3.4, 0.1, 0.6, rb.MAROON)
    rb.DrawCube(archWall, 3.1, 4.1, 0.05, rb.MAROON)

    rb.rlSetTexture(portalTextureId)
    rb.rlBegin(rb.PrimitiveType.quads)
    rb.rlColor4ub(255, 255, 255, 255)
    rb.rlNormal3f(0, 0, 1)
    rb.rlTexCoord2f(0, 0)
    rb.rlVertex3f(archBottomLeft.x, archBottomLeft.y, archBottomLeft.z)
    rb.rlTexCoord2f(1, 0)
    rb.rlVertex3f(archBottomRight.x, archBottomRight.y, archBottomRight.z)
    rb.rlTexCoord2f(1, 1)
    rb.rlVertex3f(archBottomRight.x, 4, archBottomRight.z)
    rb.rlTexCoord2f(0, 1)
    rb.rlVertex3f(archTopLeft.x, archTopLeft.y, archTopLeft.z)
    rb.rlEnd()
    rb.rlSetTexture(0)

    rb.EndMode3D()

    rb.DrawRectangle(15, 15, 520, 100, hudBackground)
    rb.DrawRectangleLines(15, 15, 520, 100, rb.GOLD)
    rb.DrawText("PORTAL WINDOW", 28, 25, 20, rb.GOLD)
    rb.DrawText("Look through the golden arch into Dimension B", 28, 52, 20, rb.RAYWHITE)
    rb.DrawText("Controls: Mouse to look | WASD to move", 28, 80, 20, rb.GRAY)

    rb.EndDrawing()
}

rb.UnloadRenderTexture(rtPortalView)
freeAll([rtPortalView, camera])
rb.CloseWindow()
print("done")
