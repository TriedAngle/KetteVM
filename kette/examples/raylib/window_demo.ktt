// Kette + raylib: open a window, draw a few frames, close.
// Run: cargo run -q -p vm -- kette/examples/raylib/window_demo.ktt

// macOS does not search Homebrew's lib dir for bare library names.
let path = if os.name == "macos" {
        "/opt/homebrew/lib/libraylib.dylib"
    } else if os.name == "windows" {
        "raylib.dll"
    } else {
        "libraylib.so"
    }

let raylib = FFI.library(path)

let InitWindow = raylib.fn("InitWindow", [FFI.i32, FFI.i32, FFI.CString], FFI.void)
let CloseWindow = raylib.fn("CloseWindow", [], FFI.void)
let SetTargetFPS = raylib.fn("SetTargetFPS", [FFI.i32], FFI.void)
let BeginDrawing = raylib.fn("BeginDrawing", [], FFI.void)
let EndDrawing = raylib.fn("EndDrawing", [], FFI.void)
let ClearBuffers = raylib.fn("rlClearScreenBuffers", [], FFI.void)
let GetScreenWidth = raylib.fn("GetScreenWidth", [], FFI.i32)
let GetFrameTime = raylib.fn("GetFrameTime", [], FFI.f32)

InitWindow(800, 450, "kette + raylib")
SetTargetFPS(60)
print(GetScreenWidth())

let frames = 0
while frames < 90 {
    BeginDrawing()
    ClearBuffers()
    EndDrawing()
    frames = frames + 1
}
print(GetFrameTime())
CloseWindow()
print("done")
