// Kette + raylib: open a window, draw a few frames, close.
// Run: cargo run -q -p vm -- kette/std/startup.ktt kette/examples/raylib/window_demo.ktt
//
// Requires libraylib (brew install raylib).

KetteTools.evalFile("kette/std/startup.ktt")
KetteTools.evalFile("kette/vendor/raylib.ktt")

use vendor.raylib as rb

rb.InitWindow(800, 450, "kette + raylib")
rb.SetTargetFPS(60)
print(rb.GetScreenWidth())

let frames = 0
while frames < 90 {
    rb.BeginDrawing()
    rb.rlClearScreenBuffers()
    rb.EndDrawing()
    frames = frames + 1
}
print(rb.GetFrameTime())
rb.CloseWindow()
print("done")
