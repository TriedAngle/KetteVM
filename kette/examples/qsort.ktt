// Sorts an array through libc qsort with a Kette comparator callback.
// Run: cargo run -- kette/examples/qsort.ktt

KetteTools.evalFile("kette/std/startup.ktt")

use ffi
let { void, i32, u64, ... } = ffi
let libc = ffi.library(null)

let Comparator = ffi.fn([ffi.Ptr, ffi.Ptr], i32)
let ComparatorPointer = ffi.pointer(Comparator)

let qsort = libc.fn(
    "qsort",
    [ffi.pointer(i32), u64, u64, ComparatorPointer],
    void
)

// The pointers arrive as `void *`, so cast them to `i32 *` before reading.
let compare = Comparator.callback(|left, right| {
    let a = left.cast(i32).get(0)
    let b = right.cast(i32).get(0)
    if a < b {
        -1
    } else if a > b {
        1
    } else {
        0
    }
})

let count = 8
let values = ffi.array(i32, count).new()
let i = 0
while i < count {
    values.set(i, (i * 37) % 17)
    i = i + 1
}
print("before")
i = 0
while i < count {
    print(values.get(i))
    i = i + 1
}

qsort(values, count, 4, compare)

print("after")
i = 0
while i < count {
    print(values.get(i))
    i = i + 1
}

values.free()
