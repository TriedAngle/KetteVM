use ffi
use sys
let { Ptr, void, i32, f64, CString, ... } = ffi
let CLIENT_API = 139265
let NO_API = 0

let ClientApi = ffi.enum({
    opengl: 0,
    none: 1,
})
let Key = ffi.enum({
    escape: 256,
})
let Action = ffi.enum({
    release: 0,
    press: 1,
    repeat: 2,
})

let glfw_path = match sys.name {
    "macos" => "libglfw.dylib"
    "windows" => "glfw3.dll"
    _ => "libglfw.so.3"
}

let lib = sys.lib(glfw_path)

let glfwGetCocoaWindow = match sys.name {
    "macos" => lib.fn("glfwGetCocoaWindow", [Ptr], Ptr)
    _ => null
}

let glfwGetX11Display = match sys.name {
    "linux" => lib.fn("glfwGetX11Display", [], Ptr)
    _ => null
}

let glfwGetX11Window = match sys.name {
    "linux" => lib.fn("glfwGetX11Window", [Ptr], Ptr)
    _ => null
}

let glfwGetWin32Window = match sys.name {
    "windows" => lib.fn("glfwGetWin32Window", [Ptr], Ptr)
    _ => null
}

let objc = match sys.name {
    "macos" => ffi.library("/usr/lib/libobjc.A.dylib")
    _ => null
}

let sel_registerName = match sys.name {
    "macos" => objc.fn("sel_registerName", [CString], Ptr)
    _ => null
}

let objc_msgSend = match sys.name {
    "macos" => objc.fn("objc_msgSend", [Ptr, Ptr], Ptr)
    _ => null
}

let raw = {
    lib: lib,
    objc: objc,
    init: lib.fn("glfwInit", [], i32),
    terminate: lib.fn("glfwTerminate", [], void),
    default_window_hints: lib.fn("glfwDefaultWindowHints", [], void),
    window_hint: lib.fn("glfwWindowHint", [i32, i32], void),
    create_window: lib.fn("glfwCreateWindow", [i32, i32, CString, Ptr, Ptr], Ptr),
    destroy_window: lib.fn("glfwDestroyWindow", [Ptr], void),
    make_context_current: lib.fn("glfwMakeContextCurrent", [Ptr], void),
    swap_buffers: lib.fn("glfwSwapBuffers", [Ptr], void),
    should_close: lib.fn("glfwWindowShouldClose", [Ptr], i32),
    set_should_close: lib.fn("glfwSetWindowShouldClose", [Ptr, i32], void),
    poll_events: lib.fn("glfwPollEvents", [], void),
    framebuffer_size: lib.fn("glfwGetFramebufferSize", [Ptr, Ptr, Ptr], void),
    window_size: lib.fn("glfwGetWindowSize", [Ptr, Ptr, Ptr], void),
    time: lib.fn("glfwGetTime", [], f64),
    set_cursor_pos_callback: lib.fn("glfwSetCursorPosCallback", [Ptr, Ptr], void),
    set_mouse_button_callback: lib.fn("glfwSetMouseButtonCallback", [Ptr, Ptr], void),
    get_cursor_pos: lib.fn("glfwGetCursorPos", [Ptr, Ptr, Ptr], void),
    get_mouse_button: lib.fn("glfwGetMouseButton", [Ptr, i32], i32),
    set_key_callback: lib.fn("glfwSetKeyCallback", [Ptr, Ptr], void),
    glfwGetCocoaWindow: glfwGetCocoaWindow,
    glfwGetX11Display: glfwGetX11Display,
    glfwGetX11Window: glfwGetX11Window,
    glfwGetWin32Window: glfwGetWin32Window,
    sel_registerName: sel_registerName,
    objc_msgSend: objc_msgSend,
}

let state = {
    initialized: false,
    windows: 0,
}

let framebuffer_coords = |handle, x, y| {
    let window_size = ffi.array(i32, 2).new()
    let frame_size = ffi.array(i32, 2).new()
    raw.window_size(handle, window_size.add(0), window_size.add(1))
    raw.framebuffer_size(handle, frame_size.add(0), frame_size.add(1))
    let window_width = window_size.get(0)
    let window_height = window_size.get(1)
    let frame_width = frame_size.get(0)
    let frame_height = frame_size.get(1)
    let scale_x = if window_width > 0 { frame_width / window_width } else { 1.0 }
    let scale_y = if window_height > 0 { frame_height / window_height } else { 1.0 }
    let result = {
        x: x * scale_x,
        y: y * scale_y,
    }
    window_size.free()
    frame_size.free()
    result
}

let WindowTraits = {
    disposable*: Disposable

    new: |title, width, height, options| {
        let options = if options == null { {} } else { options }
        if !state.initialized {
            if raw.init() == 0 {
                throw "glfwInit failed"
            }
            state.initialized = true
        }

        raw.default_window_hints()
        let client_api = match options.clientApi {
            null | undefined => ClientApi.opengl
            value => value
        }
        match client_api {
            :none => raw.window_hint(CLIENT_API, NO_API)
            _ => {}
        }

        let window = self.clone()
        window.handle = raw.create_window(width, height, title, null, null)
        if window.handle == null {
            if state.windows == 0 {
                raw.terminate()
                state.initialized = false
            }
            throw "glfwCreateWindow failed"
        }
        window.disposed = false
        window.keyCallback = null
        window.cursorCallback = null
        window.mouseCallback = null
        state.windows = state.windows + 1
        window
    }

    isOpen: {
        !self.disposed and raw.should_close(self.handle) == 0
    }

    shouldClose: {
        raw.should_close(self.handle) != 0
    }

    setShouldClose: |value| {
        raw.set_should_close(self.handle, if value { 1 } else { 0 })
        self
    }

    poll: {
        raw.poll_events()
        self
    }

    framebufferSize: {
        let size = ffi.array(i32, 2).new()
        raw.framebuffer_size(self.handle, size.add(0), size.add(1))
        let result = {
            width: size.get(0),
            height: size.get(1),
        }
        size.free()
        result
    }

    windowSize: {
        let size = ffi.array(i32, 2).new()
        raw.window_size(self.handle, size.add(0), size.add(1))
        let result = {
            width: size.get(0),
            height: size.get(1),
        }
        size.free()
        result
    }

    time: {
        raw.time()
    }

    cursor: {
        let position = ffi.array(f64, 2).new()
        raw.get_cursor_pos(self.handle, position.add(0), position.add(1))
        let result = {
            x: position.get(0),
            y: position.get(1),
        }
        position.free()
        result
    }

    cursorFramebuffer: {
        let position = self.cursor()
        framebuffer_coords(self.handle, position.x, position.y)
    }

    mouseButton: |button| {
        raw.get_mouse_button(self.handle, button) == Action.value(:press)
    }

    onKey: |callback| {
        let wrapped = ffi.callback(
            [Ptr, i32, i32, i32, i32],
            void,
            |handle, key, scancode, action, mods| {
                let key_name = Key.fromValue(key)
                if key_name == undefined {
                    key_name = key
                }
                callback(key_name, Action.fromValue(action), mods)
            }
        )
        self.keyCallback = wrapped
        raw.set_key_callback(self.handle, wrapped)
        self
    }

    onCursor: |callback| {
        let wrapped = ffi.callback([Ptr, f64, f64], void, |handle, x, y| {
            callback(x, y)
        })
        self.cursorCallback = wrapped
        raw.set_cursor_pos_callback(self.handle, wrapped)
        self
    }

    onCursorFramebuffer: |callback| {
        let window = self
        let wrapped = ffi.callback([Ptr, f64, f64], void, |handle, x, y| {
            let position = framebuffer_coords(handle, x, y)
            callback(position.x, position.y)
        })
        window.cursorCallback = wrapped
        raw.set_cursor_pos_callback(window.handle, wrapped)
        window
    }

    onMouseButton: |callback| {
        let wrapped = ffi.callback([Ptr, i32, i32, i32], void, |handle, button, action, mods| {
            callback(button, Action.fromValue(action), mods)
        })
        self.mouseCallback = wrapped
        raw.set_mouse_button_callback(self.handle, wrapped)
        self
    }

    makeContextCurrent: {
        raw.make_context_current(self.handle)
        self
    }

    swapBuffers: {
        raw.swap_buffers(self.handle)
        self
    }

    // Build the tgpu.Window desc for the current platform.
    // The caller must load the `vendor.tgpu` module first.
    tgpuWindow: {
        let tgpu = Modules.vendor.tgpu
        if tgpu == undefined {
            throw "vendor.tgpu is not loaded"
        }
        let result = tgpu.Window.new()
        match sys.name {
            "macos" => {
                result.kind = tgpu.WindowKind.appKit
                let ns_window = raw.glfwGetCocoaWindow(self.handle)
                // [ns_window contentView]
                let view = raw.objc_msgSend(ns_window, raw.sel_registerName("contentView"))
                result.window = view
            }
            "linux" => {
                result.kind = tgpu.WindowKind.xlib
                result.display = raw.glfwGetX11Display()
                result.window = raw.glfwGetX11Window(self.handle)
            }
            "windows" => {
                result.kind = tgpu.WindowKind.win32
                result.window = raw.glfwGetWin32Window(self.handle)
            }
            _ => {}
        }
        result
    }

    dispose: {
        if self.disposed {
            return 0
        }
        self.disposed = true
        self.keyCallback = null
        self.cursorCallback = null
        self.mouseCallback = null
        raw.destroy_window(self.handle)
        self.handle = null
        state.windows = state.windows - 1
        if state.windows == 0 {
            raw.terminate()
            state.initialized = false
        }
        0
    }
}

let Window = {
    traits*: WindowTraits
    handle: null
    disposed: false
    keyCallback: null
    cursorCallback: null
    mouseCallback: null
}

mod vendor.glfw {
    export WindowTraits = WindowTraits
    export Window = Window
    export ClientApi = ClientApi
    export Key = Key
    export Action = Action
    export raw = raw
}
