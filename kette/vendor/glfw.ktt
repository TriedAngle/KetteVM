// GLFW window bindings and tgpu.Window helpers.
// Load after sys.ktt and tgpu.ktt with KetteTools.evalFile.
// Provides the `glfw` module; raw bindings are `glfw.raw.<fn>`,
// `glfw.raw.lib`, and `glfw.raw.objc`.

use ffi
use os
use sys
use tgpu
let (void, i32, f64, CString) = ffi
let Ptr = ffi.pointer(void)

let glfw_path = if os.name == "macos" {
        "/opt/homebrew/lib/libglfw.dylib"
    } else if os.name == "windows" {
        "glfw3.dll"
    } else {
        "libglfw.so.3"
    }

let lib = ffi.library(glfw_path)

let glfwGetCocoaWindow = if os.name == "macos" {
        lib.fn("glfwGetCocoaWindow", [Ptr], Ptr)
    } else {
        null
    }

let glfwGetX11Display = if os.name == "linux" {
        lib.fn("glfwGetX11Display", [], Ptr)
    } else {
        null
    }

let glfwGetX11Window = if os.name == "linux" {
        lib.fn("glfwGetX11Window", [Ptr], Ptr)
    } else {
        null
    }

let glfwGetWin32Window = if os.name == "windows" {
        lib.fn("glfwGetWin32Window", [Ptr], Ptr)
    } else {
        null
    }

let objc = if os.name == "macos" {
        ffi.library("/usr/lib/libobjc.A.dylib")
    } else {
        null
    }

let sel_registerName = if os.name == "macos" {
        objc.fn("sel_registerName", [CString], Ptr)
    } else {
        null
    }

let objc_msgSend = if os.name == "macos" {
        objc.fn("objc_msgSend", [Ptr, Ptr], Ptr)
    } else {
        null
    }

let raw = {
    lib: lib,
    objc: objc,
    init: lib.fn("glfwInit", [], i32),
    terminate: lib.fn("glfwTerminate", [], void),
    window_hint: lib.fn("glfwWindowHint", [i32, i32], void),
    create_window: lib.fn("glfwCreateWindow", [i32, i32, CString, Ptr, Ptr], Ptr),
    destroy_window: lib.fn("glfwDestroyWindow", [Ptr], void),
    should_close: lib.fn("glfwWindowShouldClose", [Ptr], i32),
    poll_events: lib.fn("glfwPollEvents", [], void),
    framebuffer_size: lib.fn("glfwGetFramebufferSize", [Ptr, Ptr, Ptr], void),
    window_size: lib.fn("glfwGetWindowSize", [Ptr, Ptr, Ptr], void),
    time: lib.fn("glfwGetTime", [], f64),
    set_cursor_pos_callback: lib.fn("glfwSetCursorPosCallback", [Ptr, Ptr], void),
    set_mouse_button_callback: lib.fn("glfwSetMouseButtonCallback", [Ptr, Ptr], void),
    get_cursor_pos: lib.fn("glfwGetCursorPos", [Ptr, Ptr, Ptr], void),
    get_mouse_button: lib.fn("glfwGetMouseButton", [Ptr, i32], i32),
    set_key_callback: lib.fn("glfwSetKeyCallback", [Ptr, Ptr], void),
    set_should_close: lib.fn("glfwSetWindowShouldClose", [Ptr, i32], void),
    glfwGetCocoaWindow: glfwGetCocoaWindow,
    glfwGetX11Display: glfwGetX11Display,
    glfwGetX11Window: glfwGetX11Window,
    glfwGetWin32Window: glfwGetWin32Window,
    sel_registerName: sel_registerName,
    objc_msgSend: objc_msgSend,
}

mod glfw {
    export init = raw.init
    export terminate = raw.terminate
    export windowHint = raw.window_hint
    export createWindow = raw.create_window
    export destroyWindow = raw.destroy_window
    export shouldClose = raw.should_close
    export pollEvents = raw.poll_events
    export framebufferSize = raw.framebuffer_size
    export windowSize = raw.window_size
    export time = raw.time
    export setCursorPosCallback = raw.set_cursor_pos_callback
    export setMouseButtonCallback = raw.set_mouse_button_callback
    export getCursorPos = raw.get_cursor_pos
    export getMouseButton = raw.get_mouse_button
    export setKeyCallback = raw.set_key_callback
    export setShouldClose = raw.set_should_close

    export create = { |title, width, height|
        if raw.init() == 0 {
            print("glfwInit failed")
            sys.raw.exit(1)
        }
        // 139265 is GLFW_CLIENT_API, paired with GLFW_NO_API.
        raw.window_hint(139265, 0)
        let window = raw.create_window(width, height, title, null, null)
        if window == null {
            print("glfwCreateWindow failed")
            sys.raw.exit(1)
        }
        window
    }

    // Build the tgpu.Window desc for the current platform.
    export tgpuWindow = { |window|
        let result = tgpu.Window.new()
        if os.name == "macos" {
            result.kind = tgpu.WindowKind.APP_KIT
            let ns_window = raw.glfwGetCocoaWindow(window)
            // [ns_window contentView]
            let view = raw.objc_msgSend(ns_window, raw.sel_registerName("contentView"))
            result.window = view
        } else if os.name == "linux" {
            result.kind = tgpu.WindowKind.XLIB
            result.display = raw.glfwGetX11Display()
            result.window = raw.glfwGetX11Window(window)
        } else if os.name == "windows" {
            result.kind = tgpu.WindowKind.WIN32
            result.window = raw.glfwGetWin32Window(window)
        }
        result
    }

    export raw = raw
}
