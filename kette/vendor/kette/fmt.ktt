use kette

let K = kette.K
let INDENT = "    "

let indent = |depth| {
    Array(depth).fill(INDENT).join("")
}

let newlineCount = |text| {
    let count = 0
    let* visit = |i| {
        if i < text.length {
            if text[i] == "\n" {
                count = count + 1
            }
            visit(i + 1)
        } else if count == 0 and text.length > 0 {
            1
        } else {
            count
        }
    }
    visit(0)
}

let opens = |kind| {
    kind == K.LBrace or kind == K.LBracket or kind == K.LParen
}

let closes = |kind| {
    kind == K.RBrace or kind == K.RBracket or kind == K.RParen
}

let startsNewLine = |tree, index| {
    let token = tree.tokensFrom(index + 1).firstWhere(|token| {
        let kind = token.kind
        kind == K.Newline or !kette.isTrivia(kind)
    })
    token != null and token.kind == K.Newline
}

let kindOf = |name| {
    let kind = K[name]
    if kind == undefined {
        throw "unknown token kind: " + name
    }
    kind
}

let kindSet = |names| {
    let set = []
    names.forEach(|name| {
        set[kindOf(name)] = true
    })
    set
}

let operatorKinds = kindSet([
    "And", "Or", "EqEq", "NotEq",
    "Lt", "Gt", "LtEq", "GtEq",
    "LtLt", "GtGt",
    "Plus", "Minus", "Star", "Slash", "Percent",
])

let assignmentKinds = kindSet([
    "Assign", "PlusEq", "MinusEq", "StarEq", "SlashEq", "PercentEq",
    "AndEq", "OrEq", "LtLtEq", "GtGtEq",
])

let wordKinds = kindSet([
    "Ident", "Number", "String", "QuotedName",
    "True", "False", "Null", "SelfKw",
    "Let", "LetStar", "Mod", "If", "Else", "While", "For", "In",
    "Return", "Break", "As", "Try", "Catch", "Throw",
    "SelfContext",
])

let isOperator = |kind, parent| {
    parent != K.Slot and operatorKinds[kind] == true
}

let isAssignment = |kind| {
    assignmentKinds[kind] == true
}

let isWord = |kind| {
    wordKinds[kind] == true
}

let spaceBetween = |prev, cur, prevParent, curParent, prevPipeOpening, curPipeOpening| {
    if prev == K.Period or cur == K.Period {
        return false
    }
    if cur == K.RParen or cur == K.RBracket {
        return false
    }
    if cur == K.RBrace {
        return prev != K.LBrace
    }
    if prev == K.LParen or prev == K.LBracket {
        return false
    }
    if cur == K.Comma or cur == K.Semicolon {
        return false
    }
    if prev == K.Comma or prev == K.Semicolon {
        return true
    }

    if cur == K.Colon and (curParent == K.Slot or curParent == K.SlotMulti) {
        return false
    }
    if prev == K.Colon and (prevParent == K.Slot or prevParent == K.SlotMulti) {
        return true
    }
    if cur == K.Star and curParent == K.Slot {
        return false
    }
    if prev == K.Star and prevParent == K.Slot {
        return false
    }
    if (cur == K.GtGt or cur == K.LtLt) and curParent == K.Slot {
        return false
    }
    if (prev == K.GtGt or prev == K.LtLt) and prevParent == K.Slot {
        return false
    }

    if cur == K.Pipe and curParent == K.ParamList {
        if !curPipeOpening {
            return false
        }
        return true
    }
    if prev == K.Pipe and prevParent == K.ParamList and prevPipeOpening {
        return false
    }

    if cur == K.LParen and curParent == K.ArgList {
        return false
    }
    if cur == K.LBracket and curParent == K.Index {
        return false
    }

    if prev == K.Ellipsis {
        return false
    }

    if prev == K.Minus or prev == K.Bang {
        if prevParent == K.Unary {
            return false
        }
    }

    if isOperator(prev, prevParent) or isOperator(cur, curParent) {
        return true
    }
    if isAssignment(prev) or isAssignment(cur) {
        return true
    }

    if cur == K.LBrace {
        return true
    }
    if prev == K.LBrace {
        return true
    }
    if prev == K.RBrace {
        if cur == K.Else or cur == K.Catch {
            return true
        }
    }

    if isWord(prev) or isWord(cur) {
        return true
    }
    false
}

let format = |tree| {
    let pieces = []
    let depth = 0
    let stack = []
    let pending = 0
    let prev = null
    let prevPipeOpening = false

    tree.tokens.forEach(|token| {
        let kind = token.kind

        if kind == K.Whitespace {
        } else if kind == K.Newline {
            pending = pending + newlineCount(token.text)
            if pending > 2 {
                pending = 2
            }
        } else if kette.isTrivia(kind) {
            if pending > 0 {
                if pieces.length > 0 {
                    pieces.push("\n")
                    if pending > 1 {
                        pieces.push("\n")
                    }
                    pieces.push(indent(depth))
                }
            } else if pieces.length > 0 {
                pieces.push(" ")
            }
            pieces.push(token.text)
            pending = 0
        } else {
            let parent = token.parent
            let curPipeOpening = false
            if kind == K.Pipe and parent == K.ParamList {
                curPipeOpening = token.start == tree.nodeStart(token.parentId)
            }

            if pieces.length > 0 {
                if pending > 0 {
                    pieces.push("\n")
                    if pending > 1 {
                        pieces.push("\n")
                    }
                    let lineDepth = depth
                    if closes(kind) and stack.length > 0 and stack[stack.length - 1] {
                        lineDepth = lineDepth - 1
                    }
                    if prev != null and (isOperator(prev.kind, prev.parent) or isAssignment(prev.kind)) {
                        lineDepth = lineDepth + 1
                    }
                    pieces.push(indent(lineDepth))
                } else if prev != null {
                    if spaceBetween(prev.kind, kind, prev.parent, parent, prevPipeOpening, curPipeOpening) {
                        pieces.push(" ")
                    }
                }
            }

            pieces.push(token.text)
            pending = 0

            if opens(kind) {
                let indenting = true
                if kind == K.LParen {
                    indenting = startsNewLine(tree, token.index)
                }
                stack.push(indenting)
                if indenting {
                    depth = depth + 1
                }
            }
            if closes(kind) and stack.length > 0 {
                let indenting = stack.pop()
                if indenting and depth > 0 {
                    depth = depth - 1
                }
            }

            prev = token
            prevPipeOpening = curPipeOpening
        }
    })

    if pieces.length == 0 {
        return ""
    }
    pieces.push("\n")
    pieces.join("")
}

let formatSource = |source| {
    with(kette.parse(source), |tree| {
        if tree.errorCount > 0 {
            throw "parse error: " + tree.errorMessage(0)
        }
        format(tree)
    })
}

mod kette.fmt {
    export format = format
    export formatSource = formatSource
}
