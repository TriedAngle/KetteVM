    swapchain_begin_frame: lib.fn("tgpu_swapchain_begin_frame", [Ptr, Ptr, Ptr], i32),
    swapchain_end_frame: lib.fn("tgpu_swapchain_end_frame", [Ptr, Ptr, Frame, Ptr, u64], i32),
    swapchain_view: lib.fn("tgpu_swapchain_view", [Ptr, Frame], ImageView),
    swapchain_set_extent: lib.fn("tgpu_swapchain_set_extent", [Ptr, Extent2D], void),
    swapchain_recreate: lib.fn("tgpu_swapchain_recreate", [Ptr], i32),
    buffer_create: lib.fn("tgpu_device_create_buffer", [Ptr, Ptr, Ptr, u64], Ptr),
    buffer_destroy: lib.fn("tgpu_buffer_destroy", [Ptr], void),
    view_image_create: lib.fn("tgpu_device_create_view_image", [Ptr, Ptr], Ptr),
    view_image_destroy: lib.fn("tgpu_view_image_destroy", [Ptr], void),
    view_image_image: lib.fn("tgpu_view_image_image", [Ptr], Image),
    view_image_view: lib.fn("tgpu_view_image_view", [Ptr], ImageView),
    view_image_sampler: lib.fn("tgpu_view_image_sampler", [Ptr], Sampler),
    bindless_create: lib.fn("tgpu_device_create_bindless", [Ptr, Ptr], Ptr),
    bindless_destroy: lib.fn("tgpu_bindless_destroy", [Ptr], void),
    bindless_add_rw_buffer: lib.fn("tgpu_bindless_add_rw_buffer", [Ptr, Ptr], u32),
    bindless_add_storage_image: lib.fn("tgpu_bindless_add_storage_image", [Ptr, ImageView, i32], u32),
    bindless_add_sampled_image: lib.fn("tgpu_bindless_add_sampled_image", [Ptr, ImageView, i32], u32),
    bindless_add_sampler: lib.fn("tgpu_bindless_add_sampler", [Ptr, Sampler], u32),
    bindless_update_storage_image: lib.fn("tgpu_bindless_update_storage_image", [Ptr, u32, ImageView, i32], i32),
    bindless_update_sampled_image: lib.fn("tgpu_bindless_update_sampled_image", [Ptr, u32, ImageView, i32], i32),
    bindless_update_sampler: lib.fn("tgpu_bindless_update_sampler", [Ptr, u32, Sampler], i32),
    shader_create: lib.fn("tgpu_device_create_shader", [Ptr, CString, Ptr, u64], Ptr),
    shader_create_slang: lib.fn("tgpu_device_create_shader_slang", [Ptr, CString, Ptr, u64], Ptr),
    shader_destroy: lib.fn("tgpu_shader_destroy", [Ptr], void),
    compute_pipeline_create: lib.fn("tgpu_device_create_compute_pipeline", [Ptr, Ptr], Ptr),
    compute_pipeline_destroy: lib.fn("tgpu_compute_pipeline_destroy", [Ptr], void),
    render_pipeline_create: lib.fn("tgpu_device_create_render_pipeline", [Ptr, Ptr], Ptr),
    render_pipeline_destroy: lib.fn("tgpu_render_pipeline_destroy", [Ptr], void),
    recorder_begin: lib.fn("tgpu_queue_begin_commands", [Ptr], Ptr),
    recorder_transition_image: lib.fn("tgpu_recorder_transition_image", [Ptr, Image, i32], i32),
    recorder_transition_frame: lib.fn("tgpu_recorder_transition_frame", [Ptr, Ptr, Frame, i32], i32),
    recorder_bind_compute: lib.fn("tgpu_recorder_bind_compute", [Ptr, Ptr, Ptr, Ptr, u64], i32),
    recorder_dispatch: lib.fn("tgpu_recorder_dispatch", [Ptr, u32, u32, u32], i32),
    recorder_bind_render: lib.fn("tgpu_recorder_bind_render", [Ptr, Ptr, Ptr, Ptr, u64], i32),
    recorder_begin_render: lib.fn("tgpu_recorder_begin_render", [Ptr, Ptr], i32),
    recorder_draw: lib.fn("tgpu_recorder_draw", [Ptr, u32, u32, u32, u32], i32),
    recorder_draw_indexed: lib.fn("tgpu_recorder_draw_indexed", [Ptr, u32, u32, i32, u32, u32], i32),
    recorder_bind_vertex: lib.fn("tgpu_recorder_bind_vertex_buffer", [Ptr, u32, Ptr, u64], i32),
    recorder_update_buffer: lib.fn("tgpu_recorder_update_buffer", [Ptr, Ptr, u64, Ptr, u64], i32),
    recorder_buffer_transition: lib.fn("tgpu_recorder_buffer_transition", [Ptr, Ptr, i32, i32], i32),
    recorder_copy_buffer_to_image: lib.fn("tgpu_recorder_copy_buffer_to_image", [Ptr, Ptr, Image, i32, Ptr], i32),
    recorder_copy_image_to_buffer: lib.fn("tgpu_recorder_copy_image_to_buffer", [Ptr, Image, i32, Ptr, Ptr], i32),
    buffer_write: lib.fn("tgpu_buffer_write", [Ptr, u64, Ptr, u64], i32),
    buffer_read: lib.fn("tgpu_buffer_read", [Ptr, u64, Ptr, u64], i32),
    texture_create: lib.fn("tgpu_queue_create_texture_2d", [Ptr, Ptr, Ptr, Ptr, u64], Ptr),
    bindless_add_read: lib.fn("tgpu_bindless_add_read_buffer", [Ptr, Ptr], u32),
    bindless_add_uniform: lib.fn("tgpu_bindless_add_uniform_buffer", [Ptr, Ptr, u64], u32),
    swapchain_set_present: lib.fn("tgpu_swapchain_set_present_mode", [Ptr, i32], void),
    queue_submit: lib.fn("tgpu_queue_submit", [Ptr, Ptr, u64, Ptr], i32),
    queue_wait: lib.fn("tgpu_queue_wait", [Ptr, u64], i32),
    recorder_end_render: lib.fn("tgpu_recorder_end_render", [Ptr], i32),
    recorder_finish: lib.fn("tgpu_recorder_finish", [Ptr], Ptr),
    command_buffer_destroy: lib.fn("tgpu_command_buffer_destroy", [Ptr], void),
    last_error: lib.fn("tgpu_last_error", [Ptr, u64], i32),
}

let record_status = { |status, what|
    if status != 0 and pending.error == null {
        raw.last_error(error_buffer, 512)
        pending.error = {
            status: status,
            what: what,
            message: ffi.string_at(error_buffer)
        }
    }
}
let record_last = { |what|
    let status = raw.last_error(error_buffer, 512)
    if status != 0 and pending.error == null {
        pending.error = {
            status: status,
            what: what,
            message: ffi.string_at(error_buffer)
        }
    }
}
let record_handle = { |value, what|
    if value == invalid_handle {
        record_last(what)
    }
    value
}


mod vendor.tgpu {
    export INVALID_HANDLE = invalid_handle
    export raw = raw
    export ImageView = ImageView
    export Image = Image
    export Sampler = Sampler
    export Window = Window
    export SwapchainDesc = SwapchainDesc
    export BufferDesc = BufferDesc
    export SamplerDesc = SamplerDesc
    export ImageDesc = ImageDesc
    export ViewImageDesc = ViewImageDesc
    export BindlessDesc = BindlessDesc
    export ComputePipelineDesc = ComputePipelineDesc
    export VertexAttribute = VertexAttribute
    export VertexBufferLayout = VertexBufferLayout
    export BufferImageCopy = BufferImageCopy
    export RenderPipelineDesc = RenderPipelineDesc
    export ColorAttachment = ColorAttachment
    export RenderDesc = RenderDesc
    export Frame = Frame
    export Extent2D = Extent2D
    export PushConstants = PushConstants
    export WindowKind = {
        APP_KIT: 1,
        XLIB: 2,
        WIN32: 3,
    }
    export PresentMode = {
        FIFO: 0,
    }
    export MemoryPreset = {
        GPU_ONLY: 0,
        UPLOAD: 1,
        READBACK: 2,
        DYNAMIC: 3,
        TRANSIENT_ATTACHMENT: 4,
    }
    export HostAccess = {
        NONE: 0,
        WRITE_SEQUENTIAL: 1,
        READ_RANDOM: 2,
        READ_WRITE_RANDOM: 3,
    }
    export BufferUsage = {
        COPY_SRC: 1,
        COPY_DST: 2,
        VERTEX: 8,
        STORAGE: 32,
    }
    export ImageUsage = {
        COPY_SRC: 1,
        COPY_DST: 2,
        SAMPLED: 4,
        STORAGE: 8,
        COLOR_ATTACHMENT: 16,
    }
    export ImageLayout = {
        UNDEFINED: 0,
        GENERAL: 1,
        COMPUTE: 2,
        FRAGMENT: 3,
        COLOR: 4,
        DEPTH_STENCIL: 5,
        TRANSFER_DST: 6,
        PRESENT: 7,
    }
    export LoadOp = {
        LOAD: 0,
        CLEAR: 1,
        DONT_CARE: 2,
    }
    export StoreOp = {
        STORE: 0,
    }
    export Filter = {
        LINEAR: 1,
    }
    export SamplerMipmapMode = {
        LINEAR: 1,
    }
    export SamplerAddressMode = {
        CLAMP_TO_EDGE: 2,
    }
    export Format = {
        UNDEFINED: 0,
    }
    export CullMode = {
        BACK: 2,
    }
    export FrontFace = {
        COUNTER_CLOCKWISE: 0,
    }
    export Topology = {
        TRIANGLE_LIST: 0,
    }
    export Blend = {
        DISABLED: 0,
        ALPHA: 1,
    }
    export VertexInputRate = {
        VERTEX: 0,
        INSTANCE: 1,
    }
    // Stops at the first recorded error. Swap this for `throw` once
    // Kette has exceptions.
    export check = {
        if pending.error != null {
            print("tgpu error:")
            print(pending.error.what)
            print(pending.error.message)
            sys.raw.exit(1)
        }
    }
    export instanceCreate = { |desc|
        let value = raw.instance_create(desc)
        record_last("tgpu_instance_create")
        value
    }
    export instanceDestroy = raw.instance_destroy
    export deviceCreate = { |instance, desc, queues, capacity|
        let value = raw.device_create(instance, desc, queues, capacity)
        record_last("tgpu_device_create")
        value
    }
    export deviceDestroy = raw.device_destroy
    export deviceWaitIdle = raw.device_wait_idle
    export queueDestroy = raw.queue_destroy
    export swapchainCreate = { |device, desc|
        let value = raw.swapchain_create(device, desc)
        record_last("tgpu_device_create_swapchain")
        value
    }
    export swapchainDestroy = raw.swapchain_destroy
    export swapchainExtent = { |swapchain, out|
        record_status(raw.swapchain_extent(swapchain, out), "tgpu_swapchain_extent")
    }
    export swapchainFormat = raw.swapchain_format
    export swapchainBeginFrame = { |queue, swapchain, out|
        record_status(
            raw.swapchain_begin_frame(queue, swapchain, out),
            "tgpu_swapchain_begin_frame"
        )
    }
    export swapchainEndFrame = { |queue, swapchain, frame, records, count|
        record_status(
            raw.swapchain_end_frame(queue, swapchain, frame, records, count),
            "tgpu_swapchain_end_frame"
        )
    }
    export swapchainView = raw.swapchain_view
    export swapchainSetExtent = raw.swapchain_set_extent
    export swapchainRecreate = { |swapchain|
        record_status(raw.swapchain_recreate(swapchain), "tgpu_swapchain_recreate")
    }
    export bufferCreate = { |device, desc, data, len|
        let value = raw.buffer_create(device, desc, data, len)
        record_last("tgpu_device_create_buffer")
        value
    }
    export bufferDestroy = raw.buffer_destroy
    export viewImageCreate = { |device, desc|
        let value = raw.view_image_create(device, desc)
        record_last("tgpu_device_create_view_image")
        value
    }
    export viewImageDestroy = raw.view_image_destroy
    export viewImageImage = raw.view_image_image
    export viewImageView = raw.view_image_view
    export viewImageSampler = raw.view_image_sampler
    export bindlessCreate = { |device, desc|
        let value = raw.bindless_create(device, desc)
        record_last("tgpu_device_create_bindless")
        value
    }
    export bindlessDestroy = raw.bindless_destroy
    export bindlessAddRwBuffer = { |heap, buffer|
        record_handle(
            raw.bindless_add_rw_buffer(heap, buffer),
            "tgpu_bindless_add_rw_buffer"
        )
    }
    export bindlessAddStorageImage = { |heap, view, layout|
        record_handle(
            raw.bindless_add_storage_image(heap, view, layout),
            "tgpu_bindless_add_storage_image"
        )
    }
    export bindlessAddSampledImage = { |heap, view, layout|
        record_handle(
            raw.bindless_add_sampled_image(heap, view, layout),
            "tgpu_bindless_add_sampled_image"
        )
    }
    export bindlessAddSampler = { |heap, sampler_value|
        record_handle(
            raw.bindless_add_sampler(heap, sampler_value),
            "tgpu_bindless_add_sampler"
        )
    }
    export bindlessUpdateStorageImage = { |heap, handle, view, layout|
        record_status(
            raw.bindless_update_storage_image(heap, handle, view, layout),
            "tgpu_bindless_update_storage_image"
        )
    }
    export bindlessUpdateSampledImage = { |heap, handle, view, layout|
        record_status(
            raw.bindless_update_sampled_image(heap, handle, view, layout),
            "tgpu_bindless_update_sampled_image"
        )
    }
    export bindlessUpdateSampler = { |heap, handle, sampler_value|
        record_status(
            raw.bindless_update_sampler(heap, handle, sampler_value),
            "tgpu_bindless_update_sampler"
        )
    }
    export loadSpirv = { |path|
        if sys.raw.access(path, 0) != 0 {
            print("cannot open shader:")
            print(path)
            sys.raw.exit(1)
        }
        let file = sys.raw.fopen(path, "rb")
        sys.raw.fseek(file, 0, 2)
        let size = sys.raw.ftell(file)
        sys.raw.fseek(file, 0, 0)
        if size <= 0 or size % 4 != 0 {
            print("not a SPIR-V file:")
            print(path)
            sys.raw.exit(1)
        }
        let bytes = ffi.array(u8, size).new()
        let read = sys.raw.fread(bytes, 1, size, file)
        sys.raw.fclose(file)
        if read != size {
            print("cannot read shader:")
            print(path)
            sys.raw.exit(1)
        }
        { data: bytes, size: size }
    }
    export shaderCreate = { |device, label, words, count|
        let value = raw.shader_create(device, label, words, count)
        record_last("tgpu_device_create_shader")
        value
    }
    export loadSlang = { |device, path|
        if sys.raw.access(path, 0) != 0 {
            print("cannot open shader:")
            print(path)
            sys.raw.exit(1)
        }
        let file = sys.raw.fopen(path, "rb")
        sys.raw.fseek(file, 0, 2)
        let size = sys.raw.ftell(file)
        sys.raw.fseek(file, 0, 0)
        if size <= 0 {
            print("empty shader:")
            print(path)
            sys.raw.exit(1)
        }
        let bytes = ffi.array(u8, size + 1).new()
        let read = sys.raw.fread(bytes, 1, size, file)
        sys.raw.fclose(file)
        if read != size {
            print("cannot read shader:")
            print(path)
            sys.raw.exit(1)
        }
        bytes.set(size, 0)
        let value = raw.shader_create_slang(device, path, bytes, size)
        record_last("tgpu_device_create_shader_slang")
        bytes.free()
        value
    }
    export shaderCreateSlang = { |device, label, source, len|
        let value = raw.shader_create_slang(device, label, source, len)
        record_last("tgpu_device_create_shader_slang")
        value
    }
    export shaderDestroy = raw.shader_destroy
    export computePipelineCreate = { |device, desc|
        let value = raw.compute_pipeline_create(device, desc)
        record_last("tgpu_device_create_compute_pipeline")
        value
    }
    export computePipelineDestroy = raw.compute_pipeline_destroy
    export renderPipelineCreate = { |device, desc|
        let value = raw.render_pipeline_create(device, desc)
        record_last("tgpu_device_create_render_pipeline")
        value
    }
    export renderPipelineDestroy = raw.render_pipeline_destroy
    export recorderBegin = { |queue|
        let value = raw.recorder_begin(queue)
        record_last("tgpu_queue_begin_commands")
        value
    }
    export recorderTransitionImage = { |recorder, image, layout|
        record_status(
            raw.recorder_transition_image(recorder, image, layout),
            "tgpu_recorder_transition_image"
