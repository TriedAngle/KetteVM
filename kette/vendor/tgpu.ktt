        )
    }
    export recorderTransitionFrame = { |recorder, swapchain, frame, layout|
        ensureStatus(
            raw.recorder_transition_frame(recorder, swapchain, frame, layout),
            "tgpu_recorder_transition_frame"
        )
    }
    export recorderBindCompute = { |recorder, pipeline, heap, push, len|
        ensureStatus(
            raw.recorder_bind_compute(recorder, pipeline, heap, push, len),
            "tgpu_recorder_bind_compute"
        )
    }
    export recorderDispatch = { |recorder, x, y, z|
        ensureStatus(
