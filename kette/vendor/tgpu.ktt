use ffi
use sys
let { Ptr, struct, void, bool, i32, u32, f32, u8, u64, CString, ... } = ffi

let tgpu_path = match sys.name {
    "macos" => "libtgpu.dylib"
    "windows" => "tgpu.dll"
    _ => "libtgpu.so"
}

let lib = sys.lib(tgpu_path)

let WindowKind = ffi.enum({
    appKit: 1,
    xlib: 2,
    win32: 3,
})
let PresentMode = ffi.enum({
    fifo: 0,
})
let MemoryPreset = ffi.enum({
    gpuOnly: 0,
    upload: 1,
    readback: 2,
    dynamic: 3,
    transientAttachment: 4,
})
let HostAccess = ffi.enum({
    none: 0,
    writeSequential: 1,
    readRandom: 2,
    readWriteRandom: 3,
})
let BufferUsage = {
    copySrc: 1,
    copyDst: 2,
    vertex: 8,
    storage: 32,
}
let ImageUsage = {
    copySrc: 1,
    copyDst: 2,
    sampled: 4,
    storage: 8,
    colorAttachment: 16,
}
let ImageLayout = ffi.enum({
    undefined: 0,
    general: 1,
    compute: 2,
    fragment: 3,
    color: 4,
    depthStencil: 5,
    transferDst: 6,
    present: 7,
})
let LoadOp = ffi.enum({
    load: 0,
    clear: 1,
    dontCare: 2,
})
let StoreOp = ffi.enum({
    store: 0,
})
let Filter = ffi.enum({
    linear: 1,
})
let SamplerMipmapMode = ffi.enum({
    linear: 1,
})
let SamplerAddressMode = ffi.enum({
    clampToEdge: 2,
})
let Format = ffi.enum({
    undefined: 0,
})
let CompareOp = ffi.enum({
    never: 0,
    less: 1,
    equal: 2,
    lessOrEqual: 3,
    greater: 4,
    notEqual: 5,
    greaterOrEqual: 6,
    always: 7,
})
let CullMode = ffi.enum({
    none: 0,
    front: 1,
    back: 2,
    frontAndBack: 3,
})
let FrontFace = ffi.enum({
    counterClockwise: 0,
})
let Topology = ffi.enum({
    triangleList: 0,
})
let Blend = ffi.enum({
    disabled: 0,
    alpha: 1,
})
let VertexInputRate = ffi.enum({
    vertex: 0,
    instance: 1,
})

let error_buffer = ffi.array(u8, 512).new()
let invalid_handle = 4294967295
let ImageView = struct({
    handle: Ptr,
})
let Image = struct({
    handle: Ptr,
})
let Sampler = struct({
    handle: Ptr,
})
let Window = struct({
    kind: WindowKind.type,
    display: Ptr,
    window: Ptr,
})
let SwapchainDesc = struct({
    struct_size: u64,
    window: Window,
    width: u32,
    height: u32,
    image_count: u32,
    present_mode: PresentMode.type,
})
let BufferDesc = struct({
    struct_size: u64,
    label: CString,
    size: u64,
    usage: u32,
    memory: MemoryPreset.type,
    host_access: HostAccess.type,
})
let SamplerDesc = struct({
    struct_size: u64,
    label: CString,
    mag: Filter.type,
    min: Filter.type,
    mipmap: SamplerMipmapMode.type,
    address_u: SamplerAddressMode.type,
    address_v: SamplerAddressMode.type,
    address_w: SamplerAddressMode.type,
    anisotropy: f32,
    min_lod: f32,
    max_lod: f32,
})
let ImageDesc = struct({
    struct_size: u64,
    label: CString,
    format: Format.type,
    width: u32,
    height: u32,
    depth: u32,
    mip_levels: u32,
    array_layers: u32,
    usage: u32,
    memory: MemoryPreset.type,
    host_access: HostAccess.type,
    initial_layout: ImageLayout.type,
})
let ViewImageDesc = struct({
    struct_size: u64,
    image: ImageDesc,
    sampler: Ptr,
})
let BindlessDesc = struct({
    struct_size: u64,
    max_read_buffers: u32,
    max_rw_buffers: u32,
    max_sampled_images: u32,
    max_storage_images: u32,
    max_samplers: u32,
    max_uniform_buffers: u32,
})
let ComputePipelineDesc = struct({
    struct_size: u64,
    label: CString,
    shader: Ptr,
    entry: CString,
    bindless: Ptr,
    push_constant_size: u32,
})
let VertexAttribute = struct({
    location: u32,
    binding: u32,
    format: Format.type,
    offset: u32,
})
let VertexBufferLayout = struct({
    binding: u32,
    stride: u32,
    input_rate: VertexInputRate.type,
    attributes: Ptr,
    attribute_count: u64,
})
let BufferImageCopy = struct({
    buffer_offset: u64,
    buffer_row_length: u32,
    buffer_image_height: u32,
    x: i32,
    y: i32,
    z: i32,
    width: u32,
    height: u32,
    depth: u32,
})
let RenderPipelineDesc = struct({
    struct_size: u64,
    label: CString,
    vertex_shader: Ptr,
    vertex_entry: CString,
    fragment_shader: Ptr,
    fragment_entry: CString,
    color_formats: Ptr,
    color_format_count: u64,
    depth_format: Format.type,
    depth_test: bool,
    depth_write: bool,
    depth_compare: CompareOp.type,
    bindless: Ptr,
    push_constant_size: u32,
    cull: CullMode.type,
    front_face: FrontFace.type,
    topology: Topology.type,
    blend: Blend.type,
    vertex_buffers: Ptr,
    vertex_buffer_count: u64,
    sample_count: u32,
})
let ColorAttachment = struct({
    view: ImageView,
    layout: ImageLayout.type,
    load: LoadOp.type,
    store: StoreOp.type,
    clear_color: ffi.array(f32, 4),
})
let RenderDesc = struct({
    struct_size: u64,
    x: i32,
    y: i32,
    width: u32,
    height: u32,
    colors: Ptr,
    color_count: u64,
    depth: Ptr,
    stencil: Ptr,
})
let Frame = struct({
    index: u32,
    flight_index: u64,
    suboptimal: bool,
    out_of_date: bool,
})
let Extent2D = struct({
    width: u32,
    height: u32,
})
let Point2 = struct({
    x: f32,
    y: f32,
})
// Must match the Slang PushData layout.
let PushConstants = struct({
    output_image: u32,
    particles: u32,
    present_texture: u32,
    present_sampler: u32,
    window: Extent2D,
    mouse: Point2,
    dt: f32,
    pad: f32,
})

let raw = {
    lib: lib,
    instance_create: lib.fn("tgpu_instance_create", [Ptr], Ptr),
    instance_destroy: lib.fn("tgpu_instance_destroy", [Ptr], void),
    device_create: lib.fn("tgpu_device_create", [Ptr, Ptr, Ptr, u64], Ptr),
    device_destroy: lib.fn("tgpu_device_destroy", [Ptr], void),
    device_wait_idle: lib.fn("tgpu_device_wait_idle", [Ptr], void),
    queue_destroy: lib.fn("tgpu_queue_destroy", [Ptr], void),
    swapchain_create: lib.fn("tgpu_device_create_swapchain", [Ptr, Ptr], Ptr),
    swapchain_destroy: lib.fn("tgpu_swapchain_destroy", [Ptr], void),
    swapchain_extent: lib.fn("tgpu_swapchain_extent", [Ptr, Ptr], i32),
    swapchain_format: lib.fn("tgpu_swapchain_format", [Ptr], i32),
    swapchain_begin_frame: lib.fn("tgpu_swapchain_begin_frame", [Ptr, Ptr, Ptr], i32),
    swapchain_end_frame: lib.fn("tgpu_swapchain_end_frame", [Ptr, Ptr, Frame, Ptr, u64], i32),
    swapchain_view: lib.fn("tgpu_swapchain_view", [Ptr, Frame], ImageView),
    swapchain_set_extent: lib.fn("tgpu_swapchain_set_extent", [Ptr, Extent2D], void),
    swapchain_recreate: lib.fn("tgpu_swapchain_recreate", [Ptr], i32),
    buffer_create: lib.fn("tgpu_device_create_buffer", [Ptr, Ptr, Ptr, u64], Ptr),
    buffer_destroy: lib.fn("tgpu_buffer_destroy", [Ptr], void),
    view_image_create: lib.fn("tgpu_device_create_view_image", [Ptr, Ptr], Ptr),
    view_image_destroy: lib.fn("tgpu_view_image_destroy", [Ptr], void),
    view_image_image: lib.fn("tgpu_view_image_image", [Ptr], Image),
    view_image_view: lib.fn("tgpu_view_image_view", [Ptr], ImageView),
    view_image_sampler: lib.fn("tgpu_view_image_sampler", [Ptr], Sampler),
    bindless_create: lib.fn("tgpu_device_create_bindless", [Ptr, Ptr], Ptr),
    bindless_destroy: lib.fn("tgpu_bindless_destroy", [Ptr], void),
    bindless_add_rw_buffer: lib.fn("tgpu_bindless_add_rw_buffer", [Ptr, Ptr], u32),
    bindless_add_storage_image: lib.fn("tgpu_bindless_add_storage_image", [Ptr, ImageView, ImageLayout.type], u32),
    bindless_add_sampled_image: lib.fn("tgpu_bindless_add_sampled_image", [Ptr, ImageView, ImageLayout.type], u32),
    bindless_add_sampler: lib.fn("tgpu_bindless_add_sampler", [Ptr, Sampler], u32),
    bindless_update_storage_image: lib.fn("tgpu_bindless_update_storage_image", [Ptr, u32, ImageView, ImageLayout.type], i32),
    bindless_update_sampled_image: lib.fn("tgpu_bindless_update_sampled_image", [Ptr, u32, ImageView, ImageLayout.type], i32),
    bindless_update_sampler: lib.fn("tgpu_bindless_update_sampler", [Ptr, u32, Sampler], i32),
    shader_create: lib.fn("tgpu_device_create_shader", [Ptr, CString, Ptr, u64], Ptr),
    shader_create_slang: lib.fn("tgpu_device_create_shader_slang", [Ptr, CString, Ptr, u64], Ptr),
    shader_destroy: lib.fn("tgpu_shader_destroy", [Ptr], void),
    compute_pipeline_create: lib.fn("tgpu_device_create_compute_pipeline", [Ptr, Ptr], Ptr),
    compute_pipeline_destroy: lib.fn("tgpu_compute_pipeline_destroy", [Ptr], void),
    render_pipeline_create: lib.fn("tgpu_device_create_render_pipeline", [Ptr, Ptr], Ptr),
    render_pipeline_destroy: lib.fn("tgpu_render_pipeline_destroy", [Ptr], void),
    recorder_begin: lib.fn("tgpu_queue_begin_commands", [Ptr], Ptr),
    recorder_transition_image: lib.fn("tgpu_recorder_transition_image", [Ptr, Image, ImageLayout.type], i32),
    recorder_transition_frame: lib.fn("tgpu_recorder_transition_frame", [Ptr, Ptr, Frame, ImageLayout.type], i32),
    recorder_bind_compute: lib.fn("tgpu_recorder_bind_compute", [Ptr, Ptr, Ptr, Ptr, u64], i32),
    recorder_dispatch: lib.fn("tgpu_recorder_dispatch", [Ptr, u32, u32, u32], i32),
    recorder_bind_render: lib.fn("tgpu_recorder_bind_render", [Ptr, Ptr, Ptr, Ptr, u64], i32),
    recorder_begin_render: lib.fn("tgpu_recorder_begin_render", [Ptr, Ptr], i32),
    recorder_draw: lib.fn("tgpu_recorder_draw", [Ptr, u32, u32, u32, u32], i32),
    recorder_draw_indexed: lib.fn("tgpu_recorder_draw_indexed", [Ptr, u32, u32, i32, u32, u32], i32),
    recorder_bind_vertex: lib.fn("tgpu_recorder_bind_vertex_buffer", [Ptr, u32, Ptr, u64], i32),
    recorder_update_buffer: lib.fn("tgpu_recorder_update_buffer", [Ptr, Ptr, u64, Ptr, u64], i32),
    recorder_buffer_transition: lib.fn("tgpu_recorder_buffer_transition", [Ptr, Ptr, i32, i32], i32),
    recorder_copy_buffer_to_image: lib.fn("tgpu_recorder_copy_buffer_to_image", [Ptr, Ptr, Image, ImageLayout.type, Ptr], i32),
    recorder_copy_image_to_buffer: lib.fn("tgpu_recorder_copy_image_to_buffer", [Ptr, Image, ImageLayout.type, Ptr, Ptr], i32),
    buffer_write: lib.fn("tgpu_buffer_write", [Ptr, u64, Ptr, u64], i32),
    buffer_read: lib.fn("tgpu_buffer_read", [Ptr, u64, Ptr, u64], i32),
    texture_create: lib.fn("tgpu_queue_create_texture_2d", [Ptr, Ptr, Ptr, Ptr, u64], Ptr),
    bindless_add_read: lib.fn("tgpu_bindless_add_read_buffer", [Ptr, Ptr], u32),
    bindless_add_uniform: lib.fn("tgpu_bindless_add_uniform_buffer", [Ptr, Ptr, u64], u32),
    swapchain_set_present: lib.fn("tgpu_swapchain_set_present_mode", [Ptr, PresentMode.type], void),
    queue_submit: lib.fn("tgpu_queue_submit", [Ptr, Ptr, u64, Ptr], i32),
    queue_wait: lib.fn("tgpu_queue_wait", [Ptr, u64], i32),
    recorder_end_render: lib.fn("tgpu_recorder_end_render", [Ptr], i32),
    recorder_finish: lib.fn("tgpu_recorder_finish", [Ptr], Ptr),
    command_buffer_destroy: lib.fn("tgpu_command_buffer_destroy", [Ptr], void),
    last_error: lib.fn("tgpu_last_error", [Ptr, u64], i32),
}

let fail = { |what|
    throw what + ": " + ffi.string_at(error_buffer)
}
let ensureStatus = { |status, what|
    if status != 0 {
        raw.last_error(error_buffer, 512)
        fail(what)
    }
}
let ensureLast = { |what|
    if raw.last_error(error_buffer, 512) != 0 {
        fail(what)
    }
}
let ensureHandle = { |value, what|
    if value == invalid_handle {
        ensureLast(what)
    }
    value
}

let loadSpirv = { |path|
    if sys.raw.access(path, 0) != 0 {
        throw "cannot open shader: " + path
    }
    let file = sys.raw.fopen(path, "rb")
    if ffi.isNull(file) {
        throw "cannot open shader: " + path
    }
    sys.raw.fseek(file, 0, 2)
    let size = sys.raw.ftell(file)
    sys.raw.fseek(file, 0, 0)
    if size <= 0 or size % 4 != 0 {
        sys.raw.fclose(file)
        throw "not a SPIR-V file: " + path
    }
    let bytes = ffi.array(u8, size).new()
    let read = sys.raw.fread(bytes, 1, size, file)
    sys.raw.fclose(file)
    if read != size {
        bytes.free()
        throw "cannot read shader: " + path
    }
    { data: bytes, size: size }
}

let loadSlang = { |device, path|
    if sys.raw.access(path, 0) != 0 {
        throw "cannot open shader: " + path
    }
    let file = sys.raw.fopen(path, "rb")
    if ffi.isNull(file) {
        throw "cannot open shader: " + path
    }
    sys.raw.fseek(file, 0, 2)
    let size = sys.raw.ftell(file)
    sys.raw.fseek(file, 0, 0)
    if size <= 0 {
        sys.raw.fclose(file)
        throw "empty shader: " + path
    }
    let bytes = ffi.array(u8, size + 1).new()
    let read = sys.raw.fread(bytes, 1, size, file)
    sys.raw.fclose(file)
    if read != size {
        bytes.free()
        throw "cannot read shader: " + path
    }
    bytes.set(size, 0)
    let value = raw.shader_create_slang(device, path, bytes, size)
    bytes.free()
    ensureLast("tgpu_device_create_shader_slang")
    value
}

let option = { |value, fallback|
    if value == null {
        fallback
    } else {
        value
    }
}
let optionAtom = { |value, fallback|
    if value {
        value
    } else {
        fallback
    }
}
let sized = { |ty|
    let value = ty.new()
    value.struct_size = ty.size()
    value
}
let swapchainDesc = { |options|
    let options = option(options, {})
    let desc = sized(SwapchainDesc)
    if options.window != null {
        desc.window = options.window
    }
    desc.width = option(options.width, 0)
    desc.height = option(options.height, 0)
    desc.image_count = option(options.imageCount, 3)
    desc.present_mode = optionAtom(options.presentMode, PresentMode.fifo)
    desc
}
let bufferDesc = { |options|
    let options = option(options, {})
    let desc = sized(BufferDesc)
    if options.label != null {
        desc.label = options.label
    }
    desc.size = option(options.size, 0)
    desc.usage = option(options.usage, 0)
    desc.memory = optionAtom(options.memory, MemoryPreset.gpuOnly)
    desc.host_access = optionAtom(options.hostAccess, HostAccess.none)
    desc
}
let samplerDesc = { |options|
    let options = option(options, {})
    let desc = sized(SamplerDesc)
    desc.mag = optionAtom(options.mag, Filter.linear)
    desc.min = optionAtom(options.min, Filter.linear)
    desc.mipmap = optionAtom(options.mipmap, SamplerMipmapMode.linear)
    desc.address_u = optionAtom(options.addressU, SamplerAddressMode.clampToEdge)
    desc.address_v = optionAtom(options.addressV, SamplerAddressMode.clampToEdge)
    desc.address_w = optionAtom(options.addressW, SamplerAddressMode.clampToEdge)
    desc.anisotropy = option(options.anisotropy, 0.0)
    desc.min_lod = option(options.minLod, 0.0)
    desc.max_lod = option(options.maxLod, 0.0)
    desc
}
let imageDesc = { |options|
    let options = option(options, {})
    let desc = sized(ImageDesc)
    if options.label != null {
        desc.label = options.label
    }
    desc.format = optionAtom(options.format, Format.undefined)
    desc.width = option(options.width, 0)
    desc.height = option(options.height, 0)
    desc.depth = option(options.depth, 1)
    desc.mip_levels = option(options.mipLevels, 1)
    desc.array_layers = option(options.arrayLayers, 1)
    desc.usage = option(options.usage, 0)
    desc.memory = optionAtom(options.memory, MemoryPreset.gpuOnly)
    desc.host_access = optionAtom(options.hostAccess, HostAccess.none)
    desc.initial_layout = optionAtom(options.initialLayout, ImageLayout.undefined)
    desc
}
let viewImageDesc = { |options|
    let options = option(options, {})
    let desc = sized(ViewImageDesc)
    if options.image != null {
        desc.image = options.image
    }
    if options.sampler != null {
        desc.sampler = options.sampler
    }
    desc
}
let bindlessDesc = { |options|
    let options = option(options, {})
    let desc = sized(BindlessDesc)
    desc.max_read_buffers = option(options.maxReadBuffers, 0)
    desc.max_rw_buffers = option(options.maxRwBuffers, 0)
    desc.max_sampled_images = option(options.maxSampledImages, 0)
    desc.max_storage_images = option(options.maxStorageImages, 0)
    desc.max_samplers = option(options.maxSamplers, 0)
    desc.max_uniform_buffers = option(options.maxUniformBuffers, 0)
    desc
}
let computePipelineDesc = { |options|
    let options = option(options, {})
    let desc = sized(ComputePipelineDesc)
    if options.label != null {
        desc.label = options.label
    }
    desc.shader = option(options.shader, null)
    desc.entry = option(options.entry, null)
    desc.bindless = option(options.bindless, null)
    desc.push_constant_size = option(options.pushConstantSize, 0)
    desc
}
let renderPipelineDesc = { sized(RenderPipelineDesc) }
let renderDesc = { |options|
    let options = option(options, {})
    let desc = sized(RenderDesc)
    desc.x = option(options.x, 0)
    desc.y = option(options.y, 0)
    desc.width = option(options.width, 0)
    desc.height = option(options.height, 0)
    if options.colors != null {
        desc.colors = options.colors
    }
    desc.color_count = option(options.colorCount, 0)
    if options.depth != null {
        desc.depth = options.depth
    }
    if options.stencil != null {
        desc.stencil = options.stencil
    }
    desc
}

let pushConstantSize = { |options|
    if options.pushConstants != null {
        options.pushConstants.size()
    } else {
        option(options.pushConstantSize, 0)
    }
}
let createComputePipeline = { |device, options|
    with(ffi.cstring(options.entry), |entry| {
        with(computePipelineDesc({
            shader: options.shader
            bindless: options.bindless
            label: options.label
            pushConstantSize: pushConstantSize(options)
        }), |desc| {
            desc.entry = entry
            let value = raw.compute_pipeline_create(device, desc)
            ensureLast("tgpu_device_create_compute_pipeline")
            value
        })
    })
}
let createRenderPipeline = { |device, options|
    let create = { |vertexEntry, fragmentEntry|
        let colorFormats = option(options.colorFormats, [])
        with(ffi.array(i32, colorFormats.length).new(), |formats| {
            let i = 0
            while i < colorFormats.length {
                formats.set(i, colorFormats[i])
                i = i + 1
            }
            with(renderPipelineDesc(), |desc| {
                desc.vertex_shader = options.shader
                desc.vertex_entry = vertexEntry
                desc.fragment_shader = option(options.fragmentShader, options.shader)
                desc.fragment_entry = fragmentEntry
                desc.color_formats = formats
                desc.color_format_count = colorFormats.length
                desc.depth_format = optionAtom(options.depthFormat, Format.undefined)
                desc.depth_test = option(options.depthTest, false)
                desc.depth_write = option(options.depthWrite, false)
                desc.depth_compare = optionAtom(options.depthCompare, CompareOp.less)
                desc.bindless = options.bindless
                desc.push_constant_size = pushConstantSize(options)
                desc.cull = optionAtom(options.cull, CullMode.back)
                desc.front_face = optionAtom(options.frontFace, FrontFace.counterClockwise)
                desc.topology = optionAtom(options.topology, Topology.triangleList)
                desc.blend = optionAtom(options.blend, Blend.disabled)
                desc.sample_count = option(options.sampleCount, 1)
                let value = raw.render_pipeline_create(device, desc)
                ensureLast("tgpu_device_create_render_pipeline")
                value
            })
        })
    }
    with(ffi.cstring(options.vertexEntry), |vertexEntry| {
        with(ffi.cstring(options.fragmentEntry), |fragmentEntry| {
            create(vertexEntry, fragmentEntry)
        })
    })
}
mod vendor.tgpu {
    export INVALID_HANDLE = invalid_handle
    export loadSpirv = loadSpirv
    export loadSlang = loadSlang
    export createComputePipeline = createComputePipeline
    export createRenderPipeline = createRenderPipeline
    export sized = sized
    export swapchainDesc = swapchainDesc
    export bufferDesc = bufferDesc
    export samplerDesc = samplerDesc
    export imageDesc = imageDesc
    export viewImageDesc = viewImageDesc
    export bindlessDesc = bindlessDesc
    export computePipelineDesc = computePipelineDesc
    export renderPipelineDesc = renderPipelineDesc
    export renderDesc = renderDesc
    export WindowKind = WindowKind
    export PresentMode = PresentMode
    export MemoryPreset = MemoryPreset
    export HostAccess = HostAccess
    export BufferUsage = BufferUsage
    export ImageUsage = ImageUsage
    export ImageLayout = ImageLayout
    export LoadOp = LoadOp
    export StoreOp = StoreOp
    export Filter = Filter
    export SamplerMipmapMode = SamplerMipmapMode
    export SamplerAddressMode = SamplerAddressMode
    export Format = Format
    export CompareOp = CompareOp
    export CullMode = CullMode
    export FrontFace = FrontFace
    export Topology = Topology
    export Blend = Blend
    export VertexInputRate = VertexInputRate
    export raw = raw
    export ImageView = ImageView
    export Image = Image
    export Sampler = Sampler
    export Window = Window
    export SwapchainDesc = SwapchainDesc
    export BufferDesc = BufferDesc
    export SamplerDesc = SamplerDesc
    export ImageDesc = ImageDesc
    export ViewImageDesc = ViewImageDesc
    export BindlessDesc = BindlessDesc
    export ComputePipelineDesc = ComputePipelineDesc
    export VertexAttribute = VertexAttribute
    export VertexBufferLayout = VertexBufferLayout
    export BufferImageCopy = BufferImageCopy
    export RenderPipelineDesc = RenderPipelineDesc
    export ColorAttachment = ColorAttachment
    export RenderDesc = RenderDesc
    export Frame = Frame
    export Extent2D = Extent2D
    export PushConstants = PushConstants
    export instanceCreate = { |desc|
        let value = raw.instance_create(desc)
        ensureLast("tgpu_instance_create")
        value
    }
    export instanceDestroy = raw.instance_destroy
    export deviceCreate = { |instance, desc, queues, capacity|
        let value = raw.device_create(instance, desc, queues, capacity)
