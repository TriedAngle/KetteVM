            "tgpu_recorder_draw"
        )
    }
    export recorderDrawIndexed = { |recorder, first_index, index_count, vertex_offset, first_instance, instance_count|
        record_status(
            raw.recorder_draw_indexed(
                recorder,
                first_index,
                index_count,
                vertex_offset,
                first_instance,
                instance_count
            ),
            "tgpu_recorder_draw_indexed"
        )
    }
    export recorderBindVertexBuffer = { |recorder, slot, buffer, offset|
        record_status(
            raw.recorder_bind_vertex(recorder, slot, buffer, offset),
            "tgpu_recorder_bind_vertex_buffer"
        )
    }
    export recorderUpdateBuffer = { |recorder, buffer, offset, data, len|
        record_status(
            raw.recorder_update_buffer(recorder, buffer, offset, data, len),
            "tgpu_recorder_update_buffer"
        )
    }
    export recorderBufferTransition = { |recorder, buffer, from, to|
        record_status(
            raw.recorder_buffer_transition(recorder, buffer, from, to),
            "tgpu_recorder_buffer_transition"
        )
    }
    export recorderCopyBufferToImage = { |recorder, buffer, image, layout, region|
        record_status(
            raw.recorder_copy_buffer_to_image(recorder, buffer, image, layout, region),
            "tgpu_recorder_copy_buffer_to_image"
        )
    }
    export recorderCopyImageToBuffer = { |recorder, image, layout, buffer, region|
        record_status(
            raw.recorder_copy_image_to_buffer(recorder, image, layout, buffer, region),
            "tgpu_recorder_copy_image_to_buffer"
        )
    }
    export bufferWrite = { |buffer, offset, data, len|
        record_status(raw.buffer_write(buffer, offset, data, len), "tgpu_buffer_write")
    }
    export bufferRead = { |buffer, offset, data, len|
        record_status(raw.buffer_read(buffer, offset, data, len), "tgpu_buffer_read")
    }
    export textureCreate = { |queue, device, desc, data, len|
        let value = raw.texture_create(queue, device, desc, data, len)
        record_last("tgpu_queue_create_texture_2d")
        value
    }
    export bindlessAddReadBuffer = { |heap, buffer|
        raw.bindless_add_read(heap, buffer)
    }
    export bindlessAddUniformBuffer = { |heap, buffer, range|
        raw.bindless_add_uniform(heap, buffer, range)
    }
    export swapchainSetPresentMode = { |swapchain, mode|
        raw.swapchain_set_present(swapchain, mode)
    }
    export queueSubmit = { |queue, commands, count, out_value|
        record_status(
            raw.queue_submit(queue, commands, count, out_value),
            "tgpu_queue_submit"
        )
    }
    export queueWait = { |queue, value|
        record_status(raw.queue_wait(queue, value), "tgpu_queue_wait")
    }
    export recorderEndRender = { |recorder|
        record_status(raw.recorder_end_render(recorder), "tgpu_recorder_end_render")
    }
    export recorderFinish = { |recorder|
        let value = raw.recorder_finish(recorder)
        record_last("tgpu_recorder_finish")
        value
    }
    export commandBufferDestroy = raw.command_buffer_destroy
}
