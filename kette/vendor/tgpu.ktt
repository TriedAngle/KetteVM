        )
    }
    export recorderCopyImageToBuffer = { |recorder, image, layout, buffer, region|
        ensureStatus(
            raw.recorder_copy_image_to_buffer(recorder, image, layout, buffer, region),
            "tgpu_recorder_copy_image_to_buffer"
        )
    }
    export bufferWrite = { |buffer, offset, data, len|
        ensureStatus(raw.buffer_write(buffer, offset, data, len), "tgpu_buffer_write")
    }
    export bufferRead = { |buffer, offset, data, len|
        ensureStatus(raw.buffer_read(buffer, offset, data, len), "tgpu_buffer_read")
    }
    export textureCreate = { |queue, device, desc, data, len|
        let value = raw.texture_create(queue, device, desc, data, len)
        ensureLast("tgpu_queue_create_texture_2d")
        value
    }
    export bindlessAddReadBuffer = { |heap, buffer|
        raw.bindless_add_read(heap, buffer)
    }
    export bindlessAddUniformBuffer = { |heap, buffer, range|
        raw.bindless_add_uniform(heap, buffer, range)
    }
    export swapchainSetPresentMode = { |swapchain, mode|
        raw.swapchain_set_present(swapchain, mode)
    }
    export queueSubmit = { |queue, commands, count, out_value|
        ensureStatus(
            raw.queue_submit(queue, commands, count, out_value),
            "tgpu_queue_submit"
        )
    }
    export queueWait = { |queue, value|
        ensureStatus(raw.queue_wait(queue, value), "tgpu_queue_wait")
    }
    export recorderEndRender = { |recorder|
        ensureStatus(raw.recorder_end_render(recorder), "tgpu_recorder_end_render")
    }
    export recorderFinish = { |recorder|
        let value = raw.recorder_finish(recorder)
        ensureLast("tgpu_recorder_finish")
        value
    }
    export commandBufferDestroy = raw.command_buffer_destroy
    export GPU = {
        instance: null
        device: null
        queue: null
        present: null
        frame: null
        lastExtent: null
        resources: []

        new: {
            let gpu = self.clone()
            gpu.present = null
            gpu.frame = null
            gpu.lastExtent = null
            gpu.resources = []
            let failed = false
            let error = null
            try {
                with(ffi.array(Ptr, 1).new(), |queues| {
                    let instance = raw.instance_create(null)
                    ensureLast("tgpu_instance_create")
                    gpu.instance = instance
                    gpu.resources.push({ dispose: { raw.instance_destroy(instance) } })
                    let device = raw.device_create(instance, null, queues, 1)
                    ensureLast("tgpu_device_create")
                    gpu.device = device
                    gpu.resources.push({ dispose: { raw.device_destroy(device) } })
                    let queue = queues.get(0)
                    gpu.queue = queue
                    gpu.resources.push({ dispose: { raw.queue_destroy(queue) } })
                })
            } catch (e) {
                failed = true
                error = e
            }
            if failed {
                gpu.dispose()
                throw error
            }
            gpu
        }
        track: |dispose| {
            self.resources.push(dispose)
            dispose
        }
        swapchain: |options| {
            with(swapchainDesc(options), |desc| {
                let value = raw.swapchain_create(self.device, desc)
                ensureLast("tgpu_device_create_swapchain")
                self.resources.push({ dispose: { raw.swapchain_destroy(value) } })
                self.lastExtent = self.swapchainExtent(value)
                value
            })
        }
        buffer: |options, data, len| {
            let data = option(data, options.data)
            let length = option(len, options.dataLength)
            if length == null {
                length = 0
            }
            if data != null and length == 0 {
                length = data.size()
            }
            with(bufferDesc(options), |desc| {
                let value = raw.buffer_create(self.device, desc, data, length)
                ensureLast("tgpu_device_create_buffer")
                self.resources.push({ dispose: { raw.buffer_destroy(value) } })
                value
            })
        }
        bindless: |options| {
            with(bindlessDesc(options), |desc| {
                let value = raw.bindless_create(self.device, desc)
                ensureLast("tgpu_device_create_bindless")
                self.resources.push({ dispose: { raw.bindless_destroy(value) } })
                value
            })
        }
        viewImage: |options| {
            let create = { |image, sampler|
                with(viewImageDesc({ image: image, sampler: sampler }), |desc| {
                    let value = raw.view_image_create(self.device, desc)
                    ensureLast("tgpu_device_create_view_image")
                    value
                })
            }
            with(imageDesc(options.image), |image| {
                if options.sampler == null {
                    create(image, null)
                } else {
                    with(samplerDesc(options.sampler), |sampler| {
                        create(image, sampler)
                    })
                }
            })
        }
        shaderSlang: |path| {
            let value = loadSlang(self.device, path)
            self.resources.push({ dispose: { raw.shader_destroy(value) } })
            value
        }
        computePipeline: |options| {
            let value = createComputePipeline(self.device, options)
            self.resources.push({ dispose: { raw.compute_pipeline_destroy(value) } })
            value
        }
        renderPipeline: |options| {
            let value = createRenderPipeline(self.device, options)
            self.resources.push({ dispose: { raw.render_pipeline_destroy(value) } })
            value
        }
        deviceWaitIdle: {
            if self.device != null {
                raw.device_wait_idle(self.device)
            }
        }
        presentImage: |options| {
            self.deviceWaitIdle()
            if self.present != null {
                raw.view_image_destroy(self.present)
                self.present = null
            }
            let value = self.viewImage(options)
            self.present = value
            value
        }
        own: |value| {
            self.resources.push({ dispose: { value.free() } })
            value
        }
        array: |ty, count| { self.own(ffi.array(ty, count).new()) }
        pushConstants: |ty| {
            let value = ty.new()
            self.resources.push({ dispose: { value.free() } })
            value
        }
        acquireFrame: |swapchain| {
            if self.frame == null {
                self.frame = self.own(Frame.new())
            }
            self.swapchainBeginFrame({
                queue: self.queue
                swapchain: swapchain
                frame: self.frame
            })
            let extent = self.swapchainExtent(swapchain)
            let resized = self.lastExtent != null and (
                extent.width != self.lastExtent.width or
                    extent.height != self.lastExtent.height
            )
            self.lastExtent = extent
            { frame: self.frame, extent: extent, resized: resized }
        }
        swapchainBeginFrame: |options| {
            ensureStatus(
                raw.swapchain_begin_frame(
                    options.queue,
                    options.swapchain,
                    options.frame
                ),
                "tgpu_swapchain_begin_frame"
            )
        }
        swapchainRecreate: |options| {
            ensureStatus(
                raw.swapchain_recreate(options.swapchain),
                "tgpu_swapchain_recreate"
            )
        }
        swapchainEndFrame: |options| {
            with(ffi.array(Ptr, 1).new(), |commands| {
                commands.set(0, options.command)
                let failed = false
                let error = null
                try {
                    ensureStatus(
                        raw.swapchain_end_frame(
                            options.queue,
                            options.swapchain,
                            options.frame,
                            commands,
                            1
                        ),
                        "tgpu_swapchain_end_frame"
                    )
                } catch (e) {
                    failed = true
                    error = e
                }
                raw.command_buffer_destroy(options.command)
                if failed {
                    throw error
                }
            })
        }
        swapchainExtent: |swapchain| {
            with(Extent2D.new(), |extent| {
                ensureStatus(
                    raw.swapchain_extent(swapchain, extent),
                    "tgpu_swapchain_extent"
                )
                { width: extent.width, height: extent.height }
            })
        }
        swapchainSetExtent: |swapchain, extent| {
            with(Extent2D.new(), |size| {
                size.width = extent.width
                size.height = extent.height
                raw.swapchain_set_extent(swapchain, size)
            })
        }
        bindlessAddReadBuffer: |options| {
            ensureHandle(
                raw.bindless_add_read(options.bindless, options.buffer),
                "tgpu_bindless_add_read_buffer"
            )
        }
        bindlessAddRwBuffer: |options| {
            ensureHandle(
                raw.bindless_add_rw_buffer(options.bindless, options.buffer),
                "tgpu_bindless_add_rw_buffer"
            )
        }
        bindlessAddUniformBuffer: |options| {
            ensureHandle(
                raw.bindless_add_uniform(
                    options.bindless,
                    options.buffer,
                    options.range
                ),
                "tgpu_bindless_add_uniform_buffer"
            )
        }
        bindlessAddStorageImage: |options| {
            let view = if options.view != null {
                options.view
            } else {
                raw.view_image_view(options.image)
            }
            ensureHandle(
                raw.bindless_add_storage_image(
                    options.bindless,
                    view,
                    options.layout
                ),
                "tgpu_bindless_add_storage_image"
            )
        }
        bindlessAddSampledImage: |options| {
            let view = if options.view != null {
                options.view
            } else {
                raw.view_image_view(options.image)
            }
            ensureHandle(
                raw.bindless_add_sampled_image(
                    options.bindless,
                    view,
                    options.layout
                ),
                "tgpu_bindless_add_sampled_image"
            )
        }
        bindlessAddSampler: |options| {
            let sampler = if options.sampler != null {
                options.sampler
            } else {
                raw.view_image_sampler(options.image)
            }
            ensureHandle(
                raw.bindless_add_sampler(options.bindless, sampler),
                "tgpu_bindless_add_sampler"
            )
        }
        bindlessUpdateStorageImage: |options| {
            let view = if options.view != null {
                options.view
            } else {
                raw.view_image_view(options.image)
            }
            ensureStatus(
                raw.bindless_update_storage_image(
                    options.bindless,
                    options.handle,
                    view,
                    options.layout
                ),
                "tgpu_bindless_update_storage_image"
            )
        }
        bindlessUpdateSampledImage: |options| {
            let view = if options.view != null {
                options.view
            } else {
                raw.view_image_view(options.image)
            }
            ensureStatus(
                raw.bindless_update_sampled_image(
                    options.bindless,
                    options.handle,
                    view,
                    options.layout
                ),
                "tgpu_bindless_update_sampled_image"
            )
        }
        bindlessUpdateSampler: |options| {
            let sampler = if options.sampler != null {
                options.sampler
            } else {
                raw.view_image_sampler(options.image)
            }
            ensureStatus(
                raw.bindless_update_sampler(options.bindless, options.handle, sampler),
                "tgpu_bindless_update_sampler"
            )
        }
        recorderBegin: |options| {
            let value = raw.recorder_begin(options.queue)
            ensureLast("tgpu_queue_begin_commands")
            value
        }
        recorderBindCompute: |options| {
            ensureStatus(
                raw.recorder_bind_compute(
                    options.recorder,
                    options.pipeline,
                    options.bindless,
                    options.pushConstants,
                    options.pushConstants.size()
                ),
                "tgpu_recorder_bind_compute"
            )
        }
        recorderBindRender: |options| {
            ensureStatus(
                raw.recorder_bind_render(
                    options.recorder,
                    options.pipeline,
                    options.bindless,
                    options.pushConstants,
                    options.pushConstants.size()
                ),
                "tgpu_recorder_bind_render"
            )
        }
        recorderTransitionImage: |options| {
            ensureStatus(
                raw.recorder_transition_image(
                    options.recorder,
                    raw.view_image_image(options.image),
                    options.layout
                ),
                "tgpu_recorder_transition_image"
            )
        }
        recorderTransitionFrame: |options| {
            ensureStatus(
                raw.recorder_transition_frame(
                    options.recorder,
                    options.swapchain,
                    options.frame,
                    options.layout
                ),
                "tgpu_recorder_transition_frame"
            )
        }
        recorderDispatch: |options| {
            ensureStatus(
                raw.recorder_dispatch(
                    options.recorder,
                    options.x,
                    options.y,
                    options.z
                ),
                "tgpu_recorder_dispatch"
            )
        }
        render: |options, block| {
            if options.pipeline != null {
                self.recorderBindRender({
                    recorder: options.recorder
                    pipeline: options.pipeline
                    bindless: options.bindless
                    pushConstants: options.pushConstants
                })
            }
            self.recorderBeginRender({
                recorder: options.recorder
                desc: options.desc
            })
            let result = null
            let failed = false
            let error = null
            try {
                result = block(options.recorder)
            } catch (e) {
                failed = true
                error = e
            }
            let end_failed = false
            let end_error = null
            try {
                self.recorderEndRender({ recorder: options.recorder })
            } catch (e) {
                end_failed = true
                end_error = e
            }
            if failed {
                throw error
            }
            if end_failed {
                throw end_error
            }
            result
        }
        recorderBeginRender: |options| {
            ensureStatus(
                raw.recorder_begin_render(options.recorder, options.desc),
                "tgpu_recorder_begin_render"
            )
        }
        recorderEndRender: |options| {
            ensureStatus(
                raw.recorder_end_render(options.recorder),
                "tgpu_recorder_end_render"
            )
        }
        recorderDraw: |options| {
            ensureStatus(
                raw.recorder_draw(
                    options.recorder,
                    options.firstVertex,
                    options.vertexCount,
                    options.firstInstance,
                    options.instanceCount
                ),
                "tgpu_recorder_draw"
            )
        }
        recorderFinish: |options| {
            let value = raw.recorder_finish(options.recorder)
            ensureLast("tgpu_recorder_finish")
            value
        }
        swapchainView: |options| {
            raw.swapchain_view(options.swapchain, options.frame)
        }
        writeColorAttachment: |options| {
            with(ColorAttachment.new(), |attachment| {
                attachment.view = options.view
                attachment.layout = options.layout
                attachment.load = options.load
                attachment.store = options.store
                let clear = option(options.clearColor, [0.0, 0.0, 0.0, 0.0])
                attachment.clear_color.set(0, clear[0])
                attachment.clear_color.set(1, clear[1])
                attachment.clear_color.set(2, clear[2])
                attachment.clear_color.set(3, clear[3])
                options.attachments.set(options.index, attachment)
            })
        }
        dispose: {
            self.deviceWaitIdle()
            if self.present != null {
                raw.view_image_destroy(self.present)
                self.present = null
            }
            let i = self.resources.length - 1
            while i >= 0 {
                self.resources[i].dispose()
                i = i - 1
            }
            self.resources = []
        }
    }

}
