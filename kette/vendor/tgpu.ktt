use ffi
use os
use sys
let (struct, void, bool, i32, u32, f32, u8, u64, CString) = ffi
let Ptr = ffi.pointer(void)

let tgpu_native_path = if os.name == "macos" {
        "/Users/sebastian/Projects/tgpu/target/release/libtgpu_native.dylib"
    } else if os.name == "windows" {
        "tgpu_native.dll"
    } else {
        "libtgpu_native.so"
    }

let lib = ffi.library(tgpu_native_path)

let pending = { error: null }
let error_buffer = ffi.array(u8, 512).new()
let invalid_handle = 4294967295
let ImageView = struct({
    handle: Ptr,
})
let Image = struct({
    handle: Ptr,
})
let Sampler = struct({
    handle: Ptr,
})
let Window = struct({
    kind: i32,
    display: Ptr,
    window: Ptr,
})
let SwapchainDesc = struct({
    struct_size: u64,
    window: Window,
    width: u32,
    height: u32,
    image_count: u32,
    present_mode: i32,
})
let BufferDesc = struct({
    struct_size: u64,
    label: CString,
    size: u64,
    usage: u32,
    memory: i32,
    host_access: i32,
})
let SamplerDesc = struct({
    struct_size: u64,
    label: CString,
    mag: i32,
    min: i32,
    mipmap: i32,
    address_u: i32,
    address_v: i32,
    address_w: i32,
    anisotropy: f32,
    min_lod: f32,
    max_lod: f32,
})
let ImageDesc = struct({
    struct_size: u64,
    label: CString,
    format: i32,
    width: u32,
    height: u32,
    depth: u32,
    mip_levels: u32,
    array_layers: u32,
    usage: u32,
    memory: i32,
    host_access: i32,
    initial_layout: i32,
})
let ViewImageDesc = struct({
    struct_size: u64,
    image: ImageDesc,
    sampler: Ptr,
})
let BindlessDesc = struct({
    struct_size: u64,
    max_read_buffers: u32,
    max_rw_buffers: u32,
    max_sampled_images: u32,
    max_storage_images: u32,
    max_samplers: u32,
    max_uniform_buffers: u32,
})
let ComputePipelineDesc = struct({
    struct_size: u64,
    label: CString,
    shader: Ptr,
    entry: CString,
    bindless: Ptr,
    push_constant_size: u32,
})
let VertexAttribute = struct({
    location: u32,
    binding: u32,
    format: i32,
    offset: u32,
})
let VertexBufferLayout = struct({
    binding: u32,
    stride: u32,
    input_rate: i32,
    attributes: Ptr,
    attribute_count: u64,
})
let BufferImageCopy = struct({
    buffer_offset: u64,
    buffer_row_length: u32,
    buffer_image_height: u32,
    x: i32,
    y: i32,
    z: i32,
    width: u32,
    height: u32,
    depth: u32,
})
let RenderPipelineDesc = struct({
    struct_size: u64,
    label: CString,
    vertex_shader: Ptr,
    vertex_entry: CString,
    fragment_shader: Ptr,
    fragment_entry: CString,
    color_formats: Ptr,
    color_format_count: u64,
    depth_format: i32,
    depth_test: bool,
    depth_write: bool,
    depth_compare: i32,
    bindless: Ptr,
    push_constant_size: u32,
    cull: i32,
    front_face: i32,
    topology: i32,
    blend: i32,
    vertex_buffers: Ptr,
    vertex_buffer_count: u64,
    sample_count: u32,
})
let ColorAttachment = struct({
    view: ImageView,
    layout: i32,
    load: i32,
    store: i32,
    clear_color: ffi.array(f32, 4),
})
let RenderDesc = struct({
    struct_size: u64,
    x: i32,
    y: i32,
    width: u32,
    height: u32,
    colors: Ptr,
    color_count: u64,
    depth: Ptr,
    stencil: Ptr,
})
let Frame = struct({
    index: u32,
    flight_index: u64,
    suboptimal: bool,
    out_of_date: bool,
})
let Extent2D = struct({
    width: u32,
    height: u32,
})
// Must match the Slang PushData layout.
let PushConstants = struct({
    output_image: u32,
    particles: u32,
    present_texture: u32,
    present_sampler: u32,
    window: ffi.array(u32, 2),
    mouse: ffi.array(f32, 2),
    dt: f32,
    pad: f32,
})

