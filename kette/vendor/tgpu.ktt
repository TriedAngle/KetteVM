    export computePipelineDestroy = raw.compute_pipeline_destroy
    export renderPipelineCreate = { |device, desc|
        let value = raw.render_pipeline_create(device, desc)
        ensureLast("tgpu_device_create_render_pipeline")
        value
    }
    export renderPipelineDestroy = raw.render_pipeline_destroy
    export recorderBegin = { |queue|
        let value = raw.recorder_begin(queue)
        ensureLast("tgpu_queue_begin_commands")
