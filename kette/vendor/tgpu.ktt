        )
    }
    export recorderBindCompute = { |recorder, pipeline, heap, push, len|
        record_status(
            raw.recorder_bind_compute(recorder, pipeline, heap, push, len),
            "tgpu_recorder_bind_compute"
        )
    }
    export recorderDispatch = { |recorder, x, y, z|
        record_status(
            raw.recorder_dispatch(recorder, x, y, z),
            "tgpu_recorder_dispatch"
        )
    }
    export recorderBindRender = { |recorder, pipeline, heap, push, len|
        record_status(
            raw.recorder_bind_render(recorder, pipeline, heap, push, len),
            "tgpu_recorder_bind_render"
        )
    }
    export recorderBeginRender = { |recorder, desc|
        record_status(
            raw.recorder_begin_render(recorder, desc),
            "tgpu_recorder_begin_render"
        )
    }
    export recorderDraw = { |recorder, first_vertex, vertex_count, first_instance, instance_count|
        record_status(
            raw.recorder_draw(
                recorder,
                first_vertex,
                vertex_count,
                first_instance,
