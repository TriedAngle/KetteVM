// Atomic reference cell: load/store/swap/CAS, GC edges, and a lock-free stack.
// Run:  cargo run -q -p vm -- kette/std/startup.ktt kette/kette_tests/atomic_ref.ktt
// Check: kette/kette_tests/check.py

use collections.pool { ThreadPool }

let ref = atomic.AtomicRef.new(null)
Test.assert(ref.load(), null)

let first = { value: 1 }
let second = { value: 2 }
ref.store(first)
Test.assert(ref.load(), first)
Test.assert(ref.swap(second), first)
Test.assert(ref.load(), second)
Test.assert(ref.compareExchange(first, first), second)
Test.assert(ref.compareExchange(second, first), second)
Test.assert(ref.load(), first)

// Old cell, young referent: the write barrier must remember the slot.
KetteTools.forceMajorGC()
let young = { value: 42 }
ref.store(young)
KetteTools.forceMinorGC()
Test.assert(ref.load(), young)

// Concurrent lock-free stack.
let pool = ThreadPool.newWithSize(2)
let head = atomic.AtomicRef.new(null)
let producers = 4
let perProducer = 100
let done = atomic.AtomicI64.new(0)
let producer = 0
while producer < producers {
    pool.spawn({
        let index = 0
        while index < perProducer {
            let next = head.load()
            let node = { next: next }
            while head.compareExchange(next, node) != next {
                next = head.load()
                node.next = next
            }
            if index % 25 == 0 {
                KetteTools.forceMinorGC()
            }
            index = index + 1
        }
        done.add(1)
    })
    producer = producer + 1
}
while done.load() < producers {
    Thread.sleep(1)
}

KetteTools.forceMajorGC()

let count = 0
let node = head.load()
while node != null {
    let next = node.next
    if head.compareExchange(node, next) == node {
        count = count + 1
        node = next
    } else {
        node = head.load()
    }
}
Test.assert(count, producers * perProducer)
pool.shutdown()
