// Run:  cargo run -q -p vm -- kette/kette_tests/control_flow.ktt
// Check: kette/kette_tests/check.py

use collections.sequence { range }

let n = 2

let sign = if n < 0 { 0 - 1 } else { 1 }
Test.assert(sign, 1)

let classified = if n < 1 { 0 } else { if n < 2 { 1 } else { 2 } }
Test.assert(classified, 2)

let doubled = if true {
    let t = 21
    t * 2
} else {
    0
}
Test.assert(doubled, 42)

// a missing else yields null on the falsy path
let skipped = if false { 9 }
Test.assert(skipped == null, true)

let hits = 0
let mark = { hits = hits + 1; true }

// laziness: the rhs must not run
let a = false and mark()
let b = true or mark()
Test.assert(hits, 0)
Test.assert(false or 7, 7)
Test.assert(true and 5, 5)

// while: condition is truthy/falsy, body runs each iteration
let i = 0
let total = 0
while i < 5 {
    total = total + i
    i = i + 1
}
Test.assert(i, 5)
Test.assert(total, 10)

// a falsy condition skips the body
let skipped_loop = 0
while false {
    skipped_loop = 1
}
Test.assert(skipped_loop, 0)

// the loop body's own `let` is scoped to the body
let outer = 3
while outer > 0 {
    let step = outer
    outer = outer - step
}
Test.assert(outer, 0)

// while in expression position evaluates to null
let loop_value = while false { 1 }
Test.assert(loop_value == null, true)

// break with and without a value
let break_value = while true { break 42 }
Test.assert(break_value, 42)

let break_empty = while true { break }
Test.assert(break_empty == null, true)

let break_total = 0
let break_i = 0
let break_result = while true {
    break_i = break_i + 1
    if break_i == 3 {
        break break_i
    }
    break_total = break_total + 1
}
Test.assert(break_result, 3)
Test.assert(break_total, 2)

// break only exits the innermost loop
let outer_count = 0
let inner_count = 0
while outer_count < 2 {
    outer_count = outer_count + 1
    inner_count = 0
    while true {
        inner_count = inner_count + 1
        if inner_count == 2 {
            break
        }
    }
}
Test.assert(outer_count, 2)
Test.assert(inner_count, 2)

// sibling branches may reuse a `let` name; each use resolves to the
// declaration visible at that source position
let pick = { |flag|
    if flag {
        let x = 1
        x
    } else {
        let x = 2
        x
    }
}
Test.assert(pick(true), 1)
Test.assert(pick(false), 2)

// continue skips the rest of the current iteration
let continued_sum = 0
for value in [1, 2, 3, 4] {
    if value == 2 {
        continue
    }
    continued_sum = continued_sum + value
}
Test.assert(continued_sum, 8)

let continued_count = 0
let continued_total = 0
while continued_count < 4 {
    continued_count = continued_count + 1
    if continued_count == 2 {
        continue
    }
    continued_total = continued_total + continued_count
}
Test.assert(continued_total, 8)

// range is a reusable integer iterator
let range_sum = 0
for value in range(0, 4) {
    range_sum = range_sum + value
}
Test.assert(range_sum, 6)
