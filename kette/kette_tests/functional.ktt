use collection.sequence { Sequence }

let seq = |values| {
    let result = Sequence.new()
    for value in values {
        result.add(value)
    }
    result
}

let add = |a, b| { a + b }
let add3 = |a, b, c| { a + b + c }
let add1 = |x| { x + 1 }
let double = |x| { x * 2 }

let add_one = Functional.curry(add, 1)
Test.assert(add_one(5), 6)

let curried = Functional.curry(add)
Test.assert(curried(2)(3), 5)
Test.assert(Functional.uncurry(curried)(2, 3), 5)
Test.assert(Functional.curry2(add3)(1)(2)(3), 6)

Test.assert(Functional.compose(add1, double)(3), 7)
Test.assert(Functional.pipe(add1, double)(3), 8)
Test.assert(Functional.composeAll([add1, double])(3), 7)
Test.assert(Functional.pipeAll(seq([add1, double]))(3), 8)

Test.assert(Functional.identity(3), 3)
Test.assert(Functional.constant(7)(9), 7)
Test.assert(Functional.flip(|a, b| { a - b })(2, 10), 8)
Test.assert(Functional.partial3(add3, 1)(2, 3), 6)
