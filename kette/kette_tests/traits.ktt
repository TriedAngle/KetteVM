// Traits: `name*:` slots form a multi-parent lookup chain in
// declaration order. Methods get `self` from the send, so `Counter.count`
// reads the receiver's `n`.
//
// Run:  cargo run -q -p vm -- kette/kette_tests/traits.ktt
// Check: kette/kette_tests/check.py

let Greeter = {
    greet: { "hello" }
    describe: { self.name }
}

let Counter = {
    count: { self.n }
}

let Thing = {
    greeter*: Greeter
    counter*: Counter
    name: "thing"
    n: 41
}

Test.assert(Thing.greet(), "hello")
Test.assert(Thing.describe(), "thing")
Test.assert(Thing.count(), 41)

// a parent slot write writes through to the holder
let P = { x: 1 }
let C = { parent*: P }
C.x = 9
Test.assert(P.x, 9)

// and parents are consulted in declaration order
let P1 = { a: 1 }
let P2 = { b: 2 }
let D = { p1*: P1; p2*: P2 }
Test.assert(D.b, 2)

// callables clone shallowly and keep the type map
let CallableTraits = {
    get: { self.n }
}
let Callable = {
    traits*: CallableTraits
    n: 3
    |x| x + self.n
}
let callable_copy = Callable.clone()
Test.assert(callable_copy(4), 7)
Test.assert(callable_copy.get(), 3)
Test.assert(Object.isType(callable_copy, Callable), true)

// callability is inherited through parent lists; the call body is the
// parent's, while `self` stays the receiver
let CallableBase = {
    n: 2
    |x| x + self.n
}
let CallableChild = { parent*: CallableBase }
Test.assert(CallableChild(3), 5)
let CallableGrandchild = { parent*: CallableChild }
Test.assert(CallableGrandchild(4), 6)

// no callable ancestor still means not callable
let PlainParent = { n: 1 }
let PlainChild = { parent*: PlainParent }
let plain_error = try { PlainChild() } catch (error) { error.name }
Test.assert(plain_error, "TypeError")

// a cached hit is invalidated when an earlier parent gains the property
let Later = { b: 2 }
let Earlier = { a: 1 }
let Siblings = { p1*: Earlier; p2*: Later }
let read_b = { |obj| obj.b }
Test.assert(read_b(Siblings), 2)
Earlier.b = 1
Test.assert(read_b(Siblings), 1)
Test.assert(read_b(Siblings), 1)

// a cached miss through nested parent lists re-resolves after an ancestor
// gains the property
let Root = { a: 1 }
let Mid = { parent*: Root }
let Leaf = { parent*: Mid }
let read_leaf_b = { |obj| obj.b }
Test.assert(read_leaf_b(Leaf), None)
Root.b = 2
Test.assert(read_leaf_b(Leaf), 2)
Test.assert(read_leaf_b(Leaf), 2)
Test.assert(Leaf.a, 1)
