// Userspace virtual-thread pool on top of a non-blocking run queue and DelayScheduler.
// Run:  cargo run -q -p vm -- kette/std/startup.ktt kette/kette_tests/pool.ktt
// Check: kette/kette_tests/check.py

use collections.pool { ThreadPool }
use collections.channel { Channel }
use sync { Mutex }

let pool = ThreadPool.newWithSize(2)
Test.assert(pool.size, 2)
Test.assert(pool.isClosed(), false)

// Write the scheduler into every task's thread object.
let scheduled = false
let probe = pool.spawn({
    scheduled = Thread.current().scheduler == pool
})
while probe.isAlive() {
    Thread.sleep(1)
}
probe.join()
Test.assert(scheduled, true)

// A yield resubmits the task to a worker.
let order = ""
let first = pool.spawn({
    order = order + "a"
    Thread.yield()
    order = order + "b"
})
let second = pool.spawn({
    order = order + "c"
    Thread.yield()
    order = order + "d"
})
while first.isAlive() or second.isAlive() {
    Thread.sleep(1)
}
first.join()
second.join()
Test.assert(order.length, 4)

// More tasks than workers all run.
let counter = atomic.AtomicI64.new(0)
let tasks = []
let index = 0
while index < 20 {
    tasks.push(pool.spawn({
        counter.add(1)
    }))
    index = index + 1
}
tasks.forEach(|task| {
    while task.isAlive() {
        Thread.sleep(1)
    }
    task.join()
})
Test.assert(counter.load(), 20)

// A task parked on a mutex is resubmitted when the lock is released.
let guard = Mutex.new()
let shared = atomic.AtomicI64.new(0)
let holder = pool.spawn({
    guard.lock()
    shared.add(1)
    pool.sleep(5000000)
    shared.add(10)
    guard.unlock()
})
pool.sleep(1000000)
let waiter = pool.spawn({
    guard.lock()
    shared.add(100)
    guard.unlock()
})
while holder.isAlive() or waiter.isAlive() {
    Thread.sleep(1)
}
holder.join()
waiter.join()
Test.assert(shared.load(), 111)

// A task parked on a channel is resubmitted by send.
let channel = Channel.new(1)
let received = []
let producer = pool.spawn({
    channel.send(1)
    channel.send(2)
    channel.send(3)
    channel.close()
})
let consumer = pool.spawn({
    let count = 0
    while count < 3 {
        received.push(channel.receive())
        count = count + 1
    }
})
while producer.isAlive() or consumer.isAlive() {
    Thread.sleep(1)
}
producer.join()
consumer.join()
Test.assert(received.length, 3)
Test.assert(received[0], 1)
Test.assert(received[2], 3)

// Sleeping tasks do not occupy workers.
let woke = atomic.AtomicI64.new(0)
let sleepers = []
index = 0
while index < 6 {
    sleepers.push(pool.spawn({
        pool.sleep(2000000)
        woke.add(1)
    }))
    index = index + 1
}
sleepers.forEach(|task| {
    while task.isAlive() {
        Thread.sleep(1)
    }
    task.join()
})
Test.assert(woke.load(), 6)

// Many yields resubmit tasks across workers; the VM's debug mount guard
// fails the test if a task is ever mounted twice.
let storms = atomic.AtomicI64.new(0)
let storm = []
index = 0
while index < 4 {
    storm.push(pool.spawn({
        let count = 0
        while count < 50 {
            Thread.yield()
            count = count + 1
        }
        storms.add(1)
    }))
    index = index + 1
}
storm.forEach(|task| {
    while task.isAlive() {
        Thread.sleep(1)
    }
    task.join()
})
Test.assert(storms.load(), 4)

// More sleeping tasks than carriers, with the main thread fully parked: the
// timer thread submits them and must never block on a run-queue lock.
let sleeperCount = 8
let sleepDone = atomic.AtomicI64.new(0)
let selfThread = Thread.current()
index = 0
while index < sleeperCount {
    pool.spawn({
        let count = 0
        while count < 5 {
            pool.sleep(1000000) // 1 ms
            count = count + 1
        }
        if sleepDone.add(1) == sleeperCount {
            selfThread.unpark()
        }
    })
    index = index + 1
}
selfThread.park()
Test.assert(sleepDone.load(), sleeperCount)

pool.shutdown()
Test.assert(pool.isClosed(), true)
