// Iteration protocol: `for` lowering, explicit iterators, fail-fast guards.
// Run:  cargo run -q -p vm -- kette/std/startup.ktt kette/std/functional.ktt kette/kette_tests/test_runner.ktt kette/kette_tests/iterators.ktt
// Check: kette/kette_tests/check.py

use collections.sequence { Sequence }

let s = Sequence.new()
s.add(1)
s.add(2)
s.add(3)

// for loop
let sum = 0
for value in s {
    sum = sum + value
}
Test.assert(sum, 6)

// explicit iterator, including exhaustion
let it = s.iterator()
Test.assert(it.hasNext(), true)
Test.assert(it.next(), 1)
Test.assert(it.next(), 2)
Test.assert(it.next(), 3)
Test.assert(it.hasNext(), false)
let exhausted = try {
    it.next()
} catch (error) {
    error.name
}
Test.assert(exhausted, "NoSuchElementError")

// nested loops
let pairs = Sequence.new()
for a in s {
    for b in s {
        pairs.add(a * 10 + b)
    }
}
Test.assert(pairs.size(), 9)
Test.assert(pairs.get(0), 11)
Test.assert(pairs.get(8), 33)

// break belongs to the innermost loop
let nested_break = 0
for a in s {
    for b in s {
        break
    }
    nested_break = nested_break + 1
}
Test.assert(nested_break, 3)

let inner_value = 0
for a in s {
    inner_value = for b in s { break b }
}
Test.assert(inner_value, 1)

// nested loops may reuse a name; the inner binding shadows the outer one
let shadow_total = 0
for a in s {
    for a in s {
        shadow_total = shadow_total + a
    }
}
Test.assert(shadow_total, 18)

// break leaves the innermost loop and its value becomes the loop result
let stopped = 0
let stopped_at = for value in s {
    if value == 2 {
        break value * 10
    }
    stopped = stopped + value
}
Test.assert(stopped, 1)
Test.assert(stopped_at, 20)

// return crosses the loop
let find_first = |sequence, target| {
    for value in sequence {
        if value == target {
            return value
        }
    }
    0
}
Test.assert(find_first(s, 2), 2)

// structural mutation during for is detected by next()
let mutated = Sequence.new()
mutated.add(1)
mutated.add(2)
let mutated_error = try {
    for value in mutated {
        mutated.add(3)
    }
} catch (error) {
    error.name
}
Test.assert(mutated_error, "ConcurrentModificationError")

// replacing a value is allowed and does not bump the version
let replaced = Sequence.new()
replaced.add(1)
replaced.add(2)
let seen = Sequence.new()
for value in replaced {
    replaced.setAt(0, 9)
    seen.add(value)
}
Test.assert(seen.size(), 2)
Test.assert(seen.get(0), 1)
Test.assert(seen.get(1), 2)

// removing the last element lets the loop end silently, like Java's
// for-each: hasNext() is unchecked and next() is never called again
let tail = Sequence.new()
tail.add(1)
tail.add(2)
let tail_count = 0
for value in tail {
    tail_count = tail_count + 1
    tail.removeLast()
}
Test.assert(tail_count, 1)

// forEach checks after the callback, so even the last element throws
let for_each = Sequence.new()
for_each.add(1)
for_each.add(2)
let for_each_error = try {
    for_each.forEach(|value| { for_each.removeLast() })
} catch (error) {
    error.name
}
Test.assert(for_each_error, "ConcurrentModificationError")

// map/filter go through forEachWithKey and inherit the guard
let mapped = Sequence.new()
mapped.add(1)
mapped.add(2)
let map_error = try {
    mapped.map(Sequence.new(), |value, key| {
        mapped.add(3)
        value
    })
} catch (error) {
    error.name
}
Test.assert(map_error, "ConcurrentModificationError")

// iterator.remove() is the sanctioned mutation and resyncs
let removed = Sequence.new()
removed.add(1)
removed.add(2)
removed.add(3)
let removed_iter = removed.iterator()
Test.assert(removed_iter.next(), 1)
Test.assert(removed_iter.remove(), 1)
Test.assert(removed.size(), 2)
Test.assert(removed_iter.next(), 2)

// null is a valid element, not an exhaustion sentinel
let with_null = Sequence.new()
with_null.add(null)
let null_count = 0
for value in with_null {
    null_count = null_count + 1
}
Test.assert(null_count, 1)

// empty collections simply do not run the body
let empty = Sequence.new()
let empty_count = 0
for value in empty {
    empty_count = empty_count + 1
}
Test.assert(empty_count, 0)

// field patterns work in for, with the same naming rules as `let`
let points = Sequence.new()
points.add({ x: 1, y: 2 })
points.add({ x: 3, y: 4 })
let point_total = 0
for { x, y } in points {
    point_total = point_total + x + y
}
Test.assert(point_total, 10)

let renamed_total = 0
for { x as px, y } in points {
    renamed_total = renamed_total + px - y
}
Test.assert(renamed_total, -2)

// arbitrary iterator objects: only `iterator`, `hasNext`, and `next` matter
let custom = {
    iterator: {
        let it = {
            i: 0
            hasNext: { self.i < 3 }
            next: {
                let value = self.i
                self.i = self.i + 1
                value
            }
        }
        it
    }
}
let custom_sum = 0
for value in custom {
    custom_sum = custom_sum + value
}
Test.assert(custom_sum, 3)

// raw arrays are iterable and expose the collection `size()` name
Test.assert([1, 2, 3].size(), 3)
let array_sum = 0
for value in [1, 2, 3] {
    array_sum = array_sum + value
}
Test.assert(array_sum, 6)

let array_iter = [7, 8].iterator()
Test.assert(array_iter.hasNext(), true)
Test.assert(array_iter.next(), 7)
Test.assert(array_iter.next(), 8)
Test.assert(array_iter.hasNext(), false)
Test.assert(array_iter.next() == undefined, true)

// positional array patterns
let [pa, pb] = [10, 20]
Test.assert(pa, 10)
Test.assert(pb, 20)

// `as` works on array bindings, including when the name is `as`
let [as as renamed, other] = [30, 40]
Test.assert(renamed, 30)
Test.assert(other, 40)

// fixed positions must be present
let short_ok = try {
    let [short_a, short_b] = [50]
    short_b == undefined
} catch (error) {
    true
}
Test.assert(short_ok, true)

// head + tail; the rest is a fresh array
let [head, ...tail] = [1, 2, 3, 4]
Test.assert(head, 1)
Test.assert(tail.length, 3)
Test.assert(tail[0], 2)
Test.assert(tail[2], 4)

let [only, ...empty_tail] = [9]
Test.assert(only, 9)
Test.assert(empty_tail.length, 0)

// nested and mixed patterns
let [[n0, n1], n2] = [[1, 2], 3]
Test.assert(n0, 1)
Test.assert(n1, 2)
Test.assert(n2, 3)

let [{ fx, fy }] = [{ fx: 4, fy: 5 }]
Test.assert(fx, 4)
Test.assert(fy, 5)

// positional patterns work on Sequences too
let sq = Sequence.new()
sq.add(1)
sq.add(2)
sq.add(3)
let [sq0, sq1, sq2] = sq
Test.assert(sq0, 1)
Test.assert(sq1, 2)
Test.assert(sq2, 3)
let [sq_head, ...sq_tail] = sq
Test.assert(sq_head, 1)
Test.assert(sq_tail.length, 2)
Test.assert(sq_tail[0], 2)

// array patterns in for
let rows = Sequence.new()
rows.add([1, 2])
rows.add([3, 4])
let row_total = 0
for [row_a, row_b] in rows {
    row_total = row_total + row_a + row_b
}
Test.assert(row_total, 10)

let array_rows = [[5, 6], [7, 8]]
let array_row_total = 0
for [row_a, row_b] in array_rows {
    array_row_total = array_row_total + row_a + row_b
}
Test.assert(array_row_total, 26)

// keyed pairs can be iterated as arrays
let keyed = [[0, 10], [1, 20]]
let keyed_total = 0
for [key, value] in keyed {
    keyed_total = keyed_total + key * value
}
Test.assert(keyed_total, 20)

// the iterable is an arbitrary expression
let expr_total = 0
for value in if true { [1, 2] } else { [3, 4] } {
    expr_total = expr_total + value
}
Test.assert(expr_total, 3)
