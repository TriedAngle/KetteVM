let plain = |x| { x }
Test.assert(KetteTools.isTailCallable(plain), true)

// Capturing an outer binding is fine; only this frame's own context blocks TCO.
let outer = 1
let captured_outer = |x| { x + outer }
Test.assert(KetteTools.isTailCallable(captured_outer), true)

// A closure over this frame's local forces a context.
let make = |x| {
    let inner = { x }
    0
}
Test.assert(KetteTools.isTailCallable(make), false)

// Rest parameters are not frame-reusable.
let only_rest = { |...rest| rest }
Test.assert(KetteTools.isTailCallable(only_rest), false)

// Capturing self forces a context on the method frame.
let method = {
    loop: |x| {
        let inner = { self }
        x
    }
}
Test.assert(KetteTools.isTailCallable(method.loop), false)

let plain_method = {
    loop: |x| { x }
}
Test.assert(KetteTools.isTailCallable(plain_method.loop), true)

Test.assert(KetteTools.isTailCallable(print), false)

// A local closure recurses through the current callable.
let count = |n| {
    if n == 0 {
        0
    } else {
        selfContext(n - 1)
    }
}
Test.assert(KetteTools.isTailCallable(count), true)
Test.assert(count(100000), 0)

// Method recursion through a slot, with the runtime identity guard.
let object = {
    loop: |n| {
        if n == 0 {
            0
        } else {
            self.loop(n - 1)
        }
    }
}
Test.assert(KetteTools.isTailCallable(object.loop), true)
Test.assert(object.loop(100000), 0)

let explicit = {
    loop: |n| {
        if n == 0 {
            return 0
        }
        return self.loop(n - 1)
    }
}
Test.assert(KetteTools.isTailCallable(explicit.loop), true)
Test.assert(explicit.loop(100000), 0)

// Reassigning the slot must fall back to a normal call.
let guarded = {
    loop: |n| {
        if n == 0 {
            0
        } else {
            self.loop(n - 1)
        }
    }
}
guarded.saved = guarded.loop
guarded.loop = |n| { n + 1 }
Test.assert(guarded.saved(5), 5)

// A tail-recursive helper may capture state from its enclosing frame.
let factory = |limit| {
    let visit = |i| {
        if i >= limit {
            0
        } else {
            selfContext(i + 1)
        }
    }
    visit(0)
}
Test.assert(factory(100000), 0)

// let* makes the recursive binding visible in its own initializer.
let* local = |n| {
    if n == 0 {
        0
    } else {
        local(n - 1)
    }
}
Test.assert(KetteTools.isTailCallable(local), true)
Test.assert(local(100000), 0)
