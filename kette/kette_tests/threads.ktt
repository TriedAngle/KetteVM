// Threads, virtual scheduling, and atomic cells.
// Run: cargo run -q -p vm -- kette/std/startup.ktt kette/kette_tests/threads.ktt
// Check: kette/kette_tests/check.py

use atomic { AtomicI64 }
use threads { Thread }

use ffi

// Main thread surface.
Test.assert(Thread.name(), "main")
Test.assert(Thread.isAlive(), true)
Test.assert(Thread.current(), Thread)
Test.assert(Thread.nanoTime() > 0, true)

let main_thread = Thread.current()
main_thread.unpark()
Test.assert(main_thread.parkNanos(10000000), false)
Test.assert(main_thread.parkNanos(1000000), true)

// Platform thread.
let counter = AtomicI64.new(0)
let worker = {
    let i = 0
    while i < 1000 {
        counter.add(1)
        i = i + 1
    }
}
let platform = Thread.newPlatform("platform", worker)
Test.assert(platform.name(), "platform")
Test.assert(platform.isAlive(), false)
platform.note = 42
Test.assert(platform.note, 42)
platform.start()
platform.join()
Test.assert(platform.isAlive(), false)
Test.assert(counter.load(), 1000)

// Virtual thread object before start, surviving a collection.
let virtual = Thread.newVirtual("virtual", worker)
Test.assert(virtual.name(), "virtual")
Test.assert(virtual.threadId() > 0, true)
Test.assert(virtual.isAlive(), false)
KetteTools.forceMajorGC()
Test.assert(virtual.name(), "virtual")
Test.assert(virtual.isAlive(), false)

// Atomic cells.
let cell = AtomicI64.new(10)
Test.assert(cell.load(), 10)
Test.assert(cell.add(5), 15)
Test.assert(cell.swap(99), 15)
Test.assert(cell.compareExchange(99, 7), 99)
Test.assert(cell.load(), 7)
Test.assert(cell.compareExchange(123, 5), 7)
Test.assert(cell.store(42), 42)
Test.assert(cell.load(), 42)

// Every ThreadObject exposes the same methods.
Test.assert(Thread.availableProcessors() >= 1, true)
let self_tid = AtomicI64.new(-1)
let self_api = {
    let me = Thread.current()
    me.yield()
    me.sleep(0)
    self_tid.store(me.threadId())
}
let self_thread = Thread.newPlatform("self", self_api)
self_thread.start()
self_thread.join()
Test.assert(self_thread.name(), "self")
Test.assert(self_thread.isAlive(), false)
Test.assert(self_thread.threadId(), self_tid.load())

// Virtual threads run under a userspace scheduler.
let queue = {}
let head = 0
let tail = 0
let enqueue = { |thread|
    queue[tail] = thread
    tail = tail + 1
}
let run_scheduler = {
    while head < tail {
        let thread = queue[head]
        head = head + 1
        if thread.isReady() and thread.mount() {
            enqueue(thread)
        }
    }
}

let order = ""
let va = Thread.newVirtual("va", {
    order = order + "a1"
    Thread.yield()
    order = order + "a2"
})
let vb = Thread.newVirtual("vb", {
    order = order + "b1"
    Thread.yield()
    order = order + "b2"
})
enqueue(va)
enqueue(vb)
let scheduler_thread = Thread.newPlatform("scheduler", run_scheduler)
scheduler_thread.start()
scheduler_thread.join()
Test.assert(order, "a1b1a2b2")
Test.assert(va.isAlive(), false)
Test.assert(vb.isAlive(), false)

// Thread.current() names the virtual thread, not the platform scheduler.
let child_name = ""
let vc = Thread.newVirtual("vc", {
    child_name = Thread.current().name()
    Thread.yield()
})
enqueue(vc)
let name_scheduler = Thread.newPlatform("name-scheduler", run_scheduler)
name_scheduler.start()
name_scheduler.join()
Test.assert(child_name, "vc")

// A ready task survives GC while mounted.
let gc_order = ""
let gva = Thread.newVirtual("gva", {
    gc_order = gc_order + "a"
    Thread.yield()
    KetteTools.forceMajorGC()
    gc_order = gc_order + "b"
})
enqueue(gva)
let gc_scheduler = Thread.newPlatform("gc-scheduler", run_scheduler)
gc_scheduler.start()
gc_scheduler.join()
Test.assert(gc_order, "ab")
Test.assert(gva.isAlive(), false)

// Suspension inside a nested VM entry.
let eval_result = 0
let ve = Thread.newVirtual("ve", {
    eval_result = KetteTools.eval("kette", "use threads { Thread }\nThread.yield()\n7")
})
enqueue(ve)
let eval_scheduler = Thread.newPlatform("eval-scheduler", run_scheduler)
eval_scheduler.start()
eval_scheduler.join()
Test.assert(eval_result, 7)

// Platform carriers also sleep cooperatively and wake on interrupt.
let psleep = Thread.newPlatform("psleep", {
    Thread.sleep(10000)
})
psleep.start()
psleep.interrupt()
psleep.join()
Test.assert(psleep.isInterrupted(), true)

// C callbacks suspend on the task stack and return through C frames.
let { void, i32, u64, ... } = ffi
let libc = ffi.library(null)
let Comparator = ffi.fn([ffi.Ptr, ffi.Ptr], i32)
let qsort = libc.fn(
    "qsort",
    [ffi.pointer(i32), u64, u64, ffi.pointer(Comparator)],
    void,
)
let compare = Comparator.callback({ |left, right|
    Thread.yield()
    let a = left.cast(i32).get(0)
    let b = right.cast(i32).get(0)
    if a < b {
        -1
    } else if a > b {
        1
    } else {
        0
    }
})
let ffi_values = ffi.array(i32, 4).new()
ffi_values.set(0, 3)
ffi_values.set(1, 1)
ffi_values.set(2, 2)
ffi_values.set(3, 0)
qsort(ffi_values, 4, 4, compare)
Test.assert(ffi_values.get(0), 0)
Test.assert(ffi_values.get(3), 3)
ffi_values.free()
