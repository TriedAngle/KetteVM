// Deadline scheduler and virtual-thread parking.
// Run:  cargo run -q -p vm -- kette/std/startup.ktt kette/kette_tests/timer.ktt
// Check: kette/kette_tests/check.py

use atomic { AtomicI64 }
use threads { Thread }

use collections.delay_scheduler { DelayScheduler }
use collections.queue { Queue }

let scheduler = DelayScheduler.new()


let fired = Queue.new()
let record = { |value|
    fired.push(value)
}

scheduler.schedule(20000000, { record("late") })
scheduler.schedule(5000000, { record("early") })
while fired.size() < 2 {
    Thread.sleep(1)
}
Test.assert(fired.take(), "early")
Test.assert(fired.take(), "late")

let cancelled = AtomicI64.new(0)
let timer = scheduler.schedule(20000000, {
    cancelled.store(1)
})
scheduler.cancel(timer)
Thread.sleep(30)
Test.assert(cancelled.load(), 0)

let start = Thread.nanoTime()
scheduler.parkNanos(10000000)
Test.assert(Thread.nanoTime() - start >= 5000000, true)

let sleepStart = Thread.nanoTime()
scheduler.sleep(5000000)
Test.assert(Thread.nanoTime() - sleepStart >= 3000000, true)

scheduler.shutdown()
Test.assert(scheduler.isClosed(), true)
