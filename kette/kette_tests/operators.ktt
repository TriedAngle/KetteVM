// Binary operators
// Run:  cargo run -q -p vm -- kette/kette_tests/operators.ktt
// Check: kette/kette_tests/check.py

Test.assert(1 + 2 * 3, 7)
Test.assert(10 - 3, 7)
Test.assert(3 - 10, -7)
Test.assert(5 % 3, 2)
Test.assert((10 - 3) % 4, 3)

Test.assert(1 < 2, true)
Test.assert(2 < 1, false)
Test.assert(2 <= 2, true)
Test.assert(3 > 2, true)
Test.assert(3 >= 3, true)
Test.assert(1 == 1, true)
Test.assert(1 != 2, true)
Test.assert(1 == 2, false)
Test.assert(1 != 1, false)

let x = 5
let y = 0 - x
Test.assert(-y, 5)
Test.assert(!(1 == 2), true)

// Shifts and bitwise operators.
Test.assert(1 <<< 4, 16)
Test.assert(-16 >>> 2, -4)
Test.assert(~~~0, -1)
Test.assert(6 &&& 3, 2)
Test.assert(6 ||| 3, 7)
Test.assert(6 ^^^ 3, 5)
// Shifts bind looser than addition; bitwise binds tighter than ==.
Test.assert(1 + 2 <<< 1, 6)
Test.assert(0 &&& 1 == 1, false)

// Equality is value based, without JavaScript coercion.
Test.assert(1 == 1.0, true)
Test.assert(1 == "1", false)
Test.assert("1" == 1, false)
Test.assert(null == undefined, true)
Test.assert(null == 0, false)
Test.assert(true == 1, false)
Test.assert("a" == "a", true)
Test.assert("a" != "b", true)
let object = {}
let other = {}
Test.assert(object == object, true)
Test.assert(object == other, false)

// String concatenation and ordering.
Test.assert("a" + "b", "ab")
Test.assert("x" + 1, "x1")
Test.assert("a" < "b", true)

// Compound assignment goes through the same operator methods.
let a = 1
a <<<= 3
Test.assert(a, 8)
let b = 2
b += 5
Test.assert(b, 7)

// Operators are ordinary methods and can be overridden.
let over = {
    `+`: { |other| 42 }
}
Test.assert(over + 1, 42)
let weird = {
    `!`: { false }
}
Test.assert(!weird, false)

let m = 6
m &&&= 3
Test.assert(m, 2)
m |||= 1
Test.assert(m, 3)
m ^^^= 1
Test.assert(m, 2)

let flag = true
flag and= false
Test.assert(flag, false)
let text = "x"
text or= "y"
Test.assert(text, "x")

let c = 10
c -= 3
Test.assert(c, 7)
let d = 3
d *= 4
Test.assert(d, 12)
let e = 9
e /= 3
Test.assert(e, 3)
let f = 7
f %= 4
Test.assert(f, 3)
let g = 8
g >>>= 2
Test.assert(g, 2)
let s = "x"
s += 1
Test.assert(s, "x1")
