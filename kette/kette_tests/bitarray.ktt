// BitArray construction, views, and bit-syntax matching.
// Run:  cargo run -q -p vm -- kette/kette_tests/bitarray.ktt
// Check: kette/kette_tests/check.py

let header = <<9:4, 5:4>>
Test.assert(header.bitSize(), 8)
Test.assert(header.byteSize(), 1)
Test.assert(header.isBinary(), true)
Test.assert(header == <<149:8>>, true)
Test.assert(header == header.copy(), true)

let sub = header.slice(4, 8)
Test.assert(sub.bitSize(), 4)
Test.assert(sub.at(0), false)
Test.assert(sub == <<5:4>>, true)

let bits = <<1:1, 0:3, 9:4>>
Test.assert(bits.bitSize(), 8)
Test.assert(bits.byteSize(), 1)

let text = <<"abc">>
Test.assert(text.bitSize(), 24)
Test.assert(text.byteSize(), 3)
Test.assert(text.isBinary(), true)

let joined = <<1:4>> <> <<2:4>>
Test.assert(joined.bitSize(), 8)
Test.assert(joined == <<18:8>>, true)
Test.assert(joined == (<<1:4>>).concat(<<2:4>>), true)

let swapped = <<1:8, 2:8>> <> <<>>
Test.assert(swapped.bitSize(), 16)
Test.assert(swapped == <<1:8, 2:8>>, true)

let little = <<1:16/little>>
Test.assert(little == <<1:8, 0:8>>, true)
match little {
    <<value:16/little>> => Test.assert(value, 1)
    _ => Test.assert(0, 1)
}

let masked = (<<170:8, 255:8>>).xor(<<15:8, 15:8>>)
Test.assert(masked, <<165:8, 240:8>>)

let empty = <<>>
Test.assert(empty.bitSize(), 0)
Test.assert(empty.isBinary(), true)
match empty {
    <<>> => Test.assert(1, 1)
    _ => Test.assert(0, 1)
}

match bits {
    <<1:1, 0:3, op:4>> => Test.assert(op, 9)
    _ => Test.assert(0, 1)
}

let frame = <<1:1, 0:3, 1:4, 0:1, 2:7, "hi"/binary>>
Test.assert(frame.bitSize(), 32)
match frame {
    <<1:1, 0:3, op:4, 0:1, len:7, data:len/binary, rest/bitstring>> => {
        Test.assert(op, 1)
        Test.assert(len, 2)
        Test.assert(data.byteSize(), 2)
        Test.assert(rest.bitSize(), 0)
    }
    _ => Test.assert(0, 1)
}

let sized = <<2:8, 170:8, 187:8, 204:8>>
match sized {
    <<len:8, data:len/binary, rest/bitstring>> => {
        Test.assert(len, 2)
        Test.assert(data.byteSize(), 2)
        Test.assert(rest.bitSize(), 8)
    }
    _ => Test.assert(0, 1)
}

let short = <<1:8, 2:8>>
match short {
    <<1:8>> => Test.assert(0, 1)
    <<1:8, rest/bitstring>> => Test.assert(rest.bitSize(), 8)
    _ => Test.assert(0, 1)
}

match short {
    <<0:4, rest/bitstring>> => {
        Test.assert(rest.bitSize(), 12)
        Test.assert(rest.isBinary(), false)
    }
    _ => Test.assert(0, 1)
}

match short {
    <<0:4, rest/binary>> => Test.assert(0, 1)
    _ => Test.assert(1, 1)
}

let signed = <<255:8>>
match signed {
    <<value:8/signed>> => Test.assert(value, -1)
    _ => Test.assert(0, 1)
}

let nested = { frame: <<1:1, 0:3, 9:4>> }
match nested {
    { frame: <<1:1, 0:3, op:4>> } => Test.assert(op, 9)
    _ => Test.assert(0, 1)
}

let notBits = 42
match notBits {
    <<value:8>> => Test.assert(0, 1)
    _ => Test.assert(1, 1)
}

let five = <<5:3>>
Test.assert(five.bitSize(), 3)
Test.assert(five == <<5:3>>, true)
Test.assert(five == <<5:3, 0:1>>, false)

let inner = <<1:4, 2:4>>
let outer = <<inner/binary, 3:8>>
Test.assert(outer.bitSize(), 16)
Test.assert(outer == <<18:8, 3:8>>, true)

let unaligned = <<1:3>>
let failed = false
try {
    <<unaligned/binary>>
} catch (e) {
    failed = true
}
Test.assert(failed, true)

let littleFailed = false
try {
    <<1:12/little>>
} catch (e) {
    littleFailed = true
}
Test.assert(littleFailed, true)

let root = <<1:1, 0:3, 9:4>>
let view = root.slice(0, 4)
KetteTools.forceMajorGC()
Test.assert(view.bitSize(), 4)
Test.assert(view.at(0), true)
Test.assert(root.bitSize(), 8)

let collected = <<2:8, 170:8, 187:8, 204:8>>
let collectedView = collected.slice(8, 24)
KetteTools.forceMajorGC()
Test.assert(collectedView.bitSize(), 16)
match collected {
    <<len:8, data:len/binary, rest/bitstring>> => {
        Test.assert(len, 2)
        Test.assert(data.byteSize(), 2)
        Test.assert(rest.bitSize(), 8)
    }
    _ => Test.assert(0, 1)
}

match bits {
    <<1:1, 0:3, op:4>> if op == 9 => Test.assert(op, 9)
    _ => Test.assert(0, 1)
}

match bits {
    <<8:4, x/bitstring>> | <<1:4, x/bitstring>> => Test.assert(x.bitSize(), 4)
    _ => Test.assert(0, 1)
}

let <<first:4, second:4>> = bits
Test.assert(first, 8)
Test.assert(second, 9)

let unit = <<1:2/unit:4>>
Test.assert(unit.bitSize(), 8)
Test.assert(unit == <<1:8>>, true)

let f64 = <<12.5:64/float>>
Test.assert(f64.byteSize(), 8)
match f64 {
    <<value:64/float>> => Test.assert(value, 12.5)
    _ => Test.assert(0, 1)
}

let f32 = <<12.5:32/float>>
Test.assert(f32.byteSize(), 4)
match f32 {
    <<value:32/float>> => Test.assert(value, 12.5)
    _ => Test.assert(0, 1)
}

let f16 = <<12.5:16/float>>
Test.assert(f16.byteSize(), 2)
match f16 {
    <<value:16/float>> => Test.assert(value, 12.5)
    _ => Test.assert(0, 1)
}

let f16max = <<65504:16/float>>
let f16over = <<65505:16/float>>
Test.assert(f16max == f16over, true)

let f32little = <<12.5:32/float-little>>
match f32little {
    <<value:32/float-little>> => Test.assert(value, 12.5)
    _ => Test.assert(0, 1)
}

let utf16 = <<"foo"/utf16>>
Test.assert(utf16.byteSize(), 6)
match utf16 {
    <<first:2/bytes, rest:4/bytes>> => {
        Test.assert(first, <<0:8, 102:8>>)
        Test.assert(rest, <<0:8, 111:8, 0:8, 111:8>>)
    }
    _ => Test.assert(0, 1)
}

let utf32 = <<"bar"/utf32>>
Test.assert(utf32.byteSize(), 12)
match utf32 {
    <<first:4/bytes, rest:8/bytes>> => {
        Test.assert(first, <<0:8, 0:8, 0:8, 98:8>>)
        Test.assert(rest.byteSize(), 8)
    }
    _ => Test.assert(0, 1)
}

let utf16little = <<"foo"/utf16-little>>
Test.assert(utf16little.byteSize(), 6)
Test.assert(utf16little == <<102:8, 0:8, 111:8, 0:8, 111:8, 0:8>>, true)

let euro = <<8364:8/utf8>>
Test.assert(euro.byteSize(), 3)
match euro {
    <<codepoint:8/utf8>> => Test.assert(codepoint, 8364)
    _ => Test.assert(0, 1)
}

let emoji = <<128512:8/utf8>>
Test.assert(emoji.byteSize(), 4)
match emoji {
    <<codepoint:8/utf8>> => Test.assert(codepoint, 128512)
    _ => Test.assert(0, 1)
}

let emoji16 = <<128512:16/utf16>>
Test.assert(emoji16.byteSize(), 4)
match emoji16 {
    <<codepoint:16/utf16>> => Test.assert(codepoint, 128512)
    _ => Test.assert(0, 1)
}

let emoji16little = <<128512:16/utf16-little>>
Test.assert(emoji16little.byteSize(), 4)
match emoji16little {
    <<codepoint:16/utf16-little>> => Test.assert(codepoint, 128512)
    _ => Test.assert(0, 1)
}

let emoji32 = <<128512:32/utf32>>
Test.assert(emoji32.byteSize(), 4)
match emoji32 {
    <<codepoint:32/utf32>> => Test.assert(codepoint, 128512)
    _ => Test.assert(0, 1)
}

let outerSize = 1
let <<outer:outerSize/binary>> = <<25:8>>
Test.assert(outer.bitSize(), 8)

let outerCount = 4
match <<73:8>> {
    <<count:4, value:outerCount/binary>> => Test.assert(0, 1)
    <<count:4, value:count>> => {
        Test.assert(count, 4)
        Test.assert(value, 9)
    }
    _ => Test.assert(0, 1)
}

let order1 = <<1:16/signed-little-integer>>
let order2 = <<1:16/integer-signed-little>>
let order3 = <<1:16/signed-integer-little>>
Test.assert(order1 == order2, true)
Test.assert(order2 == order3, true)

let nestedLiteral = <<1:8, <<2:8, 3:8>>/bitstring>>
Test.assert(nestedLiteral.bitSize(), 24)
match nestedLiteral {
    <<1:8, value:16/bitstring>> => Test.assert(value.byteSize(), 2)
    _ => Test.assert(0, 1)
}

let badUtf = false
try {
    <<55296:8/utf8>>
} catch (e) {
    badUtf = true
}
Test.assert(badUtf, true)

let badFloat = false
try {
    <<1:8/float>>
} catch (e) {
    badFloat = true
}
Test.assert(badFloat, true)

let <<temperature:4, _:1, humidity:3>> = <<247:8>>
Test.assert(temperature, 15)
Test.assert(humidity, 7)

Test.assert(<<257:8>> == <<1:8>>, true)
Test.assert(<<257:9>>.bitSize(), 9)
match <<257:9>> {
    <<value:9>> => Test.assert(value, 257)
    _ => Test.assert(0, 1)
}
Test.assert(<<257:10>>.bitSize(), 10)
Test.assert(<<257:10>>.isBinary(), false)

Test.assert(<<"foo">> == <<"Foo">>, false)
Test.assert(<<1:8, 2:8>> == <<1:8, 2:8>>, true)
Test.assert(<<1:16/native>>.bitSize(), 16)
Test.assert(<<1:16/big>> == <<0:8, 1:8>>, true)
Test.assert(<<1:8/unsigned>> == <<1:8>>, true)
match <<1:8, 2:8>> {
    <<first:8, rest/bits>> => Test.assert(rest.bitSize(), 8)
    _ => Test.assert(0, 1)
}

match <<12.5:64/float>> {
    <<12.5:64/float>> => Test.assert(1, 1)
    _ => Test.assert(0, 1)
}
match <<12.5:32/float>> {
    <<13.5:32/float>> => Test.assert(0, 1)
    _ => Test.assert(1, 1)
}
match <<12.5:16/float>> {
    <<-12.5:16/float>> => Test.assert(0, 1)
    _ => Test.assert(1, 1)
}

Test.assert(<<54:8, 77:8>>.toString(), "<<54, 77>>")
Test.assert(<<1:4, 2:4>>.toString(), "<<18>>")
Test.assert(<<5:3>>.toString(), "<<5:3>>")
Test.assert(<<>>.toString(), "<<>>")
