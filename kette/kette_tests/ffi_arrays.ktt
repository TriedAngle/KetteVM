// C arrays, array element access, and pointer arithmetic/indexing.
// Run:  cargo run -q -p vm -- kette/std/startup.ktt kette/kette_tests/ffi_arrays.ktt
// Check: kette/kette_tests/check.py

use ffi
Test.assert(ffi.pointer, KetteTools.primitives.ffi.pointer)
Test.assert(globalThis.FFI, undefined)

let { struct, i32, u64, CString, ... } = ffi
let I32x4 = ffi.array(i32, 4)
let values = I32x4.new()
values.set(0, 7)
values.set(3, 9)
Test.assert(values.get(0), 7)
Test.assert(values.get(1), 0)
Test.assert(values.get(3), 9)

// C values are disposable: `with` frees owned storage but leaves views alone.
let scoped = with(I32x4.new(), |slice| {
    slice.set(0, 5)
    slice.get(0)
})
Test.assert(scoped, 5)
let borrowed = with(values.add(0), |view| { view.get(0) })
Test.assert(borrowed, 7)
let sized = I32x4.new()
Test.assert(sized.size(), 16)
sized.free()

// A value view can be offset like a pointer.
Test.assert(values.get(3), 9)
values.set(1, 42)
Test.assert(values.get(1), 42)

// C arrays support Kette index syntax.
values[0] = 11
Test.assert(values[0], 11)
values[0] = 7

let advanced = values.add(2)
Test.assert(advanced.get(0), 0)
Test.assert(advanced.get(1), 9)

// Typed pointer writes go through the pointee type.
advanced.set(0, 11)
Test.assert(values.get(2), 11)

// char* pointer arithmetic reads bytes
let text = ffi.cstring("abc")
Test.assert(text.get(0), 97)
Test.assert(text.add(1).get(0), 98)
Test.assert(text.add(2).get(0), 99)
Test.assert(text.add(3).get(0), 0)

// struct fields are addressable by name; a pointer to a struct yields
// struct values (copies) when indexed
let Point = struct({ x: i32, y: i32 })
let point = Point.new(3, 5)
Test.assert(point.get("x"), 3)
Test.assert(point.get("y"), 5)
Test.assert(point.x, 3)
Test.assert(point.y, 5)
point.x = 11
Test.assert(point.x, 11)
Test.assert(point.get("x"), 11)
point.set("x", 8)
Test.assert(point.get("x"), 8)

// aggregate fields are zero-copy views: writes go through
let Vec2 = struct({ x: i32, y: i32 })
let Rect = struct({ origin: Vec2, size: Vec2 })
let rect = Rect.new()
rect.origin.x = 7
rect.size.y = 9
Test.assert(rect.origin.x, 7)
Test.assert(rect.size.y, 9)
Test.assert(rect.get("origin").x, 7)

// copy detaches
let detached = point.copy()
detached.x = 99
Test.assert(point.x, 8)
Test.assert(detached.x, 99)

// pointer to pointer
let I32p = ffi.pointer(i32)
let slot = ffi.array(I32p, 1).new()
slot.set(0, values)
let back = slot.get(0)
Test.assert(back.get(0), 7)

// UTF-16 C strings and explicit string readers
let wtext = ffi.wstring("h€")
Test.assert(ffi.wstring_at(wtext), "h€")

let ascii = ffi.cstring("hello")
Test.assert(ffi.string_at(ascii), "hello")

// guest strings marshal directly to char* parameters
let libc = ffi.library(null)
let strlen = libc.fn("strlen", [CString], u64)
Test.assert(strlen("hello"), 5)
Test.assert(strlen("héllo"), 6)
Test.assert(strlen(ascii), 5)

// C enums map atom names to integers and carry their underlying type
let Color = ffi.enum({ RED: 0, GREEN: 1, BLUE: 2 })
Test.assert(Color.RED, :RED)
Test.assert(Color["RED"], :RED)
Test.assert(Color[:RED], 0)
Test.assert(Color.value(:RED) + Color.value(:GREEN) + Color.value(:BLUE), 3)
Test.assert(Color.fromValue(2), :BLUE)
Test.assert(ffi.array(Color.type, 2).size(), 8)
Test.assert(Color.base, ffi.i32)

let Tiny = ffi.enum(ffi.i8, { A: 0, B: 7 })
Test.assert(Tiny.B, :B)
Test.assert(Tiny[:B], 7)
Test.assert(Tiny.value(:B), 7)
Test.assert(Tiny.fromValue(7), :B)
Test.assert(Tiny.base, ffi.i8)
Test.assert(ffi.array(Tiny.type, 2).size(), 2)

// Enum-typed calls, arrays, and struct fields translate atoms automatically.
let Signed = ffi.enum(ffi.i32, { NEG: -5, POS: 5 })
let libc = ffi.library(null)
let abs = libc.fn("abs", [Signed.type], Signed.type)
Test.assert(abs(:NEG), :POS)

let enum_values = ffi.array(Signed.type, 1).new()
enum_values.set(0, :NEG)
Test.assert(enum_values.get(0), :NEG)

let SignedPoint = struct({ color: Signed.type, x: i32 })
let signed_point = SignedPoint.new()
signed_point.color = :POS
Test.assert(signed_point.color, :POS)
Test.assert(signed_point.get("color"), :POS)
