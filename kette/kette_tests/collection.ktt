// Collection behavior and the growable Sequence.
// Run:  cargo run -q -p vm -- kette/std/error.ktt kette/std/collection.ktt kette/kette_tests/collection.ktt
// Check: kette/kette_tests/check.py

let seq = |values| {
    let result = Sequence.new()
    let i = 0
    while i < values.length {
        result.add(values[i])
        i = i + 1
    }
    result
}

let empty = Sequence.new()
Test.assert(empty.size(), 0)
Test.assert(empty.isEmpty(), true)
Test.assert(empty.nonEmpty(), false)
Test.assert(empty.firstOrElse({ null }), null)
Test.assert(empty.lastOrElse({ null }), null)
Test.assert(empty.getOrElse(3, { null }), null)
Test.assert(empty.firstOrElse({ "none" }), "none")

let empty_first = try {
    empty.first()
} catch (error) {
    error.name
}
Test.assert(empty_first, "RangeError")

let s = Sequence.new()
s.add(2)
s.add(3)
s.add(4)
Test.assert(s.size(), 3)
Test.assert(s.nonEmpty(), true)
Test.assert(s.get(0), 2)
Test.assert(s.get(2), 4)
Test.assert(s.first(), 2)
Test.assert(s.last(), 4)
Test.assert(s.contains(3), true)
Test.assert(s.contains(9), false)
Test.assert(s.includesAll(seq([2, 4])), true)
Test.assert(s.includesAll(seq([2, 9])), false)
Test.assert(s.occurrencesOf(3), 1)
Test.assert(s.occurrencesOf(9), 0)

let t = Sequence.new()
t.addAll(s)
Test.assert(t.size(), 3)
Test.assert(t.get(1), 3)

s.addFirst(1)
s.addLast(5)
Test.assert(s.size(), 5)
Test.assert(s.get(0), 1)
Test.assert(s.get(4), 5)
Test.assert(s.removeFirst(), 1)
Test.assert(s.removeLast(), 5)
Test.assert(s.size(), 3)

Test.assert(s.setAt(1, 9), 9)
Test.assert(s.get(1), 9)
Test.assert(s.removeAt(1), 9)
Test.assert(s.get(1), 4)
s.add(3)
s.remove(3)
Test.assert(s.contains(3), false)
Test.assert(s.size(), 2)

let total = 0
s.forEach(|value| { total = total + value })
Test.assert(total, 6)


Test.assert(s.indexOf(4), 1)
Test.assert(s.indexOfOrElse(9, { -1 }), -1)
Test.assert(s.keys().size(), 2)
Test.assert(s.keys().get(1), 1)
Test.assert(s.findFirst(|value| { value > 2 }), 4)
Test.assert(s.findFirstOrElse(|value| { value > 9 }, { -1 }), -1)
Test.assert(s.allSatisfy(|value| { value > 0 }), true)
Test.assert(s.anySatisfy(|value| { value > 3 }), true)
Test.assert(s.noneSatisfy(|value| { value > 9 }), true)
Test.assert(s.sum(), 6)
Test.assert(s.min(), 2)
Test.assert(s.max(), 4)
Test.assert(s.product(), 8)

let missing = try {
    s.findFirst(|value| { value > 9 })
} catch (error) {
    error.name
}
Test.assert(missing, "RangeError")

let single = Sequence.new()
single.add(7)
Test.assert(single.soleElement(), 7)

let not_single = try {
    s.soleElement()
} catch (error) {
    error.name
}
Test.assert(not_single, "RangeError")

let copied = s.copy()
Test.assert(copied.size(), 2)
Test.assert(copied.get(1), 4)
copied.add(9)
Test.assert(s.size(), 2)

let copied_containing = s.copyContaining(seq([1, 2, 3]))
Test.assert(copied_containing.size(), 3)
Test.assert(copied_containing.get(2), 3)

let mapped = s.map(|value| { value * 2 })
Test.assert(mapped.size(), 2)
Test.assert(mapped.get(0), 4)
Test.assert(mapped.get(1), 8)

let filtered = s.filter(|value| { value > 2 })
Test.assert(filtered.size(), 1)
Test.assert(filtered.get(0), 4)

let reversed = s.copyReversed()
Test.assert(reversed.get(0), 4)
Test.assert(reversed.get(1), 2)

let reverse_total = 0
s.forEachReverse(|value| { reverse_total = reverse_total * 10 + value })
Test.assert(reverse_total, 42)

let pair_total = 0
s.with(seq([10, 20]), |left, right| { pair_total = pair_total + left + right })
Test.assert(pair_total, 36)

let q = Sequence.new()
let i = 0
while i < 20 {
    q.addFirst(i)
    i = i + 1
}
Test.assert(q.size(), 20)
Test.assert(q.get(0), 19)
Test.assert(q.get(19), 0)
i = 0
while i < 20 {
    Test.assert(q.removeFirst(), 19 - i)
    i = i + 1
}
Test.assert(q.isEmpty(), true)

let empty_remove = try {
    q.removeFirst()
} catch (error) {
    error.name
}
Test.assert(empty_remove, "RangeError")

let filled = Sequence.new()
filled.add(1)
filled.add(2)
filled.add(3)
filled.fill(7)
Test.assert(filled.get(0), 7)
Test.assert(filled.get(1), 7)
Test.assert(filled.get(2), 7)

let inserted = Sequence.new()
inserted.add(1)
inserted.add(3)
inserted.insert(1, 2)
Test.assert(inserted.size(), 3)
Test.assert(inserted.get(1), 2)
Test.assert(inserted.removeAt(1), 2)
Test.assert(inserted.get(1), 3)

let inserted_all = Sequence.new()
inserted_all.add(1)
inserted_all.insertAll(1, seq([2, 3]))
Test.assert(inserted_all.size(), 3)
Test.assert(inserted_all.get(1), 2)
Test.assert(inserted_all.get(2), 3)

let prepended = Sequence.new()
prepended.add(3)
prepended.addAllFirst(seq([1, 2]))
Test.assert(prepended.size(), 3)
Test.assert(prepended.get(0), 1)
Test.assert(prepended.get(1), 2)
Test.assert(prepended.get(2), 3)

let removed_range = Sequence.new()
removed_range.addAll(seq([1, 2, 3, 4]))
removed_range.removeRange(1, 3)
Test.assert(removed_range.size(), 2)
Test.assert(removed_range.get(0), 1)
Test.assert(removed_range.get(1), 4)

let reverse = Sequence.new()
reverse.addAll(seq([1, 2, 3]))
reverse.reverse()
Test.assert(reverse.get(0), 3)
Test.assert(reverse.get(1), 2)
Test.assert(reverse.get(2), 1)

let remove_all = Sequence.new()
remove_all.addAll(seq([1, 2, 3]))
remove_all.removeAll(seq([1, 3]))
Test.assert(remove_all.size(), 1)
Test.assert(remove_all.get(0), 2)

let cleared = Sequence.new()
cleared.add(1)
cleared.add(2)
cleared.clear()
Test.assert(cleared.isEmpty(), true)

let missing_remove = try {
    s.remove(99)
} catch (error) {
    error.name
}
Test.assert(missing_remove, "RangeError")

let missing_get = try {
    s.get(99)
} catch (error) {
    error
}
Test.assert(missing_get.name, "RangeError")
Test.assert(missing_get.index, 99)
Test.assert(missing_get.length, 2)

let missing_set = try {
    s.setAt(99, 1)
} catch (error) {
    error.name
}
Test.assert(missing_set, "RangeError")

let missing_remove_at = try {
    s.removeAt(99)
} catch (error) {
    error.name
}
Test.assert(missing_remove_at, "RangeError")

let missing_insert = try {
    s.insert(99, 1)
} catch (error) {
    error.name
}
Test.assert(missing_insert, "RangeError")

Test.assert(s.lastIndex(), 1)

let compacted = Sequence.new()
let j = 0
while j < 10 {
    compacted.addFirst(j)
    j = j + 1
}
compacted.compress()
Test.assert(compacted.size(), 10)
Test.assert(compacted.get(0), 9)
Test.assert(compacted.get(9), 0)

let removed_present = Sequence.new()
removed_present.addAll(seq([1, 2, 3]))
Test.assert(removed_present.removeIfPresent(2), true)
Test.assert(removed_present.removeIfPresent(2), false)
Test.assert(removed_present.size(), 2)
