// Mutex exclusion across platform threads.
// Run:  cargo run -q -p vm -- kette/std/sync.ktt kette/kette_tests/sync.ktt
// Check: kette/kette_tests/check.py

let m = Mutex.new()
let counter = 0
let worker = {
    let i = 0
    while i < 1000 {
        m.lock()
        counter = counter + 1
        m.unlock()
        i = i + 1
    }
}
let a = Thread.newPlatform("a", worker)
let b = Thread.newPlatform("b", worker)
a.start()
b.start()
a.join()
b.join()
Test.assert(counter, 2000)

let try_mutex = Mutex.new()
Test.assert(try_mutex.tryLock(), true)
Test.assert(try_mutex.tryLock(), false)
try_mutex.unlock()
Test.assert(try_mutex.tryLockNanos(1000000), true)
try_mutex.unlock()

let recursive = RecursiveMutex.new()
recursive.lock()
recursive.lock()
Test.assert(recursive.tryLock(), true)
recursive.unlock()
recursive.unlock()
recursive.unlock()
Test.assert(recursive.tryLock(), true)
recursive.unlock()
let not_owner = try {
    recursive.unlock()
} catch (error) {
    error.name
}
Test.assert(not_owner, "IllegalLockState")

let condition = Condition.new()
let condition_mutex = Mutex.new()
condition_mutex.lock()
Test.assert(condition.awaitNanos(condition_mutex, 1000000), false)
condition_mutex.unlock()

let signalled = false
let waiting = atomic.AtomicI64.new(0)
let condition_consumer = {
    condition_mutex.lock()
    waiting.store(1)
    while !signalled {
        condition.await(condition_mutex)
    }
    condition_mutex.unlock()
}
let condition_thread = Thread.newPlatform("condition", condition_consumer)
condition_thread.start()
while waiting.load() == 0 {
    Thread.yield()
}
condition_mutex.lock()
signalled = true
condition.signal()
condition_mutex.unlock()
condition_thread.join()
Test.assert(signalled, true)
