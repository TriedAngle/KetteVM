// Pipeline operator.
// Run:  cargo run -q -p vm -- kette/std/startup.ktt kette/kette_tests/pipe.ktt
// Check: kette/kette_tests/check.py

let double = |value| { value * 2 }
let add = |left, right| { left + right }
let sum4 = |a, b, c, d| { a + b + c + d }

Test.assert(1 |> double, 2)
Test.assert(1 |> double(), 2)
Test.assert(1 |> add(2), 3)
Test.assert(1 |> double() |> add(3), 5)
Test.assert(1 |> sum4(2, 3, 4), 10)

let math = {
    add: |left, right| { left + right }
    scale: |value, factor| { value * factor }
}
Test.assert(1 |> math.add(2), 3)
Test.assert(2 |> math.scale(3), 6)

let identity = |value| { value }
Test.assert(1 |> identity |> identity, 1)

let matched = 3 |> match {
    1 => 10
    3 => 30
    _ => 0
}
Test.assert(matched, 30)

let guarded = 5 |> match {
    value if value > 3 => value * 2
    _ => 0
}
Test.assert(guarded, 10)

let chainedMatch = 2 |> double() |> match {
    4 => "four"
    _ => "other"
}
Test.assert(chainedMatch, "four")
