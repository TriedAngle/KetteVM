let pack = { |a, ...rest| rest }
let packed = pack(1, 2, 3)
Test.assert(packed.length, 2)
Test.assert(packed[0], 2)
Test.assert(packed[1], 3)

let only_rest = { |...rest| rest }
Test.assert(only_rest().length, 0)
Test.assert(only_rest(1).length, 1)
Test.assert(only_rest(1, 2, 3)[2], 3)

let fixed_missing = { |a, ...rest| a }
Test.assert(fixed_missing(), None)
Test.assert(fixed_missing(1, 2), 1)

let first = only_rest(1, 2)
let second = only_rest(1, 2)
first[0] = 99
Test.assert(second[0], 1)

let base = {
    n: 10
    |a, ...rest| self.n + rest.length
}
let child = { parent*: base; n: 20 }
Test.assert(child(1, 2, 3, 4), 23)

let holder = {
    count: { |a, ...rest| rest.length }
}
Test.assert(holder.count(1, 2, 3), 2)

let capture = { |...rest| { rest.length } }
Test.assert(capture(1, 2, 3)(), 3)

let with_let = { |a, ...rest| let n = rest.length; n + a }
Test.assert(with_let(1, 2, 3), 3)
