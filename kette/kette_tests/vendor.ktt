// Run:  cargo run -q -p vm -- kette/std/startup.ktt kette/kette_tests/test_runner.ktt kette/kette_tests/vendor.ktt
// Check: kette/kette_tests/check.py

// sys is a std module loaded by startup.
use sys { raw }

Test.assert(Modules.sys.raw, raw)
Test.assert(raw.lib != null, true)

raw.srand(1)
Test.assert(raw.rand() >= 0, true)

// Vendor modules are not loaded by startup.
Test.assert(Modules.vendor, undefined)

// Graphics vendor modules are optional: load them when their native
// libraries are available, but don't make the suite depend on them.
let tgpu_loaded = false
try {
    KetteTools.evalFile("kette/vendor/tgpu.ktt")
    tgpu_loaded = true
} catch (e) {
    tgpu_loaded = false
}

if tgpu_loaded {
    Test.assert(Modules.vendor.tgpu.INVALID_HANDLE, 4294967295)
    Test.assert(Modules.vendor.tgpu.instanceCreate != undefined, true)
}

let glfw_loaded = false
try {
    KetteTools.evalFile("kette/vendor/glfw.ktt")
    glfw_loaded = true
} catch (e) {
    glfw_loaded = false
}

if glfw_loaded {
    Test.assert(Modules.vendor.glfw.Window.dispose != undefined, true)
    Test.assert(Modules.vendor.glfw.Key.ESCAPE, 256)
    Test.assert(Modules.vendor.glfw.ClientApi.NONE, 1)
    Test.assert(Modules.vendor.glfw.raw.default_window_hints != undefined, true)
    Test.assert(Modules.vendor.glfw.raw.lib != null, true)
}

// Disposable resources are disposed by `with`, including on failure.
let disposed = 0
let resource = {
    disposable*: Disposable
    dispose: {
        disposed = disposed + 1
    }
}
let result = with(resource, |item| {
    Test.assert(item, resource)
    Test.assert(disposed, 0)
    7
})
Test.assert(result, 7)
Test.assert(disposed, 1)

let resource_error = null
try {
    with(resource, |item| {
        throw "boom"
    })
} catch (e) {
    resource_error = e
}
Test.assert(resource_error, "boom")
Test.assert(disposed, 2)

let raylib_loaded = false
try {
    KetteTools.evalFile("kette/vendor/raylib.ktt")
    raylib_loaded = true
} catch (e) {
    raylib_loaded = false
}

if raylib_loaded {
    Test.assert(Modules.vendor.raylib.InitWindow != undefined, true)
    Test.assert(Modules.vendor.raylib.BeginDrawing != undefined, true)
    Test.assert(Modules.vendor.raylib.Vector3.new != undefined, true)
    Test.assert(Modules.vendor.raylib.CAMERA_PERSPECTIVE, 0)
    Test.assert(Modules.vendor.raylib.RL_QUADS, 7)
}
