// Run:  cargo run -q -p vm -- kette/std/startup.ktt kette/kette_tests/test_runner.ktt kette/kette_tests/vendor.ktt
// Check: kette/kette_tests/check.py

// sys is a std module loaded by startup.
use sys { raw }

Test.assert(Modules.sys.raw, raw)
Test.assert(raw.lib != null, true)

raw.srand(1)
Test.assert(raw.rand() >= 0, true)

// Vendor modules are not loaded by startup.
Test.assert(Modules.vendor, undefined)

// Graphics vendor modules are optional: load them when their native
// libraries are available, but don't make the suite depend on them.
let tgpu_loaded = false
try {
    KetteTools.evalFile("kette/vendor/tgpu.ktt")
    tgpu_loaded = true
} catch (e) {
    tgpu_loaded = false
}

if tgpu_loaded {
    let tgpu = Modules.vendor.tgpu
    Test.assert(tgpu.INVALID_HANDLE, 4294967295)
    Test.assert(tgpu.instanceCreate != undefined, true)
    Test.assert(tgpu.PresentMode.fifo, :fifo)
    Test.assert(tgpu.MemoryPreset[:dynamic], 3)
    let buffer_desc = tgpu.BufferDesc.new()
    buffer_desc.memory = tgpu.MemoryPreset.dynamic
    buffer_desc.host_access = tgpu.HostAccess.readWriteRandom
    Test.assert(buffer_desc.memory, :dynamic)
    Test.assert(buffer_desc.host_access, :readWriteRandom)
    buffer_desc.free()
    let failed = false
    try {
        tgpu.bufferCreate(null, null, null, 0)
    } catch (e) {
        failed = true
    }
    Test.assert(failed, true)
}

let glfw_loaded = false
try {
    KetteTools.evalFile("kette/vendor/glfw.ktt")
    glfw_loaded = true
} catch (e) {
    glfw_loaded = false
}

if glfw_loaded {
    Test.assert(Modules.vendor.glfw.Window.dispose != undefined, true)
    Test.assert(Modules.vendor.glfw.Key.escape, :escape)
    Test.assert(Modules.vendor.glfw.Key[:escape], 256)
    Test.assert(Modules.vendor.glfw.ClientApi.none, :none)
    Test.assert(Modules.vendor.glfw.ClientApi[:none], 1)
    Test.assert(Modules.vendor.glfw.Key.fromValue(256), :escape)
    Test.assert(Modules.vendor.glfw.Action.fromValue(1), :press)
    Test.assert(Modules.vendor.glfw.raw.default_window_hints != undefined, true)
    Test.assert(Modules.vendor.glfw.raw.lib != null, true)
}

// Disposable resources are disposed by `with`, including on failure.
let disposed = 0
let resource = {
    disposable*: Disposable
    dispose: {
        disposed = disposed + 1
    }
}
let result = with(resource, |item| {
    Test.assert(item, resource)
    Test.assert(disposed, 0)
    7
})
Test.assert(result, 7)
Test.assert(disposed, 1)

let resource_error = null
try {
    with(resource, |item| {
        throw "boom"
    })
} catch (e) {
    resource_error = e
}
Test.assert(resource_error, "boom")
Test.assert(disposed, 2)

let raylib_loaded = false
try {
    KetteTools.evalFile("kette/vendor/raylib.ktt")
    raylib_loaded = true
} catch (e) {
    raylib_loaded = false
}

if raylib_loaded {
    let raylib = Modules.vendor.raylib
    Test.assert(raylib.InitWindow != undefined, true)
    Test.assert(raylib.BeginDrawing != undefined, true)
    Test.assert(raylib.Vector3.new != undefined, true)
    Test.assert(raylib.CameraProjection.perspective, :perspective)
    Test.assert(raylib.CameraProjection[:perspective], 0)
    Test.assert(raylib.PrimitiveType.quads, :quads)
    Test.assert(raylib.PrimitiveType[:quads], 7)
    let camera = raylib.Camera3D.new()
    camera.projection = raylib.CameraProjection.orthographic
    Test.assert(camera.projection, :orthographic)
    camera.free()
}
