// Run:  cargo run -q -p vm -- kette/std/startup.ktt kette/kette_tests/test_runner.ktt kette/kette_tests/sys.ktt
// Check: kette/kette_tests/check.py

use ffi
use random
use sys
use sys.file { File, Seek }

let file = File.temp()
Test.assert(file.disposed, false)
Test.assert(File.dispose != undefined, true)

file.writeText("hello")
file.flush()
Test.assert(file.tell(), 5)
Test.assert(file.size(), 5)
Test.assert(file.readText(), "hello")

file.seek(0, Seek.SET)
let chunk = file.read(3)
Test.assert(chunk.size, 3)
Test.assert(chunk.data.get(0), 104)
Test.assert(chunk.data.get(1), 101)
Test.assert(chunk.data.get(2), 108)
chunk.data.free()

file.dispose()
Test.assert(file.disposed, true)
file.dispose()
Test.assert(file.disposed, true)

let bytes = ffi.array(ffi.u8, 3).new()
bytes.set(0, 0)
bytes.set(1, 127)
bytes.set(2, 255)
let binary = File.temp()
binary.write(bytes, 3)
binary.seek(0, Seek.SET)
let all = binary.readAll()
Test.assert(all.size, 3)
Test.assert(all.data.get(0), 0)
Test.assert(all.data.get(1), 127)
Test.assert(all.data.get(2), 255)
all.data.free()
bytes.free()
binary.dispose()

let scoped = File.temp()
let returned = with(scoped, |handle| {
    handle.writeText("scoped")
    9
})
Test.assert(returned, 9)
Test.assert(scoped.disposed, true)

let opened = File.open("kette/std/sys/sys.ktt", "rb")
Test.assert(opened.readText().length > 0, true)
opened.dispose()

Test.assert(sys.getcwd(), sys.cwd)
Test.assert(sys.getenv("PATH"), sys.env.PATH)
Test.assert(sys.getenv("KETTE_NOT_SET"), null)

Test.assert(sys.env.arguments.length, 0)
Test.assert(sys.env.script != null, true)
Test.assert(sys.env.executable != null, true)
Test.assert(sys.env != null, true)
Test.assert(sys.env.KETTE_NOT_SET, undefined)

let before = sys.cwd
let moved = sys.setCwd(before)
Test.assert(moved, before)
Test.assert(sys.cwd, before)
Test.assert(sys.getcwd(), before)

// random is a thin std wrapper around sys.rand/srand.
random.seed(1)
let value = random.unit()
Test.assert(value >= 0.0 and value <= 1.0, true)
Test.assert(random.int(3, 5) >= 3, true)
