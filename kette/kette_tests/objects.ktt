// Run:  cargo run -q -p vm -- kette/kette_tests/objects.ktt
// Check: kette/kette_tests/check.py

let rgb = {
    label: "red"
    [0]: 255
    [1]: 0
    [2]: 0
}

rgb.label = "crimson"
rgb[1] = 32

Test.assert(rgb.label, "crimson")
Test.assert(rgb[1], 32)
Test.assert(rgb[0] + rgb[1], 287)

// host info: `os.name` is the OS string used to pick library paths
Test.assert(os.name.length > 0, true)

// accessor slots: `name>>` installs a getter, `name<<` a setter
let accessor = {
    _value: 1
    value>> { self._value }
    value<< { |v| self._value = v }
}
Test.assert(accessor.value, 1)
accessor.value = 7
Test.assert(accessor.value, 7)
Test.assert(accessor._value, 7)

let getter_only = {
    answer>> { 42 }
}
Test.assert(getter_only.answer, 42)

let setter_only = {
    _stored: 0
    stored<< { |v| self._stored = v }
}
setter_only.stored = 9
Test.assert(setter_only._stored, 9)

// accessor halves merge regardless of source order
let reverse = {
    _value: 0
    value<< { |v| self._value = v }
    value>> { self._value }
}
reverse.value = 3
Test.assert(reverse.value, 3)

let question = {
    present?: { true }
}
Test.assert(question.present?(), true)

let value? = |x| { x }
Test.assert(value?(7), 7)
