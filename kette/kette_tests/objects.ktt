// Run:  cargo run -q -p vm -- kette/std/startup.ktt kette/kette_tests/objects.ktt
// Check: kette/kette_tests/check.py

let OS = Modules.os

let rgb = {
    label: "red"
    0: 255
    1: 0
    2: 0
}

rgb.label = "crimson"
rgb[1] = 32

Test.assert(rgb.label, "crimson")
Test.assert(rgb[1], 32)
Test.assert(rgb[0] + rgb[1], 287)

// host info: `OS.name` is the OS string used to pick library paths
Test.assert(OS.name, KetteTools.primitives.os.name)
Test.assert(OS.name.length > 0, true)
Test.assert(globalThis.os, undefined)

// accessor slots: `name>>:` installs a getter, `name<<:` a setter
let accessor = {
    _value: 1
    value>>: { self._value }
    value<<: { |v| self._value = v }
}
Test.assert(accessor.value, 1)
accessor.value = 7
Test.assert(accessor.value, 7)
Test.assert(accessor._value, 7)

let getter_only = {
    answer>>: { 42 }
}
Test.assert(getter_only.answer, 42)

let setter_only = {
    _stored: 0
    stored<<: { |v| self._stored = v }
}
setter_only.stored = 9
Test.assert(setter_only._stored, 9)

// accessor halves merge regardless of source order
let reverse = {
    _value: 0
    value<<: { |v| self._value = v }
    value>>: { self._value }
}
reverse.value = 3
Test.assert(reverse.value, 3)

let question = {
    present?: { true }
}
Test.assert(question.present?(), true)

let value? = |x| { x }
Test.assert(value?(7), 7)

let multi = {
    a, b, c: undefined
    d, e: 5
}
Test.assert(multi.a == undefined, true)
Test.assert(multi.b == undefined, true)
Test.assert(multi.c == undefined, true)
Test.assert(multi.d, 5)
Test.assert(multi.e, 5)

let calls = 0
let make = { calls = calls + 1; 7 }
let shared = { a, b: make() }
Test.assert(shared.a, 7)
Test.assert(shared.b, 7)
Test.assert(calls, 1)

let semicolons = { a: 1; b: 2 }
Test.assert(semicolons.a + semicolons.b, 3)
