// A userspace scheduler on a platform thread, sharing data with main.
// Run:  cargo run -q -p vm -- kette/std/startup.ktt kette/kette_tests/test_runner.ktt kette/kette_tests/user_scheduler.ktt
// Check: kette/kette_tests/check.py

use threads { Thread }

let Mutex = Modules.sync.Mutex

let guard = Mutex.new()

let text = ""
let append = { |part|
    guard.lock()
    text = text + part
    guard.unlock()
}

let queue = {}
let head = 0
let tail = 0
let enqueue = { |thread|
    queue[tail] = thread
    tail = tail + 1
}
let run_scheduler = {
    while head < tail {
        let thread = queue[head]
        head = head + 1
        if thread.isReady() and thread.mount() {
            enqueue(thread)
        }
    }
    append("S")
}

let va = Thread.newVirtual("va", {
    append("a1")
    Thread.yield()
    append("a2")
})
let vb = Thread.newVirtual("vb", {
    append("b1")
    Thread.yield()
    append("b2")
})
enqueue(va)
enqueue(vb)

let scheduler_thread = Thread.newPlatform("scheduler", run_scheduler)
scheduler_thread.start()

append("m1")
Thread.sleep(1)
append("m2")

scheduler_thread.join()
Test.assert(text.length, 13)
