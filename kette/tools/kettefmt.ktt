// kettefmt: format Kette sources in place. Run it from the repo root; the
// std and syntax modules are loaded through the relative paths below.
//
// usage: kettefmt [--check] [--stdout] [--threads N] <path>...
//
// --check       report files that need formatting, do not write
// --stdout      write formatted output to stdout instead of files
// --threads N   worker count (default: available processors)
// <path>...     files or directories; directories are walked recursively
//
// examples:
//   kettefmt kette/std
//   kettefmt --check kette
//   kettefmt --stdout kette/tools/kettefmt.ktt
//   kettefmt --threads 8 kette
//
// Formatting is layout-preserving: indentation, spacing, comments, and blank
// lines are normalized; lines are never joined or reflowed.

if globalThis.Modules == undefined {
    KetteTools.evalFile("kette/std/startup.ktt")
}
if !Modules.kette {
    KetteTools.evalFile("kette/vendor/kette/kette.ktt")
}
if !Modules.kette.syntax {
    KetteTools.evalFile("kette/vendor/kette/syntax.ktt")
}

use kette.syntax
use sys
use sys.file { File }

let INDENT = "    "

let indent = |depth| {
    Array(depth).fill(INDENT).join("")
}

let newlineCount = |text| {
    let count = 0
    let* visit = |i| {
        if i < text.length {
            if text[i] == "\n" {
                count = count + 1
            }
            visit(i + 1)
        } else if count == 0 and text.length > 0 {
            1
        } else {
            count
        }
    }
    visit(0)
}

let opens = match |kind| {
    :LBrace | :LBracket | :LParen => true
    _ => false
}

let closes = match |kind| {
    :RBrace | :RBracket | :RParen => true
    _ => false
}

let tightBefore = match |kind| {
    :Period | :DotDot | :DotDotEq | :RParen | :RBracket | :Comma | :Semicolon => true
    _ => false
}

let tightAfter = match |kind| {
    :Period | :DotDot | :DotDotEq | :LParen | :LBracket => true
    _ => false
}

let isSlotParent = match |kind| {
    :Slot | :SlotMulti | :PatternField => true
    _ => false
}

let isSlotMarker = match |kind| {
    :Star | :GtGt | :LtLt => true
    _ => false
}

let isUnaryPrefix = match |kind| {
    :Minus | :Bang | :TildeTildeTilde => true
    _ => false
}

let isUnaryParent = match |kind| {
    :Unary | :PatternLiteral => true
    _ => false
}

let isBitParent = match |kind| {
    :BitString | :PatternBitString => true
    _ => false
}

let isBitSegment = match |kind| {
    :BitStringSegment | :PatternBitStringSegment => true
    _ => false
}

let startsNewLine = |tree, index| {
    let token = tree.tokensFrom(index + 1).firstWhere(|token| {
        token.kind == :Newline or !token.isTrivia
    })
    token != null and token.kind == :Newline
}

let isOperatorKind = match |kind| {
    :And | :Or | :EqEq | :NotEq
    | :Lt | :Gt | :LtEq | :GtEq
    | :LtLtLt | :GtGtGt | :AmpAmpAmp | :PipePipePipe | :CaretCaretCaret
    | :LtGt | :PipeGt | :FatArrow
    | :Plus | :Minus | :Star | :Slash | :Percent => true
    _ => false
}

let isOperator = |kind, parent| {
    parent != :Slot and isOperatorKind(kind)
}

let isAssignment = match |kind| {
    :Assign | :PlusEq | :MinusEq | :StarEq | :SlashEq | :PercentEq
    | :AndEq | :OrEq | :LtLtLtEq | :GtGtGtEq
    | :AmpAmpAmpEq | :PipePipePipeEq | :CaretCaretCaretEq => true
    _ => false
}

let isWord = match |kind| {
    :Ident | :Number | :String | :QuotedName
    | :True | :False | :Null | :SelfKw
    | :Let | :LetStar | :Mod | :If | :Else | :While | :For | :In
    | :Return | :Break | :Continue | :As | :Try | :Catch | :Throw | :Match
    | :SelfContext => true
    _ => false
}

let spaceBetween = |prev, cur, prevParent, curParent, prevPipeOpening, curPipeOpening| {
    if cur == :RBrace {
        return prev != :LBrace
    }
    if tightBefore(cur) or tightAfter(prev) {
        return false
    }
    if prev == :Comma or prev == :Semicolon {
        return true
    }
    if prev == :Colon and (prevParent == :AtomLiteral or prevParent == :PatternAtom) {
        return false
    }
    if cur == :Colon and isSlotParent(curParent) {
        return false
    }
    if prev == :Colon and isSlotParent(prevParent) {
        return true
    }
    if isSlotMarker(cur) and curParent == :Slot {
        return false
    }
    if isSlotMarker(prev) and prevParent == :Slot {
        return false
    }
    if cur == :Pipe and curParent == :ParamList {
        return curPipeOpening
    }
    if prev == :Pipe and prevParent == :ParamList and prevPipeOpening {
        return false
    }
    if cur == :Pipe and curParent == :PatternOr {
        return true
    }
    if prev == :Pipe and prevParent == :PatternOr {
        return true
    }
    if prev == :LtLt and isBitParent(prevParent) {
        return false
    }
    if cur == :GtGt and isBitParent(curParent) {
        return false
    }
    if isBitSegment(curParent) and (cur == :Colon or cur == :Slash or cur == :Minus) {
        return false
    }
    if isBitSegment(prevParent) and (prev == :Colon or prev == :Slash or prev == :Minus) {
        return false
    }
    if cur == :LParen and curParent == :ArgList {
        return false
    }
    if cur == :LBracket and curParent == :Index {
        return false
    }
    if prev == :Ellipsis {
        return false
    }
    if isUnaryPrefix(prev) and isUnaryParent(prevParent) {
        return false
    }
    if isOperator(prev, prevParent) or isOperator(cur, curParent) {
        return true
    }
    if isAssignment(prev) or isAssignment(cur) {
        return true
    }
    if prev == :LBrace or cur == :LBrace {
        return true
    }
    if isWord(prev) or isWord(cur) {
        return true
    }
    false
}

let format = |tree| {
    let pieces = []
    let depth = 0
    let stack = []
    let pending = 0
    let prev = null
    let prevPipeOpening = false

    tree.tokens.forEach(|token| {
        let kind = token.kind

        match kind {
            :Whitespace => {}
            :Newline => {
                pending = pending + newlineCount(token.text)
                if pending > 2 {
                    pending = 2
                }
            }
            _ if syntax.isTrivia(kind) => {
                if pending > 0 {
                    if pieces.length > 0 {
                        pieces.push("\n")
                        if pending > 1 {
                            pieces.push("\n")
                        }
                        pieces.push(indent(depth))
                    }
                } else if pieces.length > 0 {
                    pieces.push(" ")
                }
                pieces.push(token.text)
                pending = 0
            }
            _ => {
                let parent = token.parent
                let curPipeOpening = false
                if kind == :Pipe and parent == :ParamList {
                    curPipeOpening = token.start == tree.nodeStart(token.parentId)
                }

                if pieces.length > 0 {
                    if pending > 0 {
                        pieces.push("\n")
                        if pending > 1 {
                            pieces.push("\n")
                        }
                        let lineDepth = depth
                        if closes(kind) and stack.length > 0 and stack[stack.length - 1] {
                            lineDepth = lineDepth - 1
                        }
                        if prev != null and (isOperator(prev.kind, prev.parent) or isAssignment(prev.kind)) {
                            lineDepth = lineDepth + 1
                        }
                        pieces.push(indent(lineDepth))
                    } else if prev != null {
                        if spaceBetween(prev.kind, kind, prev.parent, parent, prevPipeOpening, curPipeOpening) {
                            pieces.push(" ")
                        }
                    }
                }

                pieces.push(token.text)
                pending = 0

                if opens(kind) {
                    let indenting = true
                    if kind == :LParen {
                        indenting = startsNewLine(tree, token.index)
                    }
                    stack.push(indenting)
                    if indenting {
                        depth = depth + 1
                    }
                }
                if closes(kind) and stack.length > 0 {
                    let indenting = stack.pop()
                    if indenting and depth > 0 {
                        depth = depth - 1
                    }
                }

                prev = token
                prevPipeOpening = curPipeOpening
            }
        }
    })

    if pieces.length == 0 {
        return ""
    }
    pieces.push("\n")
    pieces.join("")
}

let formatSource = |source| {
    with(syntax.parse(source), |tree| {
        if tree.errorCount > 0 {
            throw "parse error: " + tree.errorMessage(0)
        }
        format(tree)
    })
}

mod kettefmt {
    export format = format
    export formatSource = formatSource
}

if globalThis.KETTEFMT_LIBRARY == true {
    return
}

let usage = {
    print("usage: kettefmt [--check] [--stdout] [--threads N] <path>...")
}

let isKtt = |name| {
    let n = name.length
    n > 4 and name[n - 4] == "." and name[n - 3] == "k" and name[n - 2] == "t" and name[n - 1] == "t"
}

let skip = match |name| {
    ".git" | "target" | "target-become" | "node_modules" => true
    _ => false
}

let range = |from, to| {
    {
        iterator: {
            let value = from
            {
                hasNext: { value < to }
                next: {
                    let current = value
                    value = value + 1
                    current
                }
            }
        }
    }
}

let readSource = |path| {
    with(File.open(path, "rb"), |file| {
        file.readText()
    })
}

let writeSource = |path, text| {
    with(File.open(path, "wb"), |file| {
        file.writeText(text)
    })
}

let check = false
let stdout = false
let threads = Thread.availableProcessors()
let pending = []

let arguments = sys.env.arguments
let at = 0
while at < arguments.length {
    let arg = arguments[at]
    at = at + 1
    match arg {
        "--check" => {
            check = true
        }
        "--stdout" => {
            stdout = true
        }
        "--threads" => {
            if at >= arguments.length {
                usage()
                sys.exit(2)
            }
            threads = arguments[at] * 1
            at = at + 1
        }
        "--help" => {
            usage()
            sys.exit(0)
        }
        _ => {
            pending.push(arg)
        }
    }
}

if pending.length == 0 {
    usage()
    sys.exit(1)
}

threads = Math.floor(threads)
if !(threads >= 1) {
    threads = 1
}

let files = []
let seen = Object.create(null)
let scan = 0
while scan < pending.length {
    let path = pending[scan]
    scan = scan + 1

    let entries = null
    try {
        entries = sys.file.readDir(path)
    } catch (e) {
        entries = null
    }

    if entries == null {
        if isKtt(path) and seen[path] != true {
            seen[path] = true
            files.push(path)
        }
    } else {
        entries.forEach(|name| {
            if !skip(name) {
                pending.push(path + "/" + name)
            }
        })
    }
}

let count = files.length
let results = files.map(|path| {
    {
        path: path,
        message: null,
        changed: false,
        output: null,
        done: false,
    }
})

let formatFile = |result| {
    let path = result.path
    let source = null
    try {
        source = readSource(path)
    } catch (e) {
        result.message = [path + ": " + e]
    }

    if source != null {
        try {
            with(syntax.parse(source), |tree| {
                if tree.errorCount > 0 {
                    let lines = []
                    for error in range(0, tree.errorCount) {
                        lines.push(path + ": " + tree.errorMessage(error))
                    }
                    result.message = lines
                } else {
                    let output = format(tree)
                    result.changed = output != source
                    if result.changed and !stdout and !check {
                        try {
                            writeSource(path, output)
                        } catch (e) {
                            result.message = [path + ": " + e]
                        }
                    }
                    if stdout {
                        result.output = output
                    }
                }
            })
        } catch (e) {
            result.message = [path + ": " + e]
        }
    }
    result.done = true
}

let next = atomic.AtomicI64.new(0)
let process = {
    while true {
        let index = next.add(1) - 1
        if index >= count {
            break
        }
        formatFile(results[index])
    }
}

let workers = if count == 0 {
    0
} else {
    Math.min(threads, count)
}

let started = []
for worker in range(0, workers) {
    started.push(Thread.newPlatform("fmt-" + worker, process))
}
started.forEach(|thread| {
    thread.start()
})
started.forEach(|thread| {
    thread.join()
})

let failed = false
let changed = 0
results.forEach(|result| {
    if result.message != null {
        result.message.forEach(print)
        failed = true
    }
    if !result.done {
        print(result.path + ": formatting did not complete")
        failed = true
    }
    if result.changed {
        changed = changed + 1
        if stdout {
            Console.write(result.output)
        } else if check {
            print(result.path)
        }
    } else if stdout and result.output != null {
        Console.write(result.output)
    }
})

if failed or (check and changed > 0) {
    sys.exit(1)
}
